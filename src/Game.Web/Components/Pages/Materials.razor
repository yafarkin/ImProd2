@page "/materials"
@attribute [Authorize]
@rendermode InteractiveServer
@inject GameSessionHost Host
@using Game.Config.Loading
@using static Game.Web.SvgMarkup

<PageTitle>Материалы</PageTitle>

<h1>Цепочка материалов</h1>
<p class="text-muted">
    Вся цепочка производства — от сырья до готовой продукции. Цвет узла — сектор, подпись на стрелке
    — сколько материала предыдущего уровня нужно на 1 единицу следующего. Бледные пунктирные линии —
    сквозные связи через несколько уровней (например, крепёж в сборке через много переделов), без
    подписи, чтобы не забивать общий вид. Кликните по материалу, чтобы увидеть расчёт с самого начала
    и оставить на диаграмме только его связи, включая сквозные, в полную силу — на глубоких цепочках
    рёбер слишком много, чтобы читать их все разом. Клик по тому же материалу снова показывает полный
    граф.
</p>

<svg width="@N(_layout.Width)" height="@N(_layout.Height)" viewBox="@($"0 0 {N(_layout.Width)} {N(_layout.Height)}")" style="max-width: 100%; height: auto; border: 1px solid #e1e0d9;">
    <defs>
        <marker id="chain-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="#898781" />
        </marker>
    </defs>

    @foreach (var edge in _layout.Edges.Where(IsEdgeVisible))
    {
        var isDimmedSkip = edge.LevelSpan > DirectLevelSpan && _selectedMaterial is null;
        <path d="@CurvePath(edge.X1, edge.Y1, edge.X2, edge.Y2)" fill="none" stroke="#898781"
              stroke-width="@(isDimmedSkip ? "1" : "1.5")" stroke-opacity="@(isDimmedSkip ? "0.35" : "1")"
              stroke-dasharray="@(isDimmedSkip ? "4 3" : null)" marker-end="url(#chain-arrow)" />
        @if (!isDimmedSkip)
        {
            @Text((edge.X1 + edge.X2) / 2, (edge.Y1 + edge.Y2) / 2 - 4, "text-anchor:middle;font-size:11px;fill:#52514e", edge.Label)
        }
    }

    @foreach (var node in _layout.Nodes)
    {
        <g style="cursor:pointer" @onclick="() => SelectMaterial(node.Material)">
            <rect x="@N(node.X)" y="@N(node.Y)" width="@N(node.Width)" height="@N(node.Height)" rx="6"
                  fill="@node.Color" fill-opacity="0.15"
                  stroke="@node.Color" stroke-width="@(node.Material.Id == _selectedMaterial?.Id ? "3" : "1.5")" />
            @Text(node.X + node.Width / 2, node.Y + node.Height / 2 - 4, "text-anchor:middle;font-size:13px;font-weight:600;fill:#0b0b0b", node.Material.Name)
            @Text(node.X + node.Width / 2, node.Y + node.Height / 2 + 13, "text-anchor:middle;font-size:11px;fill:#52514e", node.Material.Sector.Name)
        </g>
    }
</svg>

@if (_selectedMaterial is not null)
{
    <h2 class="mt-4">Расчёт для «@_selectedMaterial.Name» (на 1 единицу)</h2>

    <details open class="mb-2">
        <summary>Пирамида входов</summary>
        <ul>
            @foreach (var row in _breakdown)
            {
                <li style="margin-left:@(row.Depth * 1.5)em">@row.Material.Name: @row.Quantity.ToString("0.##")</li>
            }
        </ul>
    </details>

    <h3 class="mt-3">Итого сырья на 1 единицу «@_selectedMaterial.Name»</h3>
    <ul>
        @foreach (var (material, quantity) in _rawTotals)
        {
            <li>@material.Name: @quantity.ToString("0.##")</li>
        }
    </ul>
}

@code {
    /// <summary>
    /// Разница уровней входа и выхода ребра, при которой оно ещё считается «соседним» (обычный шаг
    /// цепочки) и рисуется в полную силу без фильтра. Больше — «сквозное» ребро, приглушается, пока
    /// его материал не выбран явно (см. <see cref="IsEdgeVisible"/> и разметку выше).
    /// </summary>
    private const int DirectLevelSpan = 1;

    private ResolvedGameConfig _config = null!;
    private MaterialChainDiagram.Layout _layout = null!;
    private Material? _selectedMaterial;
    private IReadOnlyList<DashboardDisplay.PyramidRow> _breakdown = Array.Empty<DashboardDisplay.PyramidRow>();
    private IReadOnlyList<(Material Material, decimal Quantity)> _rawTotals = Array.Empty<(Material, decimal)>();

    protected override void OnInitialized()
    {
        lock (Host.SyncRoot)
        {
            _config = Host.Session?.State.Config ?? Host.DraftConfig;
        }

        _layout = MaterialChainDiagram.Build(_config);
    }

    private void SelectMaterial(Material material)
    {
        if (_selectedMaterial?.Id == material.Id)
        {
            // Повторный клик по уже выбранному материалу — снять фильтр и вернуть полный граф.
            _selectedMaterial = null;
            _breakdown = Array.Empty<DashboardDisplay.PyramidRow>();
            _rawTotals = Array.Empty<(Material, decimal)>();
            return;
        }

        _selectedMaterial = material;
        var pyramid = CostCalculator.BuildInputPyramid(material, 1m, _config.RecipeBook);
        _breakdown = DashboardDisplay.FlattenPyramid(pyramid);
        _rawTotals = MaterialChainDiagram.AggregateRawMaterials(pyramid);
    }

    /// <summary>
    /// Без выбранного материала — весь граф как раньше. С выбранным — только рёбра, где он источник
    /// или цель (запрос пользователя: скрыть остальные линии, чтобы не было «паутины» на глубоких
    /// цепочках).
    /// </summary>
    private bool IsEdgeVisible(MaterialChainDiagram.Edge edge) =>
        _selectedMaterial is null || edge.SourceMaterialId == _selectedMaterial.Id || edge.TargetMaterialId == _selectedMaterial.Id;
}
