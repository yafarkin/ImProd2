@page "/operator"
@attribute [Authorize(Roles = "Operator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host

<PageTitle>Оператор</PageTitle>

<h1>Вы вошли как @DisplayName (@RoleDisplay.Name(ParticipantRole.Operator))</h1>

@if (_showWelcome)
{
    <div class="alert alert-info">
        <p>@RoleDisplay.Description(ParticipantRole.Operator)</p>
        <p>Что можно делать:</p>
        <ul>
            @foreach (var tip in RoleDisplay.Tips(ParticipantRole.Operator))
            {
                <li>@tip</li>
            }
        </ul>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showWelcome = false">Понятно, дальше</button>
    </div>
}

<p>
    Ход <strong>@_currentTurn</strong>, фаза <strong>@_phaseLabel</strong>. До конца фазы: <strong>@_countdown</strong>.
</p>
@if (_lastNewsHeadline is not null)
{
    <p><em>Последняя новость: @_lastNewsHeadline</em></p>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<h2>Очередь сделок</h2>
<input type="text" placeholder="Код подтверждения" class="form-control d-inline-block mb-3" style="width:10em" @bind="_codeFilter" @bind:event="oninput" />

@if (VisibleQueue().Count == 0)
{
    <p><em>Очередь пуста.</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Покупатель</th>
                    <th>Продавец</th>
                    <th>Материал</th>
                    <th>Тип</th>
                    <th>Объём</th>
                    <th>Цена</th>
                    <th>Срок</th>
                    <th>Код</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in VisibleQueue())
                {
                    <tr>
                        <td>@row.BuyerName</td>
                        <td>@row.SellerName</td>
                        <td>@row.MaterialName</td>
                        <td>@row.TypeLabel</td>
                        <td>@row.Volume.ToString("0.##")</td>
                        <td>@DashboardDisplay.FormatMoney(row.UnitPrice)</td>
                        <td>@row.TurnRange</td>
                        <td>@row.ConfirmationCode</td>
                        <td>
                            @if (_isDecisionPhase)
                            {
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Confirm(row.ContractId)">Подтвердить</button>
                                    <input type="text" placeholder="Причина отклонения" class="form-control d-inline-block" style="width:10em" @bind="_rejectReasons[row.ContractId]" />
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Reject(row.ContractId)">Отклонить</button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "welcome")]
    public string? WelcomeParam { get; set; }

    private string? DisplayName;
    private bool _showWelcome;
    private int _currentTurn;
    private string _phaseLabel = string.Empty;
    private bool _isDecisionPhase;
    private string _countdown = string.Empty;
    private string? _lastNewsHeadline;
    private Timer? _tickTimer;
    private string? _errorMessage;
    private string _codeFilter = string.Empty;

    private sealed record QueueRow(
        Ulid ContractId, string BuyerName, string SellerName, string MaterialName, string TypeLabel,
        decimal Volume, decimal UnitPrice, string ConfirmationCode, string TurnRange);

    private IReadOnlyList<QueueRow> _queue = Array.Empty<QueueRow>();
    private readonly Dictionary<Ulid, string> _rejectReasons = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        DisplayName = authState.User.Identity?.Name;
        _showWelcome = WelcomeParam == "1";

        RefreshPhaseStatus();

        _tickTimer = new Timer(_ =>
        {
            RefreshPhaseStatus();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void RefreshPhaseStatus()
    {
        lock (Host.SyncRoot)
        {
            if (Host.Session is null)
            {
                return;
            }

            var state = Host.Session.State;

            _currentTurn = state.CurrentTurn;
            _phaseLabel = PhaseDisplay.PhaseLabel(state.CurrentPhase);
            _isDecisionPhase = state.CurrentPhase == TurnPhase.Decision;
            _countdown = PhaseDisplay.FormatCountdown(PhaseTimerCalculator.Remaining(Host.Session, DateTimeOffset.UtcNow));
            _lastNewsHeadline = PhaseDisplay.FindLastNewsHeadline(Host.Session);

            _queue = state.Contracts.Values
                .Where(c => c.Status == ContractStatus.PendingConfirmation)
                .Select(c =>
                {
                    _rejectReasons.TryAdd(c.Id, string.Empty);
                    return new QueueRow(
                        c.Id,
                        state.Teams.TryGetValue(c.BuyerTeamId, out var buyer) ? buyer.Name : "?",
                        state.Teams.TryGetValue(c.SellerTeamId, out var seller) ? seller.Name : "?",
                        c.Terms.Material.Name,
                        DashboardDisplay.ContractTypeLabel(c.Terms.Type),
                        c.Terms.Volume, c.Terms.UnitPrice, c.ConfirmationCode,
                        DashboardDisplay.FormatTurnRange(c.Terms.Type, c.Terms.EffectiveTurn, c.Terms.SpotDeliveryTurn, c.Terms.RecurringEndTurn));
                })
                .ToList();
        }
    }

    private IReadOnlyList<QueueRow> VisibleQueue() =>
        _queue.Where(r => string.IsNullOrWhiteSpace(_codeFilter) || r.ConfirmationCode.Contains(_codeFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private void Confirm(Ulid contractId)
    {
        _errorMessage = null;
        try
        {
            lock (Host.SyncRoot)
            {
                if (Host.Session is null)
                {
                    _errorMessage = "Сессия сейчас не активна.";
                    return;
                }

                Host.Session.ConfirmContractByOperator(contractId);
            }
            RefreshPhaseStatus();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }
    }

    private void Reject(Ulid contractId)
    {
        var reason = _rejectReasons.GetValueOrDefault(contractId, string.Empty);
        _errorMessage = null;
        try
        {
            lock (Host.SyncRoot)
            {
                if (Host.Session is null)
                {
                    _errorMessage = "Сессия сейчас не активна.";
                    return;
                }

                Host.Session.RejectContract(contractId, reason);
            }
            RefreshPhaseStatus();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }
    }

    public void Dispose() => _tickTimer?.Dispose();
}
