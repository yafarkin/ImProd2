@page "/admin"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host
@using Game.Config.Loading
@using Game.Config.Session

<PageTitle>Администратор</PageTitle>

<h1>Администратор</h1>

@if (_showWelcome)
{
    <div class="alert alert-info">
        <p>@RoleDisplay.Description(ParticipantRole.Administrator)</p>
        <p>Что можно делать:</p>
        <ul>
            @foreach (var tip in RoleDisplay.Tips(ParticipantRole.Administrator))
            {
                <li>@tip</li>
            }
        </ul>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showWelcome = false">Понятно, дальше</button>
    </div>
}

<p class="text-muted">Ваш код администратора: <code>@Host.AdminCode</code> — постоянный, не меняется до полного сброса.</p>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<details class="mb-4">
    <summary class="text-danger">Полный сброс в начальное состояние</summary>
    <p class="text-muted mt-2">
        <em>
            Стирает вообще всё: активную сессию (если есть) и черновики команд/участников — возврат
            к самому первому экрану настройки. Журнал архивируется на диске (не удаляется), но из
            интерфейса не читается — выгрузите историю заранее, если она нужна. Разлогинивает вас:
            следующий вход — по новому коду администратора из консоли сервера (старый после сброса
            перестаёт работать).
        </em>
    </p>
    <form method="post" action="/admin/hard-reset">
        <button type="submit" class="btn btn-danger">Сбросить всё в ноль</button>
    </form>
</details>

@if (!_sessionStarted)
{
    <h2>Подключение участников</h2>
    <p>
        Пока участники собираются в зале — можно вывести <a href="/join" target="_blank">страницу с QR-кодом</a>
        (на проектор или отдельный экран), чтобы открыть сайт на телефоне без ввода адреса вручную.
    </p>

    <h2 class="mt-4">Конфигурация</h2>
    <p>
        Загружен: @Host.DraftConfig.Raw.Sectors.Count секторов, @Host.DraftConfig.Raw.Materials.Count материалов
        (хеш @(Host.DraftConfig.ContentHash[..8])).
    </p>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <InputFile OnChange="OnConfigFileSelected" class="form-control d-inline-block w-auto" />
        <button type="button" class="btn btn-secondary" @onclick="UseTrainingConfig">Тренировочный конфиг (короткие ходы, ~8-10)</button>
    </div>

    <h2 class="mt-4">Пресет длительности</h2>
    <select class="form-select w-auto mb-3" @bind="_selectedPresetId">
        @foreach (var preset in Host.DraftConfig.Raw.SessionPresets)
        {
            <option value="@preset.Id">@preset.Name (@(preset.MinTurns)-@(preset.MaxTurns) ходов)</option>
        }
    </select>

    <h2 class="mt-4">Команды и участники</h2>
    <p>
        Команды и управляющие заводятся на странице <a href="/admin/teams">«Команды»</a> — сейчас в
        черновике: <strong>@Host.StagedTeams.Count</strong> команд(ы). Администраторы, операторы и
        ведущий заводятся на странице <a href="/admin/participants">«Участники»</a>.
    </p>

    <h2 class="mt-4">Чек-лист готовности</h2>
    <ul class="list-unstyled">
        <li>Конфиг загружен: ✓</li>
        <li>Пресет выбран: @(_selectedPresetId is not null ? "✓" : "✗")</li>
        <li>Команд в черновике: @Host.StagedTeams.Count</li>
        <li>Секторы охвачены: @(Host.StagedTeams.Count == 0 ? "—" : string.Join(", ", Host.StagedTeams.Select(t => SectorName(t.SectorId)).Distinct()))</li>
        <li>Команд без управляющего: @_teamsWithoutManagerCount</li>
        <li>Операторов в черновике: @_stagedOperatorCount</li>
        <li>Ведущих в черновике: @_stagedFacilitatorCount</li>
    </ul>

    <button type="button" class="btn btn-primary" @onclick="StartSession">Начать сессию</button>
}
else
{
    <p>
        Сессия запущена. Статус: <strong>@(_isPaused ? "пауза" : "идёт")</strong>
        <button type="button" class="btn btn-secondary btn-sm ms-2" @onclick="TogglePause">@(_isPaused ? "Возобновить" : "Пауза")</button>
    </p>

    <h2>Управление</h2>
    <p>
        <a href="/admin/teams" class="btn btn-secondary">Команды</a>
        <a href="/admin/participants" class="btn btn-secondary">Участники</a>
    </p>

    <h2 class="mt-4">Чек-лист готовности</h2>
    <ul class="list-unstyled">
        @foreach (var row in _teamChecklist)
        {
            <li>
                @row.Name — Управляющий: @(row.HasManager ? "✓" : "✗"), Переговорщик: @(row.HasNegotiator ? "✓" : "✗")
            </li>
        }
        <li>Оператор: @(_hasOperator ? "✓" : "✗")</li>
        <li>Ведущий: @(_hasFacilitator ? "✓" : "✗")</li>
    </ul>

    <h2 class="mt-4">Печатные материалы</h2>
    <p>
        <a href="/print/contract-form" target="_blank">Бланк сделки</a> ·
        <a href="/print/team-memo" target="_blank">Памятки команд</a>
    </p>

    <h2 class="mt-4">Сброс сессии</h2>
    <p class="text-muted">
        <em>
            Начинает новую сессию с тем же составом команд и теми же кодами входа — для перехода от
            тренировочной игры к основной (SPEC §10). Текущий журнал архивируется на диске, но
            обратно из интерфейса не читается — выгрузите историю (см. «Экспорт истории» на экране
            ведущего) заранее, если она нужна.
        </em>
    </p>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <select class="form-select w-auto" @bind="_resetPresetId">
            @foreach (var preset in Host.DefaultConfig.Raw.SessionPresets)
            {
                <option value="@preset.Id">@preset.Name (@(preset.MinTurns)-@(preset.MaxTurns) ходов)</option>
            }
        </select>
        <button type="button" class="btn btn-danger" @onclick="ResetSession">Сбросить и начать заново</button>
    </div>
}

@code {
    private sealed record TeamChecklistRow(string Name, bool HasManager, bool HasNegotiator);

    [SupplyParameterFromQuery(Name = "welcome")]
    public string? WelcomeParam { get; set; }

    private bool _showWelcome;

    private string? _selectedPresetId;
    private string? _errorMessage;

    private int _teamsWithoutManagerCount;
    private int _stagedOperatorCount;
    private int _stagedFacilitatorCount;

    private bool _sessionStarted;
    private bool _isPaused;
    private IReadOnlyList<Game.Domain.Team> _teams = Array.Empty<Game.Domain.Team>();
    private IReadOnlyList<ParticipantRegistration> _participants = Array.Empty<ParticipantRegistration>();
    private IReadOnlyList<TeamChecklistRow> _teamChecklist = Array.Empty<TeamChecklistRow>();
    private bool _hasOperator;
    private bool _hasFacilitator;

    private string? _resetPresetId;

    private Timer? _tickTimer;

    protected override void OnInitialized()
    {
        _showWelcome = WelcomeParam == "1";
        _selectedPresetId = Host.DraftConfig.Raw.SessionPresets.Count > 0 ? Host.DraftConfig.Raw.SessionPresets[0].Id : null;
        _resetPresetId = Host.DefaultConfig.Raw.SessionPresets.Count > 0 ? Host.DefaultConfig.Raw.SessionPresets[0].Id : null;

        Refresh();

        _tickTimer = new Timer(_ =>
        {
            Refresh();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void Refresh()
    {
        lock (Host.SyncRoot)
        {
            _sessionStarted = Host.Session is not null;
            if (!_sessionStarted)
            {
                var stagedParticipants = Host.StagedParticipants;
                var teamIdsWithManager = stagedParticipants
                    .Where(p => p.Role == ParticipantRole.Manager)
                    .Select(p => p.TeamId)
                    .ToHashSet();
                _teamsWithoutManagerCount = Host.StagedTeams.Count(t => !teamIdsWithManager.Contains(t.Id));
                _stagedOperatorCount = stagedParticipants.Count(p => p.Role == ParticipantRole.Operator);
                _stagedFacilitatorCount = stagedParticipants.Count(p => p.Role == ParticipantRole.Facilitator);
                return;
            }

            var state = Host.Session!.State;
            _isPaused = state.IsPaused;
            _teams = state.Teams.Values.OrderBy(t => t.Name, StringComparer.Ordinal).ToList();
            _participants = state.Participants.Values.ToList();

            _teamChecklist = _teams
                .Select(team => new TeamChecklistRow(
                    team.Name,
                    _participants.Any(p => p.Role == ParticipantRole.Manager && p.TeamId == team.Id),
                    _participants.Any(p => p.Role == ParticipantRole.Negotiator && p.TeamId == team.Id)))
                .ToList();
            _hasOperator = _participants.Any(p => p.Role == ParticipantRole.Operator);
            _hasFacilitator = _participants.Any(p => p.Role == ParticipantRole.Facilitator);
        }
    }

    private string SectorName(string sectorId) => Host.DraftConfig.Sectors.First(s => s.Id == sectorId).Name;

    private void UseTrainingConfig()
    {
        _errorMessage = null;
        Host.SetDraftConfig(Host.TrainingConfig);
        _selectedPresetId = Host.TrainingConfig.Raw.SessionPresets.Count > 0 ? Host.TrainingConfig.Raw.SessionPresets[0].Id : null;
    }

    private async Task OnConfigFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream());
            var json = await reader.ReadToEndAsync();
            var config = GameConfigLoader.Load(json);
            Host.SetDraftConfig(config);
            _selectedPresetId = config.Raw.SessionPresets.Count > 0 ? config.Raw.SessionPresets[0].Id : null;
        }
        catch (GameConfigValidationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void StartSession()
    {
        var preset = Host.DraftConfig.Raw.SessionPresets.FirstOrDefault(p => p.Id == _selectedPresetId);
        if (preset is null)
        {
            _errorMessage = "Выберите пресет длительности.";
            return;
        }

        RunAction(() => Host.StartSessionFromDraft(preset));
    }

    private void TogglePause() => RunAction(() =>
    {
        if (_isPaused)
        {
            Host.Session!.Resume();
        }
        else
        {
            Host.Session!.Pause();
        }
    });

    private void ResetSession()
    {
        var preset = Host.DefaultConfig.Raw.SessionPresets.FirstOrDefault(p => p.Id == _resetPresetId);
        if (preset is null)
        {
            _errorMessage = "Выберите пресет для новой сессии.";
            return;
        }

        RunAction(() => Host.ResetSession(preset));
    }

    private void RunAction(Action action)
    {
        _errorMessage = null;
        try
        {
            lock (Host.SyncRoot)
            {
                action();
            }
            Refresh();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }
    }

    public void Dispose() => _tickTimer?.Dispose();
}
