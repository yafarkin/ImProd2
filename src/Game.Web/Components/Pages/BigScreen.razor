@page "/screen"
@rendermode InteractiveServer
@implements IDisposable
@layout Game.Web.Components.Layout.NoNavLayout
@inject GameSessionHost Host

<PageTitle>Большой экран</PageTitle>

@if (_sessionNotStarted)
{
    <div class="text-center">
        <h1>Сессия скоро начнётся</h1>
        <JoinQrCodes SizePx="480" />
    </div>
}
else if (_isFinished)
{
    @* Экран итогов зала: партия кончилась, и большой экран обязан это объявить сам — нажать
       «обновить» на нём некому, а разбор начинается ровно в эту минуту (docs/TODO.md №10). Порядок
       здесь по полному счёту (ResultsDisplay), а не по балансу, как в рейтинге по ходу игры:
       скрывать больше нечего, и вложенные в фабрики деньги обязаны быть засчитаны. *@
    <h1>Партия завершена на ходу @_currentTurn</h1>

    <h2 class="mt-4">Итоговый счёт</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Команда</th>
                <th>Сектор</th>
                <th class="text-end">Счёт</th>
                <th class="text-end">Деньги</th>
                <th class="text-end">Склад</th>
                <th class="text-end">Фабрики</th>
                <th class="text-end">Репутация</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _results)
            {
                <tr>
                    <td>@row.Place</td>
                    <td>@row.Name</td>
                    <td>@row.SectorName</td>
                    <td class="text-end"><strong>@DashboardDisplay.FormatMoney(row.Score)</strong></td>
                    <td class="text-end">@DashboardDisplay.FormatMoney(row.Cash)</td>
                    <td class="text-end">@DashboardDisplay.FormatMoney(row.WarehouseValue)</td>
                    <td class="text-end">@DashboardDisplay.FormatMoney(row.FactoriesValue)</td>
                    <td class="text-end">@row.ReputationPercentage.ToString("F0")% (@row.ReputationSampleCount)</td>
                </tr>
            }
        </tbody>
    </table>
    <p>
        Счёт — ликвидационная стоимость команды: деньги на счету плюс склад по себестоимости плюс
        фабрики по остаточной стоимости.
    </p>

    <h2 class="mt-4">Счёт команд по ходам</h2>
    @ChartRenderer.Render(_scoreHistoryChart)
}
else
{
    <h1>
    Ход <strong>@_currentTurn</strong>, фаза <strong>@_phaseLabel</strong>. До конца фазы: <strong>@_countdown</strong>.
    @if (_isPaused)
    {
        <strong> (пауза)</strong>
    }
</h1>

<div class="ticker">
    @if (_recentNews.Count == 0)
    {
        <div class="ticker-static">Новостей пока не было.</div>
    }
    else
    {
        <div class="ticker-track">@string.Join(" • ", _recentNews)</div>
    }
</div>

@if (_showEconomyIndex && _economyIndex.HasData)
{
    <h2 class="mt-4">
        Индекс деловой активности:
        <span class="@_economyIndex.CssClass">@_economyIndex.ValueText @_economyIndex.Arrow</span>
        <small class="text-muted">— @_economyIndex.LevelText</small>
    </h2>
    @ChartRenderer.Render(_economyIndexChart)
}

<h2 class="mt-4">Рейтинг команд</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Команда</th>
            <th>Сектор</th>
            <th>Финансовый рейтинг</th>
            <th>Репутация</th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < _ranking.Count; i++)
        {
            var row = _ranking[i];
            <tr>
                <td>@(i + 1)</td>
                <td>@row.Name</td>
                <td>@row.SectorName</td>
                <td>@DashboardDisplay.FormatMoney(row.NetWorth)</td>
                <td>@row.ReputationPercentage.ToString("F0")% (@row.ReputationSampleCount)</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="mt-4">Баланс команд по ходам</h2>
@ChartRenderer.Render(_balanceHistoryChart)

<h2 class="mt-4">Доска потребностей</h2>
<p>
    Активных объявлений: <strong>@_needsSummary.ActiveCount</strong>
    @if (_needsSummary.MostSoughtMaterialNames.Count > 0)
    {
        <text> · чаще всего ищут: <strong>@string.Join(", ", _needsSummary.MostSoughtMaterialNames)</strong></text>
    }
    else
    {
        <text> · нет активных дефицитов</text>
    }
</p>
}

@code {
    private int _currentTurn;
    private string _phaseLabel = string.Empty;
    private bool _isPaused;
    private string _countdown = string.Empty;
    private IReadOnlyList<string> _recentNews = Array.Empty<string>();
    private IReadOnlyList<BigScreenDisplay.TeamRatingRow> _ranking = Array.Empty<BigScreenDisplay.TeamRatingRow>();
    private BigScreenDisplay.NeedsSummary _needsSummary = new(0, Array.Empty<string>());
    private LineChartDiagram.ChartLayout _balanceHistoryChart = new([], [], [], 900, 320);
    private IReadOnlyList<ResultsDisplay.ResultRow> _results = Array.Empty<ResultsDisplay.ResultRow>();
    private LineChartDiagram.ChartLayout _scoreHistoryChart = new([], [], [], 900, 320);
    private bool _isFinished;
    private int _balanceHistoryEntryCount = -1;
    private bool _showEconomyIndex;
    private EconomyIndexDisplay.IndexSummary _economyIndex = EconomyIndexDisplay.Describe([]);
    private LineChartDiagram.ChartLayout _economyIndexChart = new([], [], [], 900, 240);
    private bool _sessionNotStarted;
    private Timer? _tickTimer;

    protected override void OnInitialized()
    {
        Refresh();

        _tickTimer = new Timer(_ =>
        {
            Refresh();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void Refresh()
    {
        using (Host.EnterSyncRootTimed(nameof(BigScreen) + "." + nameof(Refresh)))
        {
            if (Host.Session is null)
            {
                _sessionNotStarted = true;
                return;
            }

            _sessionNotStarted = false;
            var state = Host.Session.State;

            _isFinished = state.IsFinished;
            _currentTurn = state.CurrentTurn;
            _phaseLabel = PhaseDisplay.PhaseLabel(state.CurrentPhase);
            _isPaused = state.IsPaused;
            _countdown = PhaseDisplay.FormatCountdown(PhaseTimerCalculator.Remaining(Host.Session, DateTimeOffset.UtcNow));
            _recentNews = PhaseDisplay.RecentNewsHeadlines(Host.Session, 5);
            _ranking = BigScreenDisplay.RankTeams(Host.Session);
            _results = ResultsDisplay.Rank(Host.Session);
            _needsSummary = BigScreenDisplay.SummarizeNeeds(state);

            // Полный реплей журнала на каждую команду — не бесплатная операция, а страница
            // обновляется раз в секунду; пересчитываем только когда в журнале появились новые записи
            // (тот же приём, что и кеш истории на /team, см. Team.razor.RefreshDashboard).
            var entryCount = Host.Session.Entries.Count;
            if (_balanceHistoryEntryCount != entryCount)
            {
                _balanceHistoryChart = BigScreenDisplay.BuildBalanceHistoryChart(Host.Session);
                _scoreHistoryChart = ResultsDisplay.BuildScoreHistoryChart(Host.Session);
                var indexHistory = EconomyIndexHistoryCalculator.Summarize(Host.Session.Entries, state.Config);
                _economyIndex = EconomyIndexDisplay.Describe(indexHistory);
                _economyIndexChart = EconomyIndexDisplay.BuildChart(indexHistory, 900, 240);
                _balanceHistoryEntryCount = entryCount;
            }
            _showEconomyIndex = EconomyIndexDisplay.IsVisible(state.Config.Raw.Economy);
        }
    }

    public void Dispose() => _tickTimer?.Dispose();
}
