@page "/"
@using System.Security.Claims

<PageTitle>Производственные цепочки</PageTitle>

<h1>Производственные цепочки</h1>

<AuthorizeView>
    <Authorized>
        <p>Вы вошли как @context.User.Identity!.Name.</p>
        <p>
            <a href="@RoleRouting.HomeRoute(MyRole(context.User))" class="btn btn-primary">Перейти в свой раздел</a>
            <a href="/screen" target="_blank" class="btn btn-secondary">Большой экран</a>
        </p>
    </Authorized>
    <NotAuthorized>
        <a href="/login" class="btn btn-primary">Войти по коду</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static ParticipantRole MyRole(ClaimsPrincipal user) =>
        Enum.Parse<ParticipantRole>(user.FindFirst(ClaimTypes.Role)!.Value);
}
