@page "/admin/price-ladder"
@* Ведущий — не только администратор: лестницу цен зовут с /session, а туда пускают обе роли
   (блок 11.10, docs/external-economy.md §9 — «экран лестницы цен у ведущего»). *@
@attribute [Authorize(Roles = "Administrator,Facilitator")]
@rendermode InteractiveServer
@inject GameSessionHost Host
@using Game.Config.Economy
@using Game.Config.Loading
@using Game.Engine

<PageTitle>Лестница цен продажи системе</PageTitle>

<p><a href="/session">← Назад к странице сессии</a></p>

<h1>Пересчёт лестницы цен продажи системе</h1>

@if (_sessionStarted)
{
    <div class="alert alert-info">Сессия уже начата — конфиг здесь больше не редактируется.</div>
}
else
{
    <p class="text-muted">
        <em>
            Цена сбыта каждого материала считается от его себестоимости:
            <code>цена = себестоимость × (1 + базовая наценка + надбавка за глубину × уровень)</code>.
            Результат замораживается в конфиг обычными числами — во время партии движок себестоимость
            для цены больше не спрашивает, поэтому команда, снизившая свои издержки через R&amp;D,
            забирает разницу себе, а не отдаёт её обратно в цену.
            <strong>Надбавка за глубину — единственная ручка «насколько сильнее вознаграждается
            переработка»:</strong> при нуле лестница в точности воспроизводит прежнее правило
            «себестоимость + фиксированная наценка», одинаковое для всех уровней.
        </em>
    </p>

    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <label for="baseMargin">Базовая наценка:</label>
            <input id="baseMargin" type="number" step="0.05" min="0" class="form-control d-inline-block" style="width:8em" @bind="_baseMargin" />
        </div>
        <div class="d-flex align-items-center gap-2">
            <label for="depthBonus">Надбавка за уровень:</label>
            <input id="depthBonus" type="number" step="0.01" min="0" class="form-control d-inline-block" style="width:8em" @bind="_depthBonusPerLevel" />
        </div>
        <button type="button" class="btn btn-secondary" @onclick="Recalculate">Пересчитать</button>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_preview is not null)
    {
        <h4 class="mt-4">Предпросмотр</h4>
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr>
                        <th>Сектор</th>
                        <th>Уровень</th>
                        <th>Материал</th>
                        <th class="text-end">Себестоимость</th>
                        <th class="text-end">Цена было</th>
                        <th class="text-end">Цена станет</th>
                        <th class="text-end">Маржа</th>
                        <th class="text-end">Прибыль/ед</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _preview)
                    {
                        <tr>
                            <td>@row.SectorId</td>
                            <td>@row.Level</td>
                            <td>@row.MaterialName</td>
                            <td class="text-end">@row.UnitCost.ToString("0.####")</td>
                            <td class="text-end text-muted">@row.OldPrice.ToString("0.####")</td>
                            <td class="text-end"><strong>@row.NewPrice.ToString("0.####")</strong></td>
                            <td class="text-end">@row.MarginRate.ToString("P0")</td>
                            <td class="text-end">@row.ProfitPerUnit.ToString("0.####")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small">
            Маржа растёт с уровнем по построению — сама по себе она ничего не доказывает. Ответ на
            вопрос «окупается ли глубина» даёт окупаемость по уровням (§1b диагностики) после
            применения лестницы, а не эта таблица.
        </p>

        <p class="text-muted small">
            <em>
                Применение обновит черновой конфиг сессии тем же способом, что и смена конфига на
                странице администратора, — состав команд в черновике сбрасывается (как при любой
                смене конфига); если он уже был набран, соберите его заново после применения.
            </em>
        </p>
        <button type="button" class="btn btn-primary" @onclick="Apply">Применить к черновому конфигу</button>
    }
}

@code {
    private bool _sessionStarted;

    /// <summary>
    /// Значения поставки (блок 11.8): именно с ними откалиброваны обе боевые цепочки. Форма по
    /// умолчанию обязана воспроизводить поставку, а не обнулять надбавку за глубину — иначе
    /// «пересчитать и применить» без правки полей тихо сплющило бы лестницу обратно в плоскую
    /// наценку, ту самую, которую снимала Фаза 11.
    /// </summary>
    private decimal _baseMargin = 0.30m;
    private decimal _depthBonusPerLevel = 0.05m;
    private string? _error;
    private IReadOnlyList<SystemSalePriceLadderCalculator.MaterialLadderRow>? _preview;

    protected override void OnInitialized()
    {
        lock (Host.SyncRoot)
        {
            _sessionStarted = Host.Session is not null;
        }
    }

    private void Recalculate()
    {
        _error = null;

        try
        {
            lock (Host.SyncRoot)
            {
                var unitCosts = MaterialCostCalculator.CalculateAll(Host.DraftConfig);
                _preview = SystemSalePriceLadderCalculator.Calculate(
                    Host.DraftConfig, unitCosts, _baseMargin, _depthBonusPerLevel);
            }
        }
        catch (Exception exception) when (exception is ArgumentOutOfRangeException or InvalidOperationException or NotSupportedException)
        {
            _preview = null;
            _error = exception.Message;
        }
    }

    private void Apply()
    {
        if (_preview is null)
        {
            return;
        }

        var updatedRaw = SystemSalePriceLadderCalculator.Apply(Host.DraftConfig.Raw, _preview);
        var updated = GameConfigLoader.Load(GameConfigWriter.Save(updatedRaw));
        Host.SetDraftConfig(updated);
        _preview = null;
    }
}
