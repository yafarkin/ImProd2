@page "/admin/teams"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host

<PageTitle>Команды</PageTitle>

<p><a href="/admin">← Назад к администратору</a></p>

<h1>Команды</h1>

@if (!_sessionStarted)
{
    <p>Следующая команда будет автоматически назначена в сектор: <strong>@NextSector().Name</strong></p>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <input class="form-control d-inline-block w-auto" @bind="_newTeamName" placeholder="Название команды" />
        <input type="number" min="0" step="0.01" class="form-control d-inline-block" style="width:8em" @bind="_newTeamStartingLoan" />
        <span>стартовый заём</span>
        <button type="button" class="btn btn-secondary" @onclick="AddTeam">Добавить команду</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Команда</th>
                    <th>Сектор</th>
                    <th>Стартовый заём</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in Host.StagedTeams)
                {
                    <tr>
                        <td>@team.Name</td>
                        <td>@SectorName(team.SectorId)</td>
                        <td>@DashboardDisplay.FormatMoney(team.StartingLoanAmount)</td>
                        <td><button type="button" class="btn btn-secondary btn-sm" @onclick="() => RemoveTeam(team.Id)">Убрать</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted"><em>Когда состав готов — вернитесь на <a href="/admin">страницу администратора</a>, чтобы начать сессию.</em></p>
}
else
{
    <div class="alert alert-info">Нельзя править состав участников — игровая сессия уже началась.</div>

    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Команда</th>
                    <th>Сектор</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in _teams)
                {
                    <tr>
                        <td>@team.Name</td>
                        <td>@team.Sector.Name</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _sessionStarted;
    private IReadOnlyList<Game.Domain.Team> _teams = Array.Empty<Game.Domain.Team>();
    private string _newTeamName = string.Empty;
    private decimal _newTeamStartingLoan;
    private Timer? _tickTimer;

    protected override void OnInitialized()
    {
        Refresh();

        _tickTimer = new Timer(_ =>
        {
            Refresh();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void Refresh()
    {
        lock (Host.SyncRoot)
        {
            _sessionStarted = Host.Session is not null;
            if (!_sessionStarted)
            {
                return;
            }

            _teams = Host.Session!.State.Teams.Values.OrderBy(t => t.Name, StringComparer.Ordinal).ToList();
        }
    }

    private Sector NextSector() => SectorAssignmentCalculator.LeastFilled(
        Host.DraftConfig.Sectors,
        Host.StagedTeams
            .Select(t => new TeamSpec { Id = t.Id, Name = t.Name, SectorId = t.SectorId, StartingLoanAmount = t.StartingLoanAmount })
            .ToList());

    private string SectorName(string sectorId) => Host.DraftConfig.Sectors.First(s => s.Id == sectorId).Name;

    private void AddTeam()
    {
        if (string.IsNullOrWhiteSpace(_newTeamName))
        {
            return;
        }

        Host.AddStagedTeam(_newTeamName.Trim(), NextSector().Id, _newTeamStartingLoan);
        _newTeamName = string.Empty;
        _newTeamStartingLoan = 0m;
    }

    private void RemoveTeam(Ulid id) => Host.RemoveStagedTeam(id);

    public void Dispose() => _tickTimer?.Dispose();
}
