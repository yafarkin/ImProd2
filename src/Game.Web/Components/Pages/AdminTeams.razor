@page "/admin/teams"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host

<PageTitle>Команды</PageTitle>

<p><a href="/admin">← Назад к администратору</a></p>

<h1>Команды</h1>

@if (!_sessionStarted)
{
    <p class="text-muted">
        <strong>@RoleDisplay.Name(ParticipantRole.Manager)</strong> — @RoleDisplay.Description(ParticipantRole.Manager)
        QR-код, который вы получите ниже, уже рабочий — управляющий может входить сразу, не дожидаясь
        «Начать сессию» (просто увидит, что сессия ещё готовится). Переговорщиков себе в команду
        управляющий обычно добавляет сам на странице «Команда» — они появятся здесь же, как только он
        это сделает. Сам код входа в таблице не показываем — только по клику на QR, чтобы его не
        сфотографировали с общего экрана.
    </p>
    <p>Следующая команда будет автоматически назначена в сектор: <strong>@NextSector().Name</strong></p>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <input class="form-control d-inline-block w-auto" @bind="_newTeamName" placeholder="Название команды" />
        <button type="button" class="btn btn-secondary" @onclick="AddTeam">Добавить команду</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Команда</th>
                    <th>Сектор</th>
                    <th>Участники</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in Host.StagedTeams)
                {
                    var manager = StagedManagerOf(team.Id);
                    <tr>
                        <td>@team.Name</td>
                        <td>@SectorName(team.SectorId)</td>
                        <td>
                            <div class="d-flex align-items-center gap-1 mb-1">
                                <span class="text-muted small" style="width:7em">@RoleDisplay.Name(ParticipantRole.Manager):</span>
                                @if (manager is null)
                                {
                                    <input class="form-control form-control-sm" style="width:10em" @bind:get="GetNewManagerName(team.Id)" @bind:set="v => SetNewManagerName(team.Id, v)" placeholder="Имя управляющего" />
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => AddManager(team.Id)">Назначить</button>
                                }
                                else
                                {
                                    <span>@manager.DisplayName</span>
                                    <a href="@QrLink(manager, team.Name)" target="_blank">QR</a>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Host.RemoveStagedParticipant(manager.Id)">Убрать</button>
                                }
                            </div>
                            @foreach (var negotiator in StagedNegotiatorsOf(team.Id))
                            {
                                <div class="d-flex align-items-center gap-1 mb-1">
                                    <span class="text-muted small" style="width:7em">@RoleDisplay.Name(ParticipantRole.Negotiator):</span>
                                    <span>@negotiator.DisplayName</span>
                                    <a href="@QrLink(negotiator, team.Name)" target="_blank">QR</a>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Host.RemoveStagedParticipant(negotiator.Id)">Убрать</button>
                                </div>
                            }
                        </td>
                        <td><button type="button" class="btn btn-secondary btn-sm" @onclick="() => RemoveTeam(team.Id)">Убрать команду</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted"><em>Когда состав готов — вернитесь на <a href="/admin">страницу администратора</a>, чтобы начать сессию.</em></p>
}
else
{
    <div class="alert alert-info">Нельзя править состав участников — игровая сессия уже началась.</div>

    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Команда</th>
                    <th>Сектор</th>
                    <th>Участники</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in _teams)
                {
                    <tr>
                        <td>@team.Name</td>
                        <td>@team.Sector.Name</td>
                        <td>
                            @foreach (var participant in ParticipantsOf(team.Id))
                            {
                                <div>@RoleDisplay.Name(participant.Role): @participant.DisplayName · <a href="@QrLink(participant, team.Name)" target="_blank">QR</a></div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _sessionStarted;
    private IReadOnlyList<Game.Domain.Team> _teams = Array.Empty<Game.Domain.Team>();
    private IReadOnlyList<ParticipantRegistration> _participants = Array.Empty<ParticipantRegistration>();
    private string _newTeamName = string.Empty;
    private readonly Dictionary<Ulid, string> _newManagerNames = new();
    private Timer? _tickTimer;

    protected override void OnInitialized()
    {
        Refresh();

        _tickTimer = new Timer(_ =>
        {
            Refresh();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void Refresh()
    {
        using (Host.EnterSyncRootTimed(nameof(AdminTeams) + "." + nameof(Refresh)))
        {
            _sessionStarted = Host.Session is not null;
            if (!_sessionStarted)
            {
                return;
            }

            _teams = Host.Session!.State.Teams.Values.OrderBy(t => t.Name, StringComparer.Ordinal).ToList();
            _participants = Host.Session!.State.Participants.Values.ToList();
        }
    }

    private Sector NextSector() => SectorAssignmentCalculator.LeastFilled(
        Host.DraftConfig.Sectors,
        Host.StagedTeams
            .Select(t => new TeamSpec { Id = t.Id, Name = t.Name, SectorId = t.SectorId })
            .ToList());

    private string SectorName(string sectorId) => Host.DraftConfig.Sectors.First(s => s.Id == sectorId).Name;

    private void AddTeam()
    {
        if (string.IsNullOrWhiteSpace(_newTeamName))
        {
            return;
        }

        Host.AddStagedTeam(_newTeamName.Trim(), NextSector().Id);
        _newTeamName = string.Empty;
    }

    private void RemoveTeam(Ulid id) => Host.RemoveStagedTeam(id);

    private StagedParticipantSpec? StagedManagerOf(Ulid teamId) =>
        Host.StagedParticipants.FirstOrDefault(p => p.TeamId == teamId && p.Role == ParticipantRole.Manager);

    private IReadOnlyList<StagedParticipantSpec> StagedNegotiatorsOf(Ulid teamId) =>
        Host.StagedParticipants
            .Where(p => p.TeamId == teamId && p.Role == ParticipantRole.Negotiator)
            .OrderBy(p => p.DisplayName, StringComparer.Ordinal)
            .ToList();

    /// <summary>Управляющий сначала (та же роль, что и в черновике, выше), затем переговорщики — тот же порядок восприятия «кто главный, кто помогает».</summary>
    private IEnumerable<ParticipantRegistration> ParticipantsOf(Ulid teamId) =>
        _participants
            .Where(p => p.TeamId == teamId)
            .OrderBy(p => p.Role == ParticipantRole.Manager ? 0 : 1)
            .ThenBy(p => p.DisplayName, StringComparer.Ordinal);

    private string GetNewManagerName(Ulid teamId) => _newManagerNames.GetValueOrDefault(teamId, string.Empty);

    private void SetNewManagerName(Ulid teamId, string? value) => _newManagerNames[teamId] = value ?? string.Empty;

    private void AddManager(Ulid teamId)
    {
        var name = GetNewManagerName(teamId).Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        Host.AddStagedParticipant(ParticipantRole.Manager, teamId, name);
        _newManagerNames.Remove(teamId);
    }

    private static string QrLink(StagedParticipantSpec participant, string teamName) =>
        $"/admin/qr/{participant.Code}?name={Uri.EscapeDataString($"{participant.DisplayName} — {RoleDisplay.Name(participant.Role)} команды «{teamName}»")}";

    private static string QrLink(ParticipantRegistration participant, string teamName) =>
        $"/admin/qr/{participant.Code}?name={Uri.EscapeDataString($"{participant.DisplayName} — {RoleDisplay.Name(participant.Role)} команды «{teamName}»")}";

    public void Dispose() => _tickTimer?.Dispose();
}
