@page "/session"
@attribute [Authorize(Roles = "Administrator,Facilitator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host
@using Game.Config.Loading
@using Game.Config.ProductionModel
@using Game.Config.Session

<PageTitle>Сессия</PageTitle>

<h1>Сессия</h1>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (!_sessionStarted)
{
    <p>
        В черновике: команд — @Host.StagedTeams.Count, конфиг — @Host.DraftConfig.Raw.Sectors.Count
        секторов, @Host.DraftConfig.Raw.Materials.Count материалов (хеш @(Host.DraftConfig.ContentHash[..8])).
        Состав команд и персонала набирается на <a href="/admin">странице администратора</a>.
    </p>

    @if (_isAdministrator)
    {
        <h2 class="mt-3">Конфигурация игры</h2>
        <p class="text-muted">
            <em>
                Производственная модель (секторы, материалы, рецепты, фабрики, цены) и сессионные
                параметры (длительность, тайминг, сложность, включённые механики) выбираются
                независимо друг от друга — любая модель сочетается с любым сессионным набором.
                Загружать свой файл целиком имеет смысл, только если заранее подготовлен другой набор
                правил под конкретное мероприятие — в том же JSON-формате.
            </em>
        </p>
        <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
            <div>
                <label for="productionModelSelect" class="form-label d-block">Производственная модель</label>
                <select id="productionModelSelect" class="form-select" @bind="_selectedProductionModelId">
                    @foreach (var (id, model) in Host.ProductionModels)
                    {
                        <option value="@id">@ProductionModelLabel(id, model)</option>
                    }
                </select>
            </div>
            <div>
                <label for="sessionConfigSelect" class="form-label d-block">Сессионные параметры</label>
                <select id="sessionConfigSelect" class="form-select" @bind="_selectedSessionConfigId">
                    @foreach (var (id, session) in Host.SessionConfigs)
                    {
                        <option value="@id">@SessionConfigLabel(id, session)</option>
                    }
                </select>
            </div>
            <div>
                <label for="difficultyLevel" class="form-label d-block">Сложность (проверен весь диапазон 0–5)</label>
                <input id="difficultyLevel" type="number" min="0" max="5" step="0.1" class="form-control" style="width:7em"
                       @bind="_difficultyLevel" />
            </div>
            <button type="button" class="btn btn-secondary" @onclick="ApplyProductionModelAndSession">Применить</button>
        </div>
        <p class="text-muted">
            <em>
                Непрерывный множитель поверх шести именованных рычагов баланса (доходность сбыта,
                стоимость постройки, бонус R&amp;D, пороги исследований, наценка аварийной закупки,
                скорость износа) — уровень 3.0 (дефолт) ничего не меняет, это уже
                откалиброванная экономика. Сейчас применена сложность
                @_appliedDifficultyLevel.ToString("0.0").
                Анкеры пересчитаны 2026-09-08 (блок 11.11): все шесть целых уровней проходят
                диагностику цепочки чисто на обеих боевых моделях. Ниже 3.0 партия легче
                (выше цены сбыта, дешевле стройка, меньше износа, быстрее исследования), выше —
                тяжелее, но проходима до самого верха: на уровне 5 идеальный зал зарабатывает вдвое
                меньше, чем на 3, а реальный бот — вчетверо меньше.
            </em>
        </p>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <InputFile OnChange="OnConfigFileSelected" class="form-control d-inline-block w-auto" />
            <a href="/admin/price-ladder" class="btn btn-secondary">Пересчитать цены продажи системе</a>
        </div>

        <h2 class="mt-4">Длительность фаз</h2>
        <p class="text-muted">
            <em>
                Тайминг из загруженного конфига — здесь его можно быстро подправить отдельно, не
                трогая остальные данные. Сейчас это чисто отладочная ручка: увеличьте, если нужно
                успеть прожать сценарий руками в интерфейсе, уменьшите — чтобы быстро прогнать много
                ходов подряд. Как и любая правка конфига, применение сбрасывает набранный состав
                команд в черновике (см. чек-лист ниже) — меняйте тайминг до набора команд либо
                наберите их заново после.
            </em>
        </p>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <label for="decisionSeconds">Фаза решений, сек:</label>
            <input id="decisionSeconds" type="number" min="1" class="form-control d-inline-block" style="width:7em" @bind="_decisionSeconds" />
            <label for="settlementSeconds">Фаза расчёта, сек:</label>
            <input id="settlementSeconds" type="number" min="1" class="form-control d-inline-block" style="width:7em" @bind="_settlementSeconds" />
            <button type="button" class="btn btn-secondary" @onclick="ApplyPhaseTiming">Применить</button>
        </div>

        <h2 class="mt-4">Чек-лист готовности</h2>
        <ul class="list-unstyled">
            <li>Команд в черновике: @Host.StagedTeams.Count</li>
            <li>Секторы охвачены: @(Host.StagedTeams.Count == 0 ? "—" : string.Join(", ", Host.StagedTeams.Select(t => SectorName(t.SectorId)).Distinct()))</li>
            <li>Команд без управляющего: @_teamsWithoutManagerCount</li>
            <li>Операторов в черновике: @_stagedOperatorCount</li>
            <li>Ведущих в черновике: @_stagedFacilitatorCount</li>
        </ul>

        <h2 class="mt-3">Начать сессию</h2>
        <p class="mb-3">
            Длительность: <strong>@DurationLabel(Host.DraftConfig.Raw)</strong>.
            <span class="text-muted">
                <em>
                    Число ходов задано производственной моделью и не выбирается — под формат
                    мероприятия подгоняется длина хода (фазы выше). Точный ход окончания
                    разыгрывается на старте и не показывается ни игрокам, ни ведущему.
                </em>
            </span>
        </p>
        <button type="button" class="btn btn-primary" @onclick="StartSession">Начать сессию</button>
    }
    else
    {
        <p><em>Сессия ещё не начата — ждите администратора.</em></p>
    }
}
else
{
    <p>
        Ход <strong>@_currentTurn</strong>, фаза <strong>@_phaseLabel</strong> (длительность @_phaseDuration).
        До конца фазы: <strong>@_countdown</strong>. Статус: <strong>@(_isPaused ? "пауза" : "идёт")</strong>.
    </p>
    <p class="text-muted"><em>@_phaseExplanation</em></p>
    @if (_lastNewsHeadline is not null)
    {
        <p><em>Последняя новость: @_lastNewsHeadline</em></p>
    }

    <h2 class="mt-3">Управление</h2>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <button type="button" class="btn btn-secondary" @onclick="AdvancePhaseNow">Ускорить фазу</button>
        <button type="button" class="btn btn-secondary" @onclick="TogglePause">@(_isPaused ? "Возобновить" : "Пауза")</button>
        <input type="number" min="1" class="form-control d-inline-block" style="width:5em" @bind="_extendSeconds" />
        <span>сек.</span>
        <button type="button" class="btn btn-secondary" @onclick="ExtendPhase">Продлить</button>
    </div>

    <h2 class="mt-4">Чек-лист готовности</h2>
    <ul class="list-unstyled">
        @foreach (var row in _teamChecklist)
        {
            <li>
                @row.Name — Управляющий: @(row.HasManager ? "✓" : "✗"), Переговорщик: @(row.HasNegotiator ? "✓" : "✗")
            </li>
        }
        <li>Оператор: @(_hasOperator ? "✓" : "✗")</li>
        <li>Ведущий: @(_hasFacilitator ? "✓" : "✗")</li>
    </ul>

    <h2 class="mt-4">Печатные материалы</h2>
    <p>
        <a href="/print/contract-form" target="_blank">Бланк сделки</a> ·
        <a href="/print/team-memo" target="_blank">Памятки команд</a>
    </p>

    <h2 class="mt-4">Экспорт истории</h2>
    <p>
        <a href="/export/journal.json">Журнал событий (JSON)</a> ·
        <a href="/export/turns.csv">Сводка по ходам (CSV)</a> ·
        <a href="/export/scores.csv">Итоговые счета команд (CSV)</a>
    </p>

    <h2 class="mt-4">История переходов</h2>
    <div class="table-responsive" style="max-height: 20em; overflow-y: auto;">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr><th>Время</th><th>Событие</th><th>Ход</th><th>Фаза</th></tr>
            </thead>
            <tbody>
                @foreach (var row in _history)
                {
                    <tr>
                        <td>@row.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td>@row.Description</td>
                        <td>@row.Turn</td>
                        <td>@PhaseDisplay.PhaseLabel(row.Phase)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="mt-4">Сброс сессии</h2>
    <p class="text-muted">
        <em>
            Начинает новую сессию с тем же составом команд и теми же кодами входа — для перехода от
            тренировочной игры к основной (SPEC §10). Текущий журнал архивируется на диске, но
            обратно из интерфейса не читается — выгрузите историю выше заранее, если она нужна.
        </em>
    </p>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span>Новая сессия: <strong>@DurationLabel(Host.DefaultConfig.Raw)</strong>.</span>
        <button type="button" class="btn btn-danger" @onclick="ResetSession">Сбросить и начать заново</button>
    </div>
}

@code {
    private sealed record TeamChecklistRow(string Name, bool HasManager, bool HasNegotiator);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _isAdministrator;

    private string? _selectedProductionModelId;
    private string? _selectedSessionConfigId;
    private double _difficultyLevel = 3.0;
    private double _appliedDifficultyLevel = 3.0;
    private string? _errorMessage;

    private int _decisionSeconds;
    private int _settlementSeconds;

    private bool _sessionStarted;
    private bool _isPaused;
    private int _currentTurn;
    private string _phaseLabel = string.Empty;
    private string _phaseExplanation = string.Empty;
    private string _phaseDuration = string.Empty;
    private string _countdown = string.Empty;
    private string? _lastNewsHeadline;
    private int _extendSeconds = 30;

    private int _teamsWithoutManagerCount;
    private int _stagedOperatorCount;
    private int _stagedFacilitatorCount;

    private IReadOnlyList<TeamChecklistRow> _teamChecklist = Array.Empty<TeamChecklistRow>();
    private bool _hasOperator;
    private bool _hasFacilitator;
    private IReadOnlyList<SessionHistoryRow> _history = Array.Empty<SessionHistoryRow>();

    private Timer? _tickTimer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        _isAdministrator = authState.User.IsInRole("Administrator");

        _selectedProductionModelId = Host.ProductionModels.Keys.FirstOrDefault();
        _selectedSessionConfigId = Host.SessionConfigs.Keys.FirstOrDefault();
        SyncPhaseTimingFields();

        Refresh();

        _tickTimer = new Timer(_ =>
        {
            Refresh();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void Refresh()
    {
        using (Host.EnterSyncRootTimed(nameof(SessionControl) + "." + nameof(Refresh)))
        {
            _sessionStarted = Host.Session is not null;
            if (!_sessionStarted)
            {
                var stagedParticipants = Host.StagedParticipants;
                var teamIdsWithManager = stagedParticipants
                    .Where(p => p.Role == ParticipantRole.Manager)
                    .Select(p => p.TeamId)
                    .ToHashSet();
                _teamsWithoutManagerCount = Host.StagedTeams.Count(t => !teamIdsWithManager.Contains(t.Id));
                _stagedOperatorCount = stagedParticipants.Count(p => p.Role == ParticipantRole.Operator);
                _stagedFacilitatorCount = stagedParticipants.Count(p => p.Role == ParticipantRole.Facilitator);
                return;
            }

            var session = Host.Session!;
            var state = session.State;

            _currentTurn = state.CurrentTurn;
            _phaseLabel = PhaseDisplay.PhaseLabel(state.CurrentPhase);
            _phaseExplanation = PhaseDisplay.PhaseExplanation(state.CurrentPhase);
            _phaseDuration = PhaseDisplay.FormatCountdown(PhaseTimerCalculator.TotalDuration(session));
            _countdown = PhaseDisplay.FormatCountdown(PhaseTimerCalculator.Remaining(session, DateTimeOffset.UtcNow));
            _isPaused = state.IsPaused;
            _lastNewsHeadline = PhaseDisplay.FindLastNewsHeadline(session);

            var participants = state.Participants.Values.ToList();
            _teamChecklist = state.Teams.Values
                .OrderBy(t => t.Name, StringComparer.Ordinal)
                .Select(team => new TeamChecklistRow(
                    team.Name,
                    participants.Any(p => p.Role == ParticipantRole.Manager && p.TeamId == team.Id),
                    participants.Any(p => p.Role == ParticipantRole.Negotiator && p.TeamId == team.Id)))
                .ToList();
            _hasOperator = participants.Any(p => p.Role == ParticipantRole.Operator);
            _hasFacilitator = participants.Any(p => p.Role == ParticipantRole.Facilitator);

            _history = SessionHistoryCalculator.Build(session.Entries).Reverse().ToList();
        }
    }

    private string SectorName(string sectorId) => Host.DraftConfig.Sectors.First(s => s.Id == sectorId).Name;

    private void SyncPhaseTimingFields()
    {
        _decisionSeconds = Host.DraftConfig.Raw.PhaseTiming.DecisionPhaseSeconds;
        _settlementSeconds = Host.DraftConfig.Raw.PhaseTiming.SettlementPhaseSeconds;
    }

    // Человекочитаемые названия — только для подписи в списке; неизвестный id (новый файл сэмпла,
    // ещё не описанный здесь) просто показывается как есть, ничего не ломает.
    private static readonly IReadOnlyDictionary<string, string> ProductionModelNames = new Dictionary<string, string>
    {
        ["training-1-sector"] = "Обучающая — металлургия, один сектор",
        ["main-3-sectors"] = "Боевая — металлургия, нефтехимия, лес",
    };

    private static readonly IReadOnlyDictionary<string, string> SessionConfigNames = new Dictionary<string, string>
    {
        ["main"] = "Основная",
    };

    private static string ProductionModelLabel(string id, ProductionModelConfig model)
    {
        var name = ProductionModelNames.TryGetValue(id, out var known) ? known : id;
        return $"{name} — {model.Materials.Count} материалов, {model.Sectors.Count} секторов";
    }

    private static string SessionConfigLabel(string id, SessionConfig session)
    {
        var name = SessionConfigNames.TryGetValue(id, out var known) ? known : id;
        return $"{name} ({session.Duration.MinTurns}-{session.Duration.MaxTurns} ходов)";
    }

    /// <summary>
    /// Длительность партии словами: диапазон ходов и во что он выливается по часам при текущей
    /// длине хода. Часы считаются из <see cref="PhaseTimingConfig"/> — единственного источника длины
    /// хода (см. doc-comment <see cref="SessionDurationConfig"/>), а не из отдельного «ориентировочно
    /// N минут», которое разъезжалось бы с фактическим таймером.
    /// </summary>
    private static string DurationLabel(Game.Config.GameConfig config)
    {
        var turnSeconds = config.PhaseTiming.SettlementPhaseSeconds + config.PhaseTiming.DecisionPhaseSeconds;
        var minHours = config.Duration.MinTurns * turnSeconds / 3600.0;
        var maxHours = config.Duration.MaxTurns * turnSeconds / 3600.0;
        return $"{config.Duration.MinTurns}-{config.Duration.MaxTurns} ходов по {turnSeconds / 60.0:0.#} мин " +
               $"— ориентировочно {minHours:0.#}-{maxHours:0.#} ч";
    }

    private void ApplyProductionModelAndSession()
    {
        _errorMessage = null;

        if (_selectedProductionModelId is null || !Host.ProductionModels.TryGetValue(_selectedProductionModelId, out var model))
        {
            _errorMessage = "Выберите производственную модель.";
            return;
        }

        if (_selectedSessionConfigId is null || !Host.SessionConfigs.TryGetValue(_selectedSessionConfigId, out var session))
        {
            _errorMessage = "Выберите сессионные параметры.";
            return;
        }

        if (_difficultyLevel is < 0 or > 5)
        {
            _errorMessage = "Сложность должна быть в диапазоне 0-5.";
            return;
        }

        try
        {
            Host.SetDraftConfig(GameConfigLoader.Load(model, session with { DifficultyLevel = _difficultyLevel }));
            _appliedDifficultyLevel = _difficultyLevel;
            SyncPhaseTimingFields();
        }
        catch (GameConfigValidationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task OnConfigFileSelected(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream());
            var json = await reader.ReadToEndAsync();
            var config = GameConfigLoader.Load(json);
            Host.SetDraftConfig(config);
            SyncPhaseTimingFields();
        }
        catch (GameConfigValidationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void ApplyPhaseTiming()
    {
        _errorMessage = null;
        if (_decisionSeconds < 1 || _settlementSeconds < 1)
        {
            _errorMessage = "Длительность фазы должна быть не меньше 1 секунды.";
            return;
        }

        try
        {
            var updatedRaw = Host.DraftConfig.Raw with
            {
                PhaseTiming = new PhaseTimingConfig
                {
                    DecisionPhaseSeconds = _decisionSeconds,
                    SettlementPhaseSeconds = _settlementSeconds,
                },
            };
            var updated = GameConfigLoader.Load(GameConfigWriter.Save(updatedRaw));
            Host.SetDraftConfig(updated);
            SyncPhaseTimingFields();
        }
        catch (GameConfigValidationException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void StartSession() => RunAction(() => Host.StartSessionFromDraft());

    private void AdvancePhaseNow() => RunAction(() => Host.Session!.AdvancePhase(PhaseTransitionTrigger.Facilitator));

    private void TogglePause() => RunAction(() =>
    {
        if (_isPaused)
        {
            Host.Session!.Resume();
        }
        else
        {
            Host.Session!.Pause();
        }
    });

    private void ExtendPhase() => RunAction(() => Host.Session!.ExtendCurrentPhase(TimeSpan.FromSeconds(_extendSeconds)));

    private void ResetSession() => RunAction(() => Host.ResetSession());

    private void RunAction(Action action)
    {
        _errorMessage = null;
        try
        {
            lock (Host.SyncRoot)
            {
                action();
            }
            Refresh();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }
    }

    public void Dispose() => _tickTimer?.Dispose();
}
