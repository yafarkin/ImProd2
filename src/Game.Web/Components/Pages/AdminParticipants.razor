@page "/admin/participants"
@attribute [Authorize(Roles = "Administrator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host

<PageTitle>Персонал</PageTitle>

<p><a href="/admin">← Назад к администратору</a></p>

<h1>Персонал</h1>
<p class="text-muted">Не игроки, а аккаунты тех, кто обслуживает игру: администраторы, операторы, ведущий.</p>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (!_sessionStarted)
{
    <p><em>Здесь заводятся роли без команды — администраторы, операторы, ведущий. Управляющих команд заводят на странице <a href="/admin/teams">«Команды»</a>, переговорщиков — сами управляющие после старта сессии.</em></p>
    <p><em>Код, который вы получите ниже, уже рабочий — можно раздавать сразу, не дожидаясь «Начать сессию».</em></p>

    <RoleHints Roles="RoleLessRoles" />

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <select class="form-select w-auto" @bind="_stageRole">
            @foreach (var role in RoleLessRoles)
            {
                <option value="@role">@RoleDisplay.Name(role)</option>
            }
        </select>
        <input class="form-control d-inline-block w-auto" @bind="_stageName" placeholder="Имя участника" />
        <button type="button" class="btn btn-secondary" @onclick="StageParticipant">Добавить</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Код</th>
                    <th>Роль</th>
                    <th>Имя</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var participant in Host.StagedParticipants.Where(p => p.TeamId is null))
                {
                    <tr>
                        <td><code>@participant.Code</code> <a href="@QrLink(participant)" target="_blank">QR</a></td>
                        <td>@RoleDisplay.Name(participant.Role)</td>
                        <td>@participant.DisplayName</td>
                        <td><button type="button" class="btn btn-secondary btn-sm" @onclick="() => Host.RemoveStagedParticipant(participant.Id)">Убрать</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <RoleHints Roles="AllRoles" />

    <h2>Регистрация участника</h2>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <select class="form-select w-auto" @bind="_registerRole">
            @foreach (var role in Enum.GetValues<ParticipantRole>())
            {
                <option value="@role">@RoleDisplay.Name(role)</option>
            }
        </select>
        @if (_registerRole is ParticipantRole.Manager or ParticipantRole.Negotiator)
        {
            <select class="form-select w-auto" @bind="_registerTeamId">
                @foreach (var team in _teams)
                {
                    <option value="@team.Id">@team.Name</option>
                }
            </select>
        }
        <input class="form-control d-inline-block w-auto" @bind="_registerName" placeholder="Имя участника" />
        <button type="button" class="btn btn-secondary" @onclick="RegisterParticipant">Зарегистрировать</button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th>Код</th>
                    <th>Роль</th>
                    <th>Команда</th>
                    <th>Имя</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var participant in _participants)
                {
                    <tr>
                        <td><code>@participant.Code</code></td>
                        <td>@RoleDisplay.Name(participant.Role)</td>
                        <td>@TeamName(participant.TeamId)</td>
                        <td>@participant.DisplayName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static readonly ParticipantRole[] RoleLessRoles =
    [
        ParticipantRole.Administrator, ParticipantRole.Operator, ParticipantRole.Facilitator,
    ];

    private static readonly ParticipantRole[] AllRoles = Enum.GetValues<ParticipantRole>();

    private bool _sessionStarted;
    private string? _errorMessage;
    private IReadOnlyList<Game.Domain.Team> _teams = Array.Empty<Game.Domain.Team>();
    private IReadOnlyList<ParticipantRegistration> _participants = Array.Empty<ParticipantRegistration>();

    private ParticipantRole _registerRole;
    private Ulid? _registerTeamId;
    private string _registerName = string.Empty;

    private ParticipantRole _stageRole = ParticipantRole.Operator;
    private string _stageName = string.Empty;

    private Timer? _tickTimer;

    protected override void OnInitialized()
    {
        Refresh();

        _tickTimer = new Timer(_ =>
        {
            Refresh();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void Refresh()
    {
        lock (Host.SyncRoot)
        {
            _sessionStarted = Host.Session is not null;
            if (!_sessionStarted)
            {
                return;
            }

            var state = Host.Session!.State;
            _teams = state.Teams.Values.OrderBy(t => t.Name, StringComparer.Ordinal).ToList();
            _participants = state.Participants.Values.ToList();

            if (_registerTeamId is null || _teams.All(t => t.Id != _registerTeamId))
            {
                _registerTeamId = _teams.Count > 0 ? _teams[0].Id : null;
            }
        }
    }

    private string TeamName(Ulid? teamId) =>
        teamId is { } id && _teams.FirstOrDefault(t => t.Id == id) is { } team ? team.Name : "—";

    private void StageParticipant()
    {
        _errorMessage = null;
        if (string.IsNullOrWhiteSpace(_stageName))
        {
            return;
        }

        try
        {
            Host.AddStagedParticipant(_stageRole, null, _stageName.Trim());
            _stageName = string.Empty;
        }
        catch (ArgumentException ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private static string QrLink(StagedParticipantSpec participant) =>
        $"/admin/qr/{participant.Code}?name={Uri.EscapeDataString($"{participant.DisplayName} — {RoleDisplay.Name(participant.Role)}")}";

    private void RegisterParticipant()
    {
        if (string.IsNullOrWhiteSpace(_registerName))
        {
            return;
        }

        var teamId = _registerRole is ParticipantRole.Manager or ParticipantRole.Negotiator ? _registerTeamId : null;
        var name = _registerName.Trim();
        RunAction(() => Host.RegisterParticipant(_registerRole, teamId, name));
        if (_errorMessage is null)
        {
            _registerName = string.Empty;
        }
    }

    private void RunAction(Action action)
    {
        _errorMessage = null;
        try
        {
            lock (Host.SyncRoot)
            {
                action();
            }
            Refresh();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }
    }

    public void Dispose() => _tickTimer?.Dispose();
}
