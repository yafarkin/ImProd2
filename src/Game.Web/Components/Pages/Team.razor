    private SellPreviewResult SellPreview(StockRow row)
    {
        var volume = _sellVolumes.GetValueOrDefault(row.MaterialId, 1m);
        if (_market is null || _economyConfig is null || volume <= 0 || !_market.HasQuote(row.MaterialId))
        {
            return new SellPreviewResult(HasQuote: false, 0m, 0m, 0m, 0m, 0m);
        }

        var result = MarketSaleCalculator.Calculate(_market, _economyConfig, row.Material, volume);
        var overflowUnitPrice = result.UnitPrice * _economyConfig.MarketCapacityOverflowDiscount;
        var realUnitCost = _realUnitCostByMaterialId.GetValueOrDefault(row.MaterialId);
        var profit = result.TotalRevenue - realUnitCost * volume;

        return new SellPreviewResult(HasQuote: true, result.UnitPrice, result.OverflowVolume, overflowUnitPrice, result.TotalRevenue, profit);
    }

