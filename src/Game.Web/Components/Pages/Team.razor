@page "/team"
@page "/team/{Section}"
@page "/team/factory/{FactoryIdText}"
@attribute [Authorize(Roles = "Manager,Negotiator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host
@inject IJSRuntime JS

@* Оболочка экрана команды (docs/manager-ui/README.md §8, блок 1): шапка, навигация по разделам и сам
   раздел. Данные и действия — в TeamScreen, разметка разделов — в Components/Team. Раньше всё это был
   один файл на две с лишним тысячи строк с семью вкладками, переключаемыми через display:none. *@

<PageTitle>Команда</PageTitle>

@if (_screen is not null)
{
    <div class="team-chrome">
        <TeamTopBar Screen="_screen" />
        <TeamSectionNav Screen="_screen" ActiveSection="@NavSection" />
    </div>

    <div class="team-body">
        @if (_showWelcome)
        {
            <div class="alert alert-info">
                <p>@RoleDisplay.Description(_screen.Role)</p>
                <p>Что можно делать:</p>
                <ul>
                    @foreach (var tip in RoleDisplay.Tips(_screen.Role))
                    {
                        <li>@tip</li>
                    }
                </ul>
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showWelcome = false">Понятно, дальше</button>
            </div>
        }

        @if (!_screen.SessionActive)
        {
            <div class="alert alert-warning">
                Сессия ещё не началась — администратор всё настраивает. Как только он нажмёт «Начать
                сессию», эта страница сама покажет актуальные данные (обновляется каждую секунду, обновлять
                вручную не нужно).
            </div>
        }
        else if (_screen.IsFinished && ActiveSection == TurnSectionName)
        {
            @* Партия кончилась — раньше страница просто застывала в последнем ходе, и игроки расходились,
               так и не узнав результат (docs/TODO.md №10). Редиректа нет намеренно: разделы после конца
               партии нужны как раз на разборе — «покажи, что у тебя было на складе». *@
            <div class="alert alert-success mb-3">
                <p class="mb-1"><strong>Партия завершена на ходу @_screen.CurrentTurn.</strong> Решения больше не принимаются.</p>
                <p class="mb-0"><a href="/results" class="alert-link">Посмотреть итоги игры →</a></p>
            </div>
        }

        @if (_screen.ErrorMessage is not null)
        {
            <div class="alert alert-danger">@_screen.ErrorMessage</div>
        }
        @if (_screen.InfoMessage is not null)
        {
            <div class="alert alert-success">@_screen.InfoMessage</div>
        }

        @if (FactoryIdText is not null)
        {
            <FactorySection Screen="_screen" FactoryId="@FactoryId" Anchor="@FactoryAnchorParam" />
        }
        else
        {
            @switch (ActiveSection)
            {
                case "production":
                    <ProductionSection Screen="_screen" />
                    break;
                case "deals":
                    <DealsSection Screen="_screen" ReplyToProposalId="@ReplyToProposalId" />
                    break;
                case "needs":
                    <NeedsSection Screen="_screen" />
                    break;
                case "analytics":
                    <AnalyticsSection Screen="_screen" />
                    break;
                case "members":
                    <MembersSection Screen="_screen" />
                    break;
                default:
                    <TurnSection Screen="_screen" />
                    break;
            }
        }
    </div>
}

@code {
    private const string TurnSectionName = "turn";

    private static readonly HashSet<string> KnownSections = new(StringComparer.Ordinal)
    {
        "production", "deals", "needs", "analytics", "members",
    };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>Раздел из адреса: <c>/team/production</c> и т. п.; пустой или незнакомый — «Ход».</summary>
    [Parameter]
    public string? Section { get; set; }

    [SupplyParameterFromQuery(Name = "welcome")]
    public string? WelcomeParam { get; set; }

    /// <summary>
    /// Фабрика из адреса <c>/team/factory/{id}</c> — отдельная страница фабрики (блок 3 редизайна).
    /// Строкой, а не <see cref="Ulid"/>: неверный адрес должен показать «фабрика не найдена», а не 404.
    /// </summary>
    [Parameter]
    public string? FactoryIdText { get; set; }

    /// <summary>Рычаг страницы фабрики, к которому прокрутить: <c>?tab=wear</c> для повода про капремонт и т. п.</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? FactoryAnchorParam { get; set; }

    private TeamScreen? _screen;
    private bool _showWelcome;
    private Timer? _tickTimer;

    /// <summary>Страница фабрики — часть «Производства»: навигация подсвечивает его, а не «Ход».</summary>
    private string ActiveSection => FactoryIdText is not null
        ? "production"
        : Section is { } section && KnownSections.Contains(section) ? section : TurnSectionName;

    private Ulid? FactoryId => Ulid.TryParse(FactoryIdText, out var factoryId) ? factoryId : null;

    /// <summary>Доска потребностей — часть «Сделок»: в навигации подсвечены они.</summary>
    private string NavSection => ActiveSection == "needs" ? "deals" : ActiveSection;

    /// <summary>Входящая заявка, на которую отвечают: <c>/team/deals?reply={id}</c> — так ведёт «Ответить заявкой» с «Хода».</summary>
    [SupplyParameterFromQuery(Name = "reply")]
    public string? ReplyParam { get; set; }

    private Ulid? ReplyToProposalId => Ulid.TryParse(ReplyParam, out var proposalId) ? proposalId : null;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask!).User;
        Enum.TryParse(user.FindFirst(ClaimTypes.Role)?.Value, out ParticipantRole role);
        var teamId = Ulid.TryParse(user.FindFirst("teamId")?.Value, out var parsedTeamId) ? parsedTeamId : Ulid.Empty;
        _showWelcome = WelcomeParam == "1";

        _screen = new TeamScreen(Host, teamId, role, user.FindFirst("code")?.Value, user.Identity?.Name);
        _screen.Changed += OnScreenChanged;

        _tickTimer = new Timer(_ =>
        {
            _screen.Refresh();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void OnScreenChanged() => InvokeAsync(StateHasChanged);

    /// <summary>
    /// Переход между разделами — это «улучшенная навигация» статического роутера: каждый раздел
    /// открывается новым экземпляром страницы, а браузер при этом прокрутку не сбрасывает — «Сделки»
    /// открывались с той высоты, на которой была прокручена «Аналитика» (живой обход 2026-10-04).
    /// Исключение — страница фабрики с рычагом в адресе: к нему прокручивает она сама.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && (FactoryIdText is null || FactoryAnchorParam is null))
        {
            await JS.InvokeVoidAsync("teamScreen.scrollToTop");
        }
    }

    public void Dispose()
    {
        _tickTimer?.Dispose();
        if (_screen is not null)
        {
            _screen.Changed -= OnScreenChanged;
        }
    }
}
