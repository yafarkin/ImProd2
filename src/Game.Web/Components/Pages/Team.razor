@page "/team"
@attribute [Authorize(Roles = "Manager,Negotiator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host
@inject NavigationManager Nav
@using static Game.Web.SvgMarkup
@using System.Net
@using System.Text
@using Game.Config.Economy

<PageTitle>Команда</PageTitle>

<style>
    .card:target { outline: 3px solid #2a78d6; outline-offset: 2px; }
</style>

<h1>Вы вошли как @DisplayName (@RoleDisplay.Name(_role))</h1>
<p>Команда: @TeamName</p>

@if (_showWelcome)
{
    <div class="alert alert-info">
        <p>@RoleDisplay.Description(_role)</p>
        <p>Что можно делать:</p>
        <ul>
            @foreach (var tip in RoleDisplay.Tips(_role))
            {
                <li>@tip</li>
            }
        </ul>
        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showWelcome = false">Понятно, дальше</button>
    </div>
}

@if (!_sessionActive)
{
    <div class="alert alert-warning">
        Сессия ещё не началась — администратор всё настраивает. Как только он нажмёт «Начать
        сессию», эта страница сама покажет актуальные данные (обновляется каждую секунду, обновлять
        вручную не нужно).
    </div>
}
else
{
    <div class="alert @(_isDecisionPhase ? "alert-info" : "alert-warning") mb-3">
        <p class="mb-1">
            Ход <strong>@_currentTurn</strong>, фаза <strong>@_phaseLabel</strong> (длительность @_phaseDuration).
            До конца фазы: <strong>@_countdown</strong>.
        </p>
        @if (!_isDecisionPhase)
        {
            <p class="mb-1">
                <strong>Решения сейчас недоступны</strong> — постройка, наём, продажи, кредиты и контракты
                заблокированы, пока не начнётся фаза «Решения». Дождитесь её.
            </p>
        }
        <p class="text-muted mb-0"><em>@_phaseExplanation</em></p>
        @if (_lastNewsHeadline is not null)
        {
            <p class="mb-0"><em>Последняя новость: @_lastNewsHeadline</em></p>
        }
    </div>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<ul class="nav nav-pills flex-nowrap mb-3" style="overflow-x:auto; white-space:nowrap">
    <li class="nav-item"><button type="button" class="nav-link @PageTabClass("overview")" @onclick='() => _activePageTab = "overview"'>Обзор</button></li>
    <li class="nav-item"><button type="button" class="nav-link @PageTabClass("factories")" @onclick='() => _activePageTab = "factories"'>Фабрики</button></li>
    <li class="nav-item"><button type="button" class="nav-link @PageTabClass("warehouse")" @onclick='() => _activePageTab = "warehouse"'>Склад</button></li>
    <li class="nav-item"><button type="button" class="nav-link @PageTabClass("finance")" @onclick='() => _activePageTab = "finance"'>Финансы</button></li>
    <li class="nav-item"><button type="button" class="nav-link @PageTabClass("contracts")" @onclick='() => _activePageTab = "contracts"'>Контракты</button></li>
</ul>

@* Все вкладки страницы рендерятся всегда и только скрываются через display:none (а не @if), —
   иначе Blazor Server при первом статическом ответе (до подключения клиента по SignalR) вообще не
   строит разметку неактивных вкладок, и любой обычный HTTP-тест страницы (без реального клика по
   вкладке) не увидит их содержимого. *@
<div style="display:@(_activePageTab == "overview" ? "" : "none")">
    @if (_role == ParticipantRole.Manager)
    {
        <h2>Состав команды</h2>
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr><th>Роль</th><th>Имя</th><th>Код</th></tr>
                </thead>
                <tbody>
                    @foreach (var member in _teamMembers)
                    {
                        <tr>
                            <td>@RoleDisplay.Name(member.Role)</td>
                            <td>@member.DisplayName</td>
                            <td><code>@member.Code</code> <a href="@QrLink(member)" target="_blank">QR</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
            <input class="form-control d-inline-block w-auto" @bind="_newMemberName" placeholder="Имя нового участника" />
            <button type="button" class="btn btn-secondary" @onclick="AddTeamMember">Добавить переговорщика</button>
        </div>
    }

    <h2>Что у меня плохо</h2>
    <ul class="list-unstyled">
        <li>Баланс: <strong class="@(_balance < 0 ? "text-danger" : null)">@DashboardDisplay.FormatMoney(_balance)</strong></li>
        <li>Долг: @DashboardDisplay.FormatMoney(_debt)</li>
        @if (_penaltyRateSurcharge > 0)
        {
            <li>Штрафная надбавка к ставке (от принудительных займов): @_penaltyRateSurcharge.ToString("P1")</li>
        }
        <li>
            Репутация: @_reputationPercentage.ToString("F0")%
            (@_reputationSampleCount @(_reputationSampleCount == 1 ? "факт" : "фактов"))
            @if (_reputationSampleCount < 3)
            {
                <em class="text-muted">— пока мало данных для оценки</em>
            }
        </li>
    </ul>
</div>
<div style="display:@(_activePageTab == "factories" ? "" : "none")">
    @if (!_isDecisionPhase)
    {
        <p><em>Решения недоступны — сейчас фаза «@_phaseLabel». Дождитесь фазы «Решения».</em></p>
    }
    else
    {
        <h3 id="decide-now">Построить фабрику</h3>
        @if (_buildableDefinitions.Count == 0)
        {
            <p><em>Все доступные типы фабрик сектора уже построены.</em></p>
        }
        else
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <select class="form-select w-auto" @bind="_selectedFactoryDefinitionId">
                    @foreach (var definition in _buildableDefinitions)
                    {
                        <option value="@definition.Id">@definition.Name (@DashboardDisplay.FormatMoney(definition.BuildCost))</option>
                    }
                </select>
                <button type="button" class="btn btn-primary" disabled="@(!CanAffordSelectedBuild)" @onclick="BuildFactory">Построить</button>
            </div>
            @if (!CanAffordSelectedBuild && SelectedBuildableDefinition is { } selectedForBuild)
            {
                <p class="text-danger mb-3">
                    Не хватает @DashboardDisplay.FormatMoney(selectedForBuild.BuildCost - _balance) —
                    <button type="button" class="btn btn-link p-0 align-baseline" @onclick='() => _activePageTab = "finance"'>возьмите кредит в Финансах</button>.
                </p>
            }
        }
    }

    <h3 class="mt-4">Фабрики</h3>
    @if (_factories.Count == 0 && _buildableDefinitions.Count == 0)
    {
        <p><em>В этом секторе нет ни одной фабрики.</em></p>
    }
    else
    {
        <p class="text-muted">
            Слева направо — по уровню сырьевой пирамиды. Сплошные узлы — построенные фабрики (число внутри
            — оценка прибыли за тик), пунктирные — «построить ещё» этого типа (есть всегда, даже если
            экземпляры уже есть). Красная рамка — этой фабрике не хватает сырья на общем складе команды,
            чтобы выйти на полную мощность прямо сейчас. Клик по сплошному узлу открывает карточку с
            деталями, по пунктирному — выбирает тип в форме постройки выше.
        </p>
        <svg width="@N(_factoryOverviewLayout!.Width)" height="@N(_factoryOverviewLayout.Height)" viewBox="@($"0 0 {N(_factoryOverviewLayout.Width)} {N(_factoryOverviewLayout.Height)}")" style="max-width: 100%; height: auto; border: 1px solid #e1e0d9;">
            @foreach (var node in _factoryOverviewLayout.Nodes)
            {
                @if (node.Instance is { } instance)
                {
                    var isSelected = instance.Id == _selectedFactoryId;
                    var shortOfInput = node.Status == FactoryOverviewDiagram.LoadStatus.ShortOfInput;
                    var loadColor = shortOfInput ? "#dc3545" : "#198754";
                    var subtitle = shortOfInput
                        ? $"рабочих: {instance.Workers} · нехватка сырья"
                        : $"рабочих: {instance.Workers} · {instance.SelectedRecipe.Output.Name}";
                    var profitText = node.Profit is { } profit ? DashboardDisplay.FormatMoney(profit) : "нет цены";
                    var profitColor = node.Profit is { } p2 ? (p2 >= 0 ? "#198754" : "#dc3545") : "#898781";
                    <g style="cursor:pointer" @onclick="() => SelectFactory(instance.Id)">
                        <rect x="@N(node.X)" y="@N(node.Y)" width="@N(node.Width)" height="@N(node.Height)" rx="6"
                              fill="@loadColor" fill-opacity="0.12"
                              stroke="@loadColor" stroke-width="@(isSelected ? 3 : 1.5)" />
                        @Text(node.X + node.Width / 2, node.Y + 17, "text-anchor:middle;font-size:13px;font-weight:600;fill:#0b0b0b",
                            node.IndexWithinType > 1 ? $"{instance.Definition.Name} №{node.IndexWithinType}" : instance.Definition.Name)
                        @Text(node.X + node.Width / 2, node.Y + 34, "text-anchor:middle;font-size:11px;fill:#52514e", subtitle)
                        @Text(node.X + node.Width / 2, node.Y + 51, $"text-anchor:middle;font-size:11px;font-weight:600;fill:{profitColor}", profitText)
                    </g>
                }
                else
                {
                    var alreadyBuilt = _factoryOverviewLayout.Nodes.Any(n => n.Definition.Id == node.Definition.Id && n.Instance is not null);
                    var buildCost = _buildCosts.GetValueOrDefault(node.Definition.Id);
                    // Нехватку денег не пишем прямо на узле — подпись не помещается в ширину узла и
                    // наезжает на соседние (клетки диаграммы узкие и фиксированной ширины). Явное
                    // предупреждение и disabled-кнопка — у формы постройки выше, туда и ведёт клик.
                    var caption = (alreadyBuilt ? "построить ещё · от " : "не построена · от ") + DashboardDisplay.FormatMoney(buildCost);
                    <g style="cursor:pointer" @onclick="() => SelectBuildable(node.Definition.Id)">
                        <rect x="@N(node.X)" y="@N(node.Y)" width="@N(node.Width)" height="@N(node.Height)" rx="6"
                              fill="none" stroke="#898781" stroke-width="1.5" stroke-dasharray="5 3" />
                        @Text(node.X + node.Width / 2, node.Y + 25, "text-anchor:middle;font-size:13px;font-weight:600;fill:#0b0b0b", node.Definition.Name)
                        @Text(node.X + node.Width / 2, node.Y + 43, "text-anchor:middle;font-size:11px;fill:#52514e", caption)
                    </g>
                }
            }
        </svg>

        @if (_history is { ProfitByLevel.Count: > 0 })
        {
            <h4 class="h6 mt-3">Прибыльность по уровням пирамиды (вся команда)</h4>
            @RenderChart(BuildProfitByLevelChartLayout())
        }

        @if (_selectedFactory is { } factory)
        {
            <div class="card mb-3" id="@($"factory-card-{factory.FactoryId}")">
                <div class="card-body">
                    <p><strong>@factory.DefinitionName</strong> — уровень @factory.Level</p>

                    <ul class="nav nav-pills flex-nowrap mb-3" style="overflow-x:auto; white-space:nowrap">
                        <li class="nav-item"><button type="button" class="nav-link @TabClass("workers")" @onclick='() => _activeFactoryTab = "workers"'>Люди</button></li>
                        <li class="nav-item"><button type="button" class="nav-link @TabClass("recipe")" @onclick='() => _activeFactoryTab = "recipe"'>Рецепт и склад</button></li>
                        <li class="nav-item"><button type="button" class="nav-link @TabClass("rnd")" @onclick='() => _activeFactoryTab = "rnd"'>R&amp;D</button></li>
                        <li class="nav-item"><button type="button" class="nav-link @TabClass("destination")" @onclick='() => _activeFactoryTab = "destination"'>Куда идёт продукция</button></li>
                        <li class="nav-item"><button type="button" class="nav-link @TabClass("profitability")" @onclick='() => _activeFactoryTab = "profitability"'>Прибыльность</button></li>
                        <li class="nav-item"><button type="button" class="nav-link @TabClass("pyramid")" @onclick='() => _activeFactoryTab = "pyramid"'>Себестоимость</button></li>
                        <li class="nav-item"><button type="button" class="nav-link @TabClass("charts")" @onclick='() => _activeFactoryTab = "charts"'>Графики</button></li>
                    </ul>

                    @if (_activeFactoryTab == "workers")
                    {
                        @if (_isDecisionPhase)
                        {
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <button type="button" class="btn btn-outline-secondary" disabled="@(factory.Workers == 0)" @onclick="() => FireWorkers(factory.FactoryId)">−</button>
                                <span class="fs-4">@factory.Workers</span>
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => HireWorkers(factory.FactoryId)">+</button>
                            </div>
                            <p class="text-muted small">
                                Нанять ещё одного: @DashboardDisplay.FormatMoney(_hireCostPerWorker) ·
                                уволить одного: @DashboardDisplay.FormatMoney(_fireCostPerWorker)
                            </p>
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                <label class="small text-muted mb-0">Доля при дефиците общего сырья:</label>
                                <input type="number" min="0" step="1" class="form-control d-inline-block" style="width:6em" @bind="_allocationShares[factory.FactoryId]" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SetAllocationShare(factory.FactoryId)">Задать долю</button>
                            </div>
                            <p class="text-muted small mt-1">
                                <em>Доля играет роль, только если это сырьё нужно больше чем одной вашей фабрике и его не хватает на всех — например, две фабрики одного типа.</em>
                            </p>
                        }
                        else
                        {
                            <p>Рабочих: @factory.Workers</p>
                            <p class="text-muted small">Доля при дефиците общего сырья: @factory.AllocationShare.ToString("0.##")</p>
                        }
                    }
                    else if (_activeFactoryTab == "recipe")
                    {
                        <p>Продукт: @factory.SelectedRecipeName</p>
                        @if (_isDecisionPhase && factory.RecipeOptions.Count > 1)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                                <select class="form-select w-auto" @bind="_selectedRecipeIds[factory.FactoryId]">
                                    @foreach (var recipe in factory.RecipeOptions)
                                    {
                                        <option value="@recipe.Id">@recipe.Name</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SelectRecipe(factory.FactoryId)">Сменить продукт</button>
                            </div>
                        }
                        <h4 class="h6 mt-2">Склад команды (общий на все фабрики)</h4>
                        <ul class="list-unstyled">
                            <li>@factory.ProducedMaterial.Name (продукт этой фабрики): @_teamWarehouseByMaterialId.GetValueOrDefault(factory.ProducedMaterial.Id).ToString("0.##")</li>
                            @foreach (var input in factory.Inputs)
                            {
                                <li>@input.Material.Name (сырьё): @_teamWarehouseByMaterialId.GetValueOrDefault(input.Material.Id).ToString("0.##")</li>
                            }
                        </ul>
                    }
                    else if (_activeFactoryTab == "rnd")
                    {
                        <p>
                            Вложено @factory.RndInvestment.ToString("0.##")
                            @if (factory.NextLevelThreshold is { } threshold)
                            {
                                <text>(до следующего уровня: @threshold.ToString("0.##"))</text>
                            }
                            else
                            {
                                <text>(максимальный уровень)</text>
                            }
                        </p>
                        @if (_isDecisionPhase)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <input type="number" min="0.01" step="0.01" class="form-control d-inline-block" style="width:6em" @bind="_rndInvestAmounts[factory.FactoryId]" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => InvestInRnd(factory.FactoryId)">Вложить в R&amp;D</button>
                            </div>
                        }
                    }
                    else if (_activeFactoryTab == "destination")
                    {
                        <p class="text-muted">
                            Отдельно направить продукцию некуда — весь выход зачисляется на общий склад
                            команды. Оттуда его в следующий ход автоматически заберёт любая ваша фабрика,
                            которой этот материал нужен как сырьё; если сырья на всех не хватит — по доле
                            в разделе «Люди». Остаток можно продать по контракту или системе (разделы «Склад» и
                            «Контракты» ниже).
                        </p>
                        @if (factory.ConsumingFactoryNames.Count > 0)
                        {
                            <p>Сейчас это потребляют: @string.Join(", ", factory.ConsumingFactoryNames).</p>
                        }
                        else
                        {
                            <p><em>Пока ни одна из ваших фабрик не использует это как сырьё — весь выход идёт на продажу.</em></p>
                        }
                    }
                    else if (_activeFactoryTab == "profitability")
                    {
                        <h4 class="h6">Теоретический максимум (без учёта нехватки сырья)</h4>
                        <ul class="list-unstyled">
                            <li>
                                Рабочие: @factory.CapacityBreakdown.Workers → эффективная мощность @factory.CapacityBreakdown.EffectiveCapacity.ToString("0.##")
                                @if (factory.CapacityBreakdown.Workers > _baseWorkerCount)
                                {
                                    <span class="text-muted">(после @_baseWorkerCount рабочих — с убывающей отдачей)</span>
                                }
                            </li>
                            <li>Уровень фабрики (R&amp;D): @factory.CapacityBreakdown.Level → бонус к скорости ×@factory.CapacityBreakdown.LevelBonus.ToString("0.##")</li>
                            <li>Скорость рецепта: ×@factory.CapacityBreakdown.RecipeProductionRate.ToString("0.##")</li>
                            <li>
                                <strong>Максимум: @factory.CapacityBreakdown.TheoreticalMaxOutput.ToString("0.##") @factory.ProducedMaterial.Name за ход, если бы сырья хватало на всё.</strong>
                            </li>
                        </ul>
                        @if (factory.Profitability is { } profitability)
                        {
                            <ul class="list-unstyled">
                                <li>
                                    Выпуск за ход при текущих остатках: @profitability.ProjectedOutputQuantity.ToString("0.##")
                                    @if (profitability.ProjectedOutputQuantity < profitability.CapacityLimitedOutputQuantity)
                                    {
                                        <span class="text-danger">(ограничено нехваткой сырья, мощность — @profitability.CapacityLimitedOutputQuantity.ToString("0.##"))</span>
                                    }
                                </li>
                                <li>Выручка (по рыночной цене продукта): @DashboardDisplay.FormatMoney(profitability.Revenue)</li>
                                <li>Затраты на сырьё (по рыночной цене): @DashboardDisplay.FormatMoney(profitability.InputCost)</li>
                                <li>Зарплата рабочих: @DashboardDisplay.FormatMoney(profitability.WageCost)</li>
                                <li>
                                    Итог: <strong class="@(profitability.Profit >= 0 ? "text-success" : "text-danger")">@DashboardDisplay.FormatMoney(profitability.Profit)</strong>
                                </li>
                            </ul>
                            <p class="text-muted"><em>Оценка по текущим остаткам склада и рыночным ценам — не гарантирован факт на конец хода.</em></p>
                        }
                        else
                        {
                            <p><em>Прибыльность пока не посчитать — нет рыночных котировок.</em></p>
                        }
                    }
                    else if (_activeFactoryTab == "pyramid")
                    {
                        @if (factory.HasUnitCost)
                        {
                            <p>Себестоимость единицы: @DashboardDisplay.FormatMoney(factory.UnitCost)</p>
                            <ul>
                                @foreach (var row in factory.Pyramid)
                                {
                                    <li style="margin-left:@(row.Depth * 1.5)em">@row.Material.Name: @row.Quantity.ToString("0.##")</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p><em>Себестоимость пока не посчитать — нет рыночных котировок сырья.</em></p>
                        }
                    }
                    else if (_activeFactoryTab == "charts")
                    {
                        @if (_history is null)
                        {
                            <p><em>Графики появятся после первого хода сессии.</em></p>
                        }
                        else
                        {
                            <h4 class="h6">Остатки на складе по всей пирамиде сырья</h4>
                            @RenderStockChart(factory)
                            <h4 class="h6 mt-3">Объём выпуска по ходам</h4>
                            @RenderOutputChart(factory)

                            <h4 class="h6 mt-3">История по ходам (таблица)</h4>
                            @if (factory.ActivityHistory.Count == 0)
                            {
                                <p><em>Данных пока нет — появятся после первого производства.</em></p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-sm align-middle">
                                        <thead>
                                            <tr>
                                                <th>Ход</th>
                                                <th>Потреблено со склада</th>
                                                <th>Произведено (@factory.ProducedMaterial.Name)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in factory.ActivityHistory.AsEnumerable().Reverse())
                                            {
                                                <tr>
                                                    <td>@row.Turn</td>
                                                    <td>@row.ConsumedSummary</td>
                                                    <td>@row.OutputQuantity.ToString("0.##")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        }
    }
</div>
<div style="display:@(_activePageTab == "warehouse" ? "" : "none")">
    <h3>Склад</h3>
    <p>
        Занято: @_usedCapacity.ToString("0.##") / @_freeCapacity.ToString("0.##") (бесплатный лимит)
        @if (_projectedWarehouseFee > 0)
        {
            <text> — превышение лимита; на следующем ходу спишется @DashboardDisplay.FormatMoney(_projectedWarehouseFee)</text>
        }
    </p>
    @if (_stock.Count == 0)
    {
        <p><em>Склад пуст.</em></p>
    }
    else
    {
        @foreach (var row in _stock)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <span>@row.MaterialName: @row.Quantity.ToString("0.##")</span>
                @if (_isDecisionPhase)
                {
                    <input type="number" min="1" step="1" class="form-control d-inline-block" style="width:6em" @bind="_sellVolumes[row.MaterialId]" @bind:event="oninput" />
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => SellToSystem(row.MaterialId)">Продать системе</button>
                }
            </div>
            @if (_isDecisionPhase)
            {
                var preview = SellPreview(row);
                <p class="text-muted small mb-2">
                    @if (preview.HasQuote)
                    {
                        <text>Цена за единицу: @DashboardDisplay.FormatMoney(preview.UnitPrice)</text>
                        @if (preview.OverflowVolume > 0)
                        {
                            <text> (из них @preview.OverflowVolume.ToString("0.##") сверх дневного лимита ёмкости — по @DashboardDisplay.FormatMoney(preview.OverflowUnitPrice))</text>
                        }
                        <text> · доход: @DashboardDisplay.FormatMoney(preview.Revenue)</text>
                        @if (preview.Profit is { } profit)
                        {
                            <text> · прибыль: </text>
                            <strong class="@(profit >= 0 ? "text-success" : "text-danger")">@DashboardDisplay.FormatMoney(profit)</strong>
                        }
                        else
                        {
                            <text> · прибыль пока не посчитать — нет рыночных котировок сырья в её пирамиде.</text>
                        }
                    }
                    else
                    {
                        <em>Нет рыночной котировки — продажу и доход по этому материалу оценить пока нельзя.</em>
                    }
                </p>
            }
        }
    }
    @if (_isDecisionPhase && _emergencyPurchaseEnabled && _emergencyPurchaseMaterials.Count > 0)
    {
        <h4>Аварийная закупка</h4>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <select class="form-select w-auto" @bind="_emergencyPurchaseMaterialId">
                @foreach (var material in _emergencyPurchaseMaterials)
                {
                    <option value="@material.Id">@material.Name</option>
                }
            </select>
            <input type="number" min="0.01" step="0.01" class="form-control d-inline-block" style="width:6em" @bind="_emergencyPurchaseVolume" />
            <button type="button" class="btn btn-secondary" @onclick="EmergencyPurchase">Купить</button>
        </div>
    }

    <h4 class="mt-4">Остатки по ходам</h4>
    @if (_history is null)
    {
        <p><em>График появится после первого хода сессии.</em></p>
    }
    else
    {
        @RenderChart(BuildWarehouseStockChartLayout())
    }
</div>
<div style="display:@(_activePageTab == "finance" ? "" : "none")">
    <h3>Финансы</h3>
    <p>
        Баланс: <strong class="@(_balance < 0 ? "text-danger" : null)">@DashboardDisplay.FormatMoney(_balance)</strong> ·
        долг: @DashboardDisplay.FormatMoney(_debt), текущая ставка: @DashboardDisplay.FormatRate(_currentLoanRate)
        @if (_penaltyRateSurcharge > 0)
        {
            <text> (включая штрафную надбавку @_penaltyRateSurcharge.ToString("P1") от принудительных займов)</text>
        }
    </p>
    @if (_isDecisionPhase)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <input type="number" min="0.01" step="0.01" class="form-control d-inline-block" style="width:8em" @bind="_loanAmount" @bind:event="oninput" />
            <button type="button" class="btn btn-secondary" @onclick="TakeLoan">Взять кредит</button>
        </div>
        <p>
            <em>
                Предпросмотр: ставка @DashboardDisplay.FormatRate(LoanPreview().Rate),
                платёж за следующий ход @DashboardDisplay.FormatMoney(LoanPreview().Payment)
            </em>
        </p>

        @if (_debt > 0)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <input type="number" min="0.01" max="@_debt" step="0.01" class="form-control d-inline-block" style="width:8em" @bind="_repayAmount" />
                <button type="button" class="btn btn-secondary" @onclick="RepayLoan">Погасить досрочно</button>
            </div>
            <p class="text-muted small">
                <em>
                    Сверх этого с баланса каждый ход и так автоматически списываются обязательный
                    платёж по телу долга (сейчас — @DashboardDisplay.FormatMoney(_debt * _mandatoryRepaymentRate) при текущем долге) и проценты.
                </em>
            </p>
        }
    }

    <h4 class="mt-4">История операций</h4>
    <p class="text-muted small">Всё, что двигает баланс или долг команды: кредиты, постройка фабрик, наём и зарплаты, R&amp;D, продажи и закупки, исполнение контрактов.</p>
    @if (_financeHistory.Count == 0)
    {
        <p><em>Операций пока не было.</em></p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr>
                        <th>Ход</th>
                        <th>Операция</th>
                        <th>Сумма</th>
                        <th>Ставка</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var operation in _financeHistory.Reverse())
                    {
                        var isIncome = operation.Direction == FinanceHistoryCalculator.MoneyDirection.Income;
                        <tr>
                            <td>@operation.Turn</td>
                            <td>@DashboardDisplay.FinanceOperationLabel(operation.Type)</td>
                            <td class="@(isIncome ? "text-success" : "text-danger")">@(isIncome ? "+" : "−")@DashboardDisplay.FormatMoney(operation.Amount)</td>
                            <td>@(operation.Rate is { } rate ? DashboardDisplay.FormatRate(rate) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<div style="display:@(_activePageTab == "contracts" ? "" : "none")">
    <h2>Контракты</h2>
    <p><a href="/team/negotiate">Переговорная панель</a> · <a href="/team/needs">Доска потребностей</a></p>

    @if (_isDecisionPhase)
    {
        <ContractDraftForm TeamId="_teamId" OnChanged="RefreshDashboard" />
    }

    @if (_contracts.Count == 0)
    {
        <p><em>Контрактов нет.</em></p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr>
                        <th>Роль</th>
                        <th>Контрагент</th>
                        <th>Материал</th>
                        <th>Тип</th>
                        <th>Объём</th>
                        <th>Цена</th>
                        <th>Штраф</th>
                        <th>Срок</th>
                        <th>Код</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contract in _contracts)
                    {
                        <tr>
                            <td>@contract.Role</td>
                            <td>@contract.CounterpartyName</td>
                            <td>@contract.MaterialName</td>
                            <td>@DashboardDisplay.ContractTypeLabel(contract.Type)</td>
                            <td>@contract.Volume.ToString("0.##")</td>
                            <td>@DashboardDisplay.FormatMoney(contract.UnitPrice)</td>
                            <td>@DashboardDisplay.FormatRate(contract.PenaltyRate)</td>
                            <td>@DashboardDisplay.FormatTurnRange(contract.Type, contract.EffectiveTurn, contract.SpotDeliveryTurn, contract.RecurringEndTurn)</td>
                            <td>@contract.ConfirmationCode</td>
                            <td>@contract.StatusLabel</td>
                            <td>
                                @if (_isDecisionPhase)
                                {
                                    @if (contract.Status == ContractStatus.PendingConfirmation && Role == "Manager")
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ConfirmContract(contract.ContractId)">Подтвердить</button>
                                    }
                                    @if (contract.Status == ContractStatus.Active)
                                    {
                                        <div class="d-flex flex-wrap gap-2 mb-2">
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => TerminateMutual(contract.ContractId)">Расторгнуть по согласию</button>
                                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => TerminateVoluntary(contract.ContractId)">Расторгнуть в одностороннем порядке</button>
                                        </div>

                                        @if (contract.Type == ContractType.Recurring)
                                        {
                                            @if (contract.HasPendingRevision)
                                            {
                                                @if (contract.PendingRevisionIsMine)
                                                {
                                                    <p><em>Предложен пересмотр — ждём ответа второй стороны.</em></p>
                                                }
                                                else
                                                {
                                                    <p>
                                                        Предложен пересмотр: объём @contract.PendingVolume?.ToString("0.##"),
                                                        цена @DashboardDisplay.FormatMoney(contract.PendingUnitPrice ?? 0m),
                                                        штраф @DashboardDisplay.FormatRate(contract.PendingPenaltyRate ?? 0m),
                                                        до хода @contract.PendingRecurringEndTurn.
                                                    </p>
                                                    @if (Role == "Manager")
                                                    {
                                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => AcceptRevision(contract.ContractId)">Принять</button>
                                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => RejectRevision(contract.ContractId)">Отклонить</button>
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-wrap align-items-center gap-2">
                                                    <input type="number" min="0.01" step="0.01" class="form-control d-inline-block" style="width:5em" @bind="_revisionVolumes[contract.ContractId]" />
                                                    <input type="number" min="0.01" step="0.01" class="form-control d-inline-block" style="width:5em" @bind="_revisionUnitPrices[contract.ContractId]" />
                                                    <input type="number" min="0" max="1" step="0.01" class="form-control d-inline-block" style="width:4em" @bind="_revisionPenaltyRates[contract.ContractId]" />
                                                    <input type="number" min="1" class="form-control d-inline-block" style="width:4em" @bind="_revisionEndTurns[contract.ContractId]" />
                                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => ProposeRevision(contract.ContractId)">Предложить пересмотр</button>
                                                </div>
                                            }
                                        }
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private sealed record FactoryRow(
        Ulid FactoryId, string DefinitionName, int Level, int Workers,
        Material ProducedMaterial, string SelectedRecipeName, IReadOnlyList<(string Id, string Name)> RecipeOptions,
        IReadOnlyList<RecipeInput> Inputs,
        bool HasUnitCost, decimal UnitCost, IReadOnlyList<DashboardDisplay.PyramidRow> Pyramid,
        decimal RndInvestment, decimal? NextLevelThreshold, decimal AllocationShare,
        IReadOnlyList<string> ConsumingFactoryNames,
        FactoryProfitabilityCalculator.FactoryProfitabilityEstimate? Profitability,
        ProductionCalculator.CapacityBreakdown CapacityBreakdown,
        IReadOnlyList<FactoryActivityRow> ActivityHistory);

    /// <summary>Одна строка таблицы «История по ходам» — что фабрика потребила со склада и сколько произвела за тот же ход (оба значения из одного и того же события <see cref="FactoryProduced"/>).</summary>
    private sealed record FactoryActivityRow(int Turn, string ConsumedSummary, decimal OutputQuantity);

    private sealed record BuildableDefinition(string Id, string Name, decimal BuildCost);

    private sealed record ContractRow(
        Ulid ContractId, string Role, string CounterpartyName, string MaterialName,
        ContractType Type, decimal Volume, decimal UnitPrice, decimal PenaltyRate,
        ContractStatus Status, string StatusLabel, string ConfirmationCode,
        int EffectiveTurn, int? SpotDeliveryTurn, int? RecurringEndTurn,
        bool HasPendingRevision, bool PendingRevisionIsMine,
        decimal? PendingVolume, decimal? PendingUnitPrice, decimal? PendingPenaltyRate, int? PendingRecurringEndTurn);

    private sealed record StockRow(string MaterialId, string MaterialName, Material Material, decimal Quantity);

    /// <summary>
    /// Предпросмотр продажи материала системе (запрос пользователя: «сразу видеть ставку, доход и
    /// прибыль») — пересчитывается на лету из уже закешированных <see cref="_market"/>/
    /// <see cref="_economyConfig"/>/<see cref="_unitCostByMaterialId"/> при каждом изменении
    /// объёма, той же чистой функцией <see cref="MarketSaleCalculator.Calculate"/>, что и реальная
    /// продажа — предпросмотр не может разойтись с фактом. <see cref="Profit"/> — <see
    /// langword="null"/>, если себестоимость материала ещё не посчитать (нет рыночной котировки
    /// сырья в его пирамиде), тот же отказ, что у <see cref="DashboardDisplay.TryCalculateUnitCost"/>.
    /// </summary>
    private sealed record SellPreviewResult(
        bool HasQuote, decimal UnitPrice, decimal OverflowVolume, decimal OverflowUnitPrice,
        decimal Revenue, decimal? Profit);

    private sealed record MaterialOption(string Id, string Name);

    /// <summary>
    /// Строка «Состав команды» — общий вид для двух источников: до старта сессии это черновик
    /// (<see cref="GameSessionHost.StagedParticipants"/>), после — уже настоящие участники живой
    /// сессии (<see cref="ParticipantRegistration"/>). Управляющий может входить и добавлять
    /// переговорщиков ещё до старта (см. AddTeamMember), поэтому таблица обязана уметь показывать
    /// оба состояния одинаково.
    /// </summary>
    private sealed record TeamMemberRow(ParticipantRole Role, string DisplayName, string Code);

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "welcome")]
    public string? WelcomeParam { get; set; }

    private string? DisplayName;
    private string? Role;
    private ParticipantRole _role;
    private string? TeamName;
    private Ulid _teamId;
    private bool _showWelcome;
    private bool _sessionActive;
    private IReadOnlyList<TeamMemberRow> _teamMembers = Array.Empty<TeamMemberRow>();
    private string _newMemberName = string.Empty;
    private string _activePageTab = "overview";

    private int _currentTurn;
    private string _phaseLabel = string.Empty;
    private string _phaseExplanation = string.Empty;
    private bool _isDecisionPhase;
    private string _phaseDuration = string.Empty;
    private string _countdown = string.Empty;
    private string? _lastNewsHeadline;
    private Timer? _tickTimer;

    private decimal _balance;
    private decimal _debt;
    private decimal _penaltyRateSurcharge;
    private decimal _reputationPercentage;
    private int _reputationSampleCount;

    private IReadOnlyList<FactoryRow> _factories = Array.Empty<FactoryRow>();
    private IReadOnlyList<BuildableDefinition> _buildableDefinitions = Array.Empty<BuildableDefinition>();
    private FactoryOverviewDiagram.Layout? _factoryOverviewLayout;
    private FactoryHistoryCalculator.TeamFactoryHistory? _history;
    private int _historyEntryCount = -1;
    private Ulid? _selectedFactoryId;
    private FactoryRow? _selectedFactory => _factories.FirstOrDefault(f => f.FactoryId == _selectedFactoryId);
    private string _activeFactoryTab = "workers";
    private decimal _hireCostPerWorker;
    private decimal _fireCostPerWorker;
    private int _baseWorkerCount;
    private readonly Dictionary<string, decimal> _teamWarehouseByMaterialId = new();
    private readonly Dictionary<string, decimal> _buildCosts = new();
    private Market? _market;
    private EconomyConfig? _economyConfig;
    private readonly Dictionary<string, decimal> _unitCostByMaterialId = new();
    private IReadOnlyList<ContractRow> _contracts = Array.Empty<ContractRow>();
    private IReadOnlyList<StockRow> _stock = Array.Empty<StockRow>();
    private IReadOnlyList<MaterialOption> _emergencyPurchaseMaterials = Array.Empty<MaterialOption>();

    private readonly Dictionary<Ulid, string> _selectedRecipeIds = new();
    private readonly Dictionary<Ulid, decimal> _rndInvestAmounts = new();
    private readonly Dictionary<Ulid, decimal> _allocationShares = new();
    private readonly Dictionary<string, decimal> _sellVolumes = new();
    private readonly Dictionary<Ulid, decimal> _revisionVolumes = new();
    private readonly Dictionary<Ulid, decimal> _revisionUnitPrices = new();
    private readonly Dictionary<Ulid, decimal> _revisionPenaltyRates = new();
    private readonly Dictionary<Ulid, int> _revisionEndTurns = new();
    private string? _selectedFactoryDefinitionId;
    private string? _errorMessage;

    private decimal _usedCapacity;
    private decimal _freeCapacity;
    private decimal _projectedWarehouseFee;
    private bool _emergencyPurchaseEnabled;
    private string? _emergencyPurchaseMaterialId;
    private decimal _emergencyPurchaseVolume = 1m;

    private Game.Config.Session.StartingConditionsConfig? _loanConfig;
    private decimal _currentLoanRate;
    private decimal _loanAmount = 100m;
    private decimal _repayAmount = 100m;
    private decimal _mandatoryRepaymentRate;
    private IReadOnlyList<FinanceHistoryCalculator.FinanceOperation> _financeHistory = Array.Empty<FinanceHistoryCalculator.FinanceOperation>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var user = authState.User;

        DisplayName = user.Identity?.Name;
        Role = user.FindFirst(ClaimTypes.Role)?.Value;
        Enum.TryParse(Role, out _role);
        _showWelcome = WelcomeParam == "1";

        var teamIdClaim = user.FindFirst("teamId")?.Value;
        if (teamIdClaim is not null && Ulid.TryParse(teamIdClaim, out var teamId))
        {
            _teamId = teamId;
            lock (Host.SyncRoot)
            {
                if (Host.Session is not null && Host.Session.State.Teams.TryGetValue(teamId, out var team))
                {
                    TeamName = team.Name;
                }
            }
        }

        RefreshDashboard();

        _tickTimer = new Timer(_ =>
        {
            RefreshDashboard();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void RefreshDashboard()
    {
        lock (Host.SyncRoot)
        {
            if (Host.Session is null)
            {
                _sessionActive = false;
                _teamMembers = Host.StagedParticipants
                    .Where(p => p.TeamId == _teamId)
                    .OrderBy(p => p.Role.ToString(), StringComparer.Ordinal)
                    .Select(p => new TeamMemberRow(p.Role, p.DisplayName, p.Code))
                    .ToList();
                return;
            }
            _sessionActive = true;

            var state = Host.Session.State;

            _currentTurn = state.CurrentTurn;
            // Полный реплей журнала — не бесплатная операция, а страница обновляется раз в секунду:
            // пересчитываем только когда в журнале появились новые записи, а не на каждый тик
            // таймера. Раньше ключом кеша был текущий ход — но решения (взять кредит, погасить
            // долг) добавляют события внутри одного и того же хода, поэтому кеш по ходу не замечал
            // их до следующего хода: свежевзятый кредит не появлялся в истории операций сразу же.
            var entryCount = Host.Session!.Entries.Count;
            if (_history is null || _historyEntryCount != entryCount)
            {
                _history = FactoryHistoryCalculator.Summarize(Host.Session!.Entries, state.Config, _teamId);
                _financeHistory = FinanceHistoryCalculator.Summarize(Host.Session!.Entries, state.Config, _teamId);
                _historyEntryCount = entryCount;
            }
            _phaseLabel = PhaseDisplay.PhaseLabel(state.CurrentPhase);
            _phaseExplanation = PhaseDisplay.PhaseExplanation(state.CurrentPhase);
            _isDecisionPhase = state.CurrentPhase == TurnPhase.Decision;
            _phaseDuration = PhaseDisplay.FormatCountdown(PhaseTimerCalculator.TotalDuration(Host.Session!));
            _countdown = PhaseDisplay.FormatCountdown(PhaseTimerCalculator.Remaining(Host.Session!, DateTimeOffset.UtcNow));
            _lastNewsHeadline = PhaseDisplay.FindLastNewsHeadline(Host.Session!);
            var loanConfig = state.Config.Raw.StartingConditions;
            _loanConfig = loanConfig;
            _mandatoryRepaymentRate = loanConfig.MandatoryRepaymentRatePerTurn;
            _freeCapacity = state.Config.Raw.Warehouse.FreeCapacity;
            _emergencyPurchaseEnabled = state.Config.Raw.FeatureFlags.EmergencyPurchaseEnabled;
            _emergencyPurchaseMaterials = state.Config.Materials.Values
                .Where(m => state.Market.HasQuote(m.Id))
                .OrderBy(m => m.Id, StringComparer.Ordinal)
                .Select(m => new MaterialOption(m.Id, m.Name))
                .ToList();
            if (_emergencyPurchaseMaterialId is null || _emergencyPurchaseMaterials.All(m => m.Id != _emergencyPurchaseMaterialId))
            {
                _emergencyPurchaseMaterialId = _emergencyPurchaseMaterials.FirstOrDefault()?.Id;
            }

            if (!state.Teams.TryGetValue(_teamId, out var team))
            {
                return;
            }

            _teamMembers = state.Participants.Values
                .Where(p => p.TeamId == _teamId)
                .OrderBy(p => p.Role.ToString(), StringComparer.Ordinal)
                .Select(p => new TeamMemberRow(p.Role, p.DisplayName, p.Code))
                .ToList();

            _balance = team.Balance;
            _debt = team.Debt;
            _penaltyRateSurcharge = team.PenaltyRateSurcharge;

            var reputation = Host.Session!.GetReputation(_teamId);
            _reputationPercentage = reputation.Percentage;
            _reputationSampleCount = reputation.SampleCount;
            _currentLoanRate = FinanceCalculator.CalculateEffectiveLoanRate(team, loanConfig, _reputationPercentage);

            _market = state.Market;
            _economyConfig = state.Config.Raw.Economy;
            _unitCostByMaterialId.Clear();
            _stock = team.Warehouse.Stock.Select(s =>
            {
                _sellVolumes.TryAdd(s.Material.Id, 1m);
                if (DashboardDisplay.TryCalculateUnitCost(s.Material, state, out var unitCost))
                {
                    _unitCostByMaterialId[s.Material.Id] = unitCost;
                }
                return new StockRow(s.Material.Id, s.Material.Name, s.Material, s.Quantity);
            }).ToList();
            _usedCapacity = _stock.Sum(s => s.Quantity);
            _projectedWarehouseFee = WarehouseFeeCalculator.Calculate(_usedCapacity, state.Config.Raw.Warehouse).Fee;

            _teamWarehouseByMaterialId.Clear();
            foreach (var stockRow in team.Warehouse.Stock)
            {
                _teamWarehouseByMaterialId[stockRow.Material.Id] = stockRow.Quantity;
            }

            var salaryPerWorkerPerTurn = state.Config.Raw.WorkerProductivity.SalaryPerWorkerPerTurn;
            var profitabilityByFactoryId = new Dictionary<Ulid, FactoryProfitabilityCalculator.FactoryProfitabilityEstimate>();
            foreach (var factory in team.Factories)
            {
                if (FactoryProfitabilityCalculator.TryCalculate(
                    factory, team.Factories, team.Warehouse, state.Market,
                    state.Config.Raw.WorkerProductivity, state.Config.Raw.Rnd, salaryPerWorkerPerTurn, out var estimate))
                {
                    profitabilityByFactoryId[factory.Id] = estimate;
                }
            }

            var rndThresholds = state.Config.Raw.Rnd.CumulativeInvestmentThresholdsByLevel;
            _hireCostPerWorker = state.Config.Raw.WorkerProductivity.HireCostPerWorker;
            _fireCostPerWorker = state.Config.Raw.WorkerProductivity.FireCostPerWorker;
            _baseWorkerCount = state.Config.Raw.WorkerProductivity.BaseWorkerCount;
            _factories = team.Factories.Select(factory =>
            {
                _selectedRecipeIds.TryAdd(factory.Id, factory.SelectedRecipe.Id);
                _rndInvestAmounts.TryAdd(factory.Id, 50m);
                _allocationShares.TryAdd(factory.Id, factory.AllocationShare);

                var hasUnitCost = DashboardDisplay.TryCalculateUnitCost(factory.SelectedRecipe.Output, state, out var unitCost);
                var pyramid = hasUnitCost
                    ? DashboardDisplay.FlattenPyramid(CostCalculator.BuildInputPyramid(factory.SelectedRecipe.Output, 1m, state.Config.RecipeBook))
                    : Array.Empty<DashboardDisplay.PyramidRow>();
                var nextLevelThreshold = factory.Level - 1 < rndThresholds.Count ? rndThresholds[factory.Level - 1] : (decimal?)null;

                // Кто из своих же построенных фабрик заберёт этот выход как сырьё с общего склада —
                // прямой ответ на вопрос «куда идёт продукция» (см. пояснение в карточке ниже:
                // отдельного получателя задать нельзя, всё решает общий склад).
                var consumingFactoryNames = team.Factories
                    .Where(other => other.Id != factory.Id && other.SelectedRecipe.Inputs.Any(i => i.Material == factory.SelectedRecipe.Output))
                    .Select(other => other.Definition.Name)
                    .ToList();

                var capacityBreakdown = ProductionCalculator.CalculateCapacityBreakdown(
                    factory, state.Config.Raw.WorkerProductivity, state.Config.Raw.Rnd);

                // Потребление и выпуск идут из одного и того же события FactoryProduced (см.
                // doc-comment FactoryHistoryCalculator.TeamFactoryHistory) — оба ряда всегда одной
                // длины и в одном порядке ходов, поэтому их можно просто состыковать по индексу.
                var outputSeries = _history?.OutputByFactoryId.GetValueOrDefault(factory.Id) ?? Array.Empty<(int, decimal)>();
                var consumedSeries = _history?.ConsumedInputsByFactoryId.GetValueOrDefault(factory.Id)
                    ?? Array.Empty<(int, IReadOnlyDictionary<string, decimal>)>();
                var activityHistory = outputSeries.Zip(consumedSeries, (output, consumed) => new FactoryActivityRow(
                    output.Turn,
                    consumed.ConsumedInputs.Count == 0
                        ? "—"
                        : string.Join(", ", consumed.ConsumedInputs.Select(pair => $"{state.Config.Materials[pair.Key].Name}: {pair.Value.ToString("0.##")}")),
                    output.OutputQuantity)).ToList();

                return new FactoryRow(
                    factory.Id, factory.Definition.Name, factory.Level, factory.Workers,
                    factory.SelectedRecipe.Output, factory.SelectedRecipe.Output.Name,
                    factory.Definition.Recipes.Select(r => (r.Id, r.Output.Name)).ToList(),
                    factory.SelectedRecipe.Inputs,
                    hasUnitCost, unitCost, pyramid, factory.RndInvestment, nextLevelThreshold, factory.AllocationShare,
                    consumingFactoryNames, profitabilityByFactoryId.GetValueOrDefault(factory.Id),
                    capacityBreakdown, activityHistory);
            }).ToList();
            if (_selectedFactoryId is null || _factories.All(f => f.FactoryId != _selectedFactoryId))
            {
                _selectedFactoryId = _factories.FirstOrDefault()?.FactoryId;
            }
            // Раньше тип фабрики, который команда уже построила, пропадал из списка — ограничение
            // «один экземпляр на тип» было только здесь, в UI, а не в движке (GameSession.BuildFactory
            // его не проверяет). Команда осознанно может строить сколько угодно фабрик одного типа —
            // делить дефицитное сырьё между ними помогает AllocationShare (см. карточки фабрик ниже).
            var sectorDefinitions = state.Config.FactoryDefinitions.Where(d => d.Sector == team.Sector).ToList();
            _buildableDefinitions = sectorDefinitions
                .Select(d => new BuildableDefinition(
                    d.Id, d.Name, state.Config.Raw.FactoryDefinitions.First(f => f.Id == d.Id).BuildCost))
                .ToList();
            if (_selectedFactoryDefinitionId is null || _buildableDefinitions.All(d => d.Id != _selectedFactoryDefinitionId))
            {
                _selectedFactoryDefinitionId = _buildableDefinitions.FirstOrDefault()?.Id;
            }

            _buildCosts.Clear();
            foreach (var definition in sectorDefinitions)
            {
                _buildCosts[definition.Id] = state.Config.Raw.FactoryDefinitions.First(f => f.Id == definition.Id).BuildCost;
            }
            _factoryOverviewLayout = FactoryOverviewDiagram.Build(sectorDefinitions, team.Factories, profitabilityByFactoryId);

            _contracts = state.Contracts.Values
                .Where(c => c.BuyerTeamId == _teamId || c.SellerTeamId == _teamId)
                .Select(c =>
                {
                    var counterpartyId = c.BuyerTeamId == _teamId ? c.SellerTeamId : c.BuyerTeamId;
                    var counterpartyName = state.Teams.TryGetValue(counterpartyId, out var counterparty) ? counterparty.Name : "?";
                    var pending = Host.Session!.GetPendingContractRevision(c.Id);

                    _revisionVolumes.TryAdd(c.Id, c.Terms.Volume);
                    _revisionUnitPrices.TryAdd(c.Id, c.Terms.UnitPrice);
                    _revisionPenaltyRates.TryAdd(c.Id, c.Terms.PenaltyRate);
                    _revisionEndTurns.TryAdd(c.Id, c.Terms.RecurringEndTurn ?? _currentTurn);

                    return new ContractRow(
                        c.Id, c.BuyerTeamId == _teamId ? "Покупатель" : "Продавец", counterpartyName, c.Terms.Material.Name,
                        c.Terms.Type, c.Terms.Volume, c.Terms.UnitPrice, c.Terms.PenaltyRate,
                        c.Status, DashboardDisplay.ContractStatusLabel(c.Status), c.ConfirmationCode,
                        c.Terms.EffectiveTurn, c.Terms.SpotDeliveryTurn, c.Terms.RecurringEndTurn,
                        pending is not null, pending?.ProposingTeamId == _teamId,
                        pending?.Volume, pending?.UnitPrice, pending?.PenaltyRate, pending?.RecurringEndTurn);
                })
                .ToList();
        }
    }

