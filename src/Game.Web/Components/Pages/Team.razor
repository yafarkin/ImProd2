@page "/team"
@attribute [Authorize(Roles = "Manager,Negotiator")]
@rendermode InteractiveServer
@implements IDisposable
@inject GameSessionHost Host

<PageTitle>Команда</PageTitle>

<h1>Вы вошли как @DisplayName (@Role)</h1>
<p>Команда: @TeamName</p>

<p><em>Настоящий дашборд команды — Фаза 9. Пока это только подтверждение того, что вход по роли работает.</em></p>

<p>
    Ход <strong>@_currentTurn</strong>, фаза <strong>@_phaseLabel</strong>. До конца фазы:
    <strong>@_countdown</strong> (переход по таймеру — сервер, Блок 8.2, SPEC §4, §11; устойчив к
    обрыву/переподключению circuit при блокировке телефона, как и вход, — SPEC §11).
</p>
@if (_lastNewsHeadline is not null)
{
    <p><em>Последняя новость: @_lastNewsHeadline</em></p>
}

<form method="post" action="/auth/logout">
    <button type="submit" class="btn btn-secondary">Выйти</button>
</form>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? DisplayName;
    private string? Role;
    private string? TeamName;
    private int _currentTurn;
    private string _phaseLabel = string.Empty;
    private string _countdown = string.Empty;
    private string? _lastNewsHeadline;
    private Timer? _tickTimer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var user = authState.User;

        DisplayName = user.Identity?.Name;
        Role = user.FindFirst(ClaimTypes.Role)?.Value;

        var teamIdClaim = user.FindFirst("teamId")?.Value;
        if (teamIdClaim is not null && Ulid.TryParse(teamIdClaim, out var teamId)
            && Host.Session.State.Teams.TryGetValue(teamId, out var team))
        {
            TeamName = team.Name;
        }

        RefreshPhaseStatus();

        _tickTimer = new Timer(_ =>
        {
            RefreshPhaseStatus();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void RefreshPhaseStatus()
    {
        lock (Host.SyncRoot)
        {
            _currentTurn = Host.Session.State.CurrentTurn;
            _phaseLabel = PhaseDisplay.PhaseLabel(Host.Session.State.CurrentPhase);
            _countdown = PhaseDisplay.FormatCountdown(PhaseTimerCalculator.Remaining(Host.Session, DateTimeOffset.UtcNow));
            _lastNewsHeadline = PhaseDisplay.FindLastNewsHeadline(Host.Session);
        }
    }

    public void Dispose() => _tickTimer?.Dispose();
}
