    private readonly Dictionary<Ulid, decimal> _allocationShares = new();
    private readonly Dictionary<string, decimal> _sellVolumes = new();
    private readonly Dictionary<Ulid, decimal> _revisionVolumes = new();
    private readonly Dictionary<Ulid, decimal> _revisionUnitPrices = new();
    private readonly Dictionary<Ulid, decimal> _revisionPenaltyRates = new();
