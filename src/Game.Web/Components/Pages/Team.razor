    private IReadOnlyList<FactoryRow> _factories = Array.Empty<FactoryRow>();
    private IReadOnlyList<BuildableDefinition> _buildableDefinitions = Array.Empty<BuildableDefinition>();
    private IReadOnlyList<FactoryOverviewList.Node> _factoryOverviewRows = Array.Empty<FactoryOverviewList.Node>();
    private int _unlockedGeneration = 1;
    private FactoryHistoryCalculator.TeamFactoryHistory? _history;
