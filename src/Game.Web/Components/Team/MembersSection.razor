@* Состав команды и QR-коды — нужны один раз, до игры, поэтому живут в меню шапки, а не среди
   разделов (docs/manager-ui/README.md §4). *@

@if (Screen.Role == ParticipantRole.Manager)
{
    <h2>Состав команды</h2>
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr><th>Роль</th><th>Имя</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var member in Screen.TeamMembers)
                {
                    <tr>
                        <td>@RoleDisplay.Name(member.Role)</td>
                        <td>@member.DisplayName</td>
                        <td><a href="@Screen.QrLink(member)" target="_blank">QR</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <input class="form-control d-inline-block w-auto" @bind="Screen.NewMemberName" placeholder="Имя нового участника" />
        <button type="button" class="btn btn-secondary" @onclick="Screen.AddTeamMember">Добавить переговорщика</button>
    </div>
}

@code {
    /// <summary>Модель экрана команды — общая для всех разделов, её держит оболочка страницы.</summary>
    [Parameter, EditorRequired]
    public TeamScreen Screen { get; set; } = default!;
}
