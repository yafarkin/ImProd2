@* Четыре раздела экрана команды (docs/manager-ui/README.md §4): на телефоне — панель снизу, под
   большим пальцем, на широком экране — вкладки под шапкой. Каждый раздел — свой адрес, поэтому кнопка
   «Назад» браузера возвращает в предыдущий раздел, а не со страницы вовсе. *@

<nav class="team-nav">
    <NavLink href="team" Match="NavLinkMatch.All">
        <span class="ico">◉</span><span class="label">Ход</span>
        @if (Screen.Attention.Count > 0 && !Screen.IsFinished)
        {
            <span class="badge rounded-pill bg-danger">@Screen.Attention.Count</span>
        }
    </NavLink>
    <NavLink href="team/production">
        <span class="ico">▤</span><span class="label">Производство</span>
    </NavLink>
    <NavLink href="team/deals">
        <span class="ico">⇄</span><span class="label">Сделки</span>
        @if (Screen.AwaitingManagerCount > 0 && !Screen.IsFinished)
        {
            <span class="badge rounded-pill bg-danger">@Screen.AwaitingManagerCount</span>
        }
    </NavLink>
    <NavLink href="team/analytics">
        <span class="ico">∿</span><span class="label">Аналитика</span>
    </NavLink>
</nav>

@code {
    /// <summary>Модель экрана команды — нужна только счётчикам на разделах.</summary>
    [Parameter, EditorRequired]
    public TeamScreen Screen { get; set; } = default!;
}
