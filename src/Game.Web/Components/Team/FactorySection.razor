@inject IJSRuntime JS
@inject NavigationManager Nav

@* Страница фабрики /team/factory/{id} (docs/manager-ui/README.md §4, блок 3, макет mockups/factory.html).
   Раньше это была карточка под всем списком фабрик с семью вкладками: на телефоне клик по фабрике
   ничего видимо не менял, а нужный рычаг прятался за вкладкой (§2 п.6–7). Теперь все рычаги —
   рабочие, износ, R&D, продукт — на одном экране, подробности свёрнуты, продажа фабрики — внизу.
   «Требует внимания» и «Приказ на ход» ведут сюда с ?tab=… — к нужному рычагу. *@

<p class="mb-2"><a href="team/production">← Цепочка производства</a></p>

@if (Factory is not { } factory)
{
    <div class="alert alert-warning">Такой фабрики у вашей команды нет — возможно, её уже продали.</div>
}
else
{
    var lastOutput = factory.ActivityHistory.Count > 0 ? factory.ActivityHistory[^1].OutputQuantity : (decimal?)null;
    <div class="factory-page">
        <div class="min-w-0">
            <section class="mb-3">
                <h2 class="h4 mb-1">@factory.DefinitionName</h2>
                <p class="text-muted mb-2">передел @factory.ProducedMaterial.Level · ступень R&amp;D @factory.Level</p>
                @if (Screen.Role != ParticipantRole.Manager)
                {
                    <p class="text-muted small"><em>Управлять фабрикой может только управляющий — вы видите то же самое в режиме чтения.</em></p>
                }
                else if (!Screen.IsDecisionPhase)
                {
                    <p class="text-muted small"><em>Решения недоступны — сейчас фаза «@Screen.PhaseLabel». Кнопки появятся в фазе «Решения».</em></p>
                }
                <dl class="kv">
                    <dt>Выпуск в прошлый ход</dt>
                    <dd>@(lastOutput is { } output ? $"{output:0.##} ед. «{factory.ProducedMaterial.Name}»" : "расчётов ещё не было")</dd>
                    <dt>Потолок мощности</dt>
                    <dd>@factory.CapacityBreakdown.TheoreticalMaxOutput.ToString("0.##") @(factory.Inputs.Count == 0 ? "(сырья не нужно)" : "при полном сырье")</dd>
                    @if (factory.Profitability is { } estimate)
                    {
                        <dt>Себестоимость единицы</dt>
                        <dd>@DashboardDisplay.FormatUnitCost(estimate.UnitCost)</dd>
                        <dt>Рыночная цена</dt>
                        <dd>@DashboardDisplay.FormatUnitCost(estimate.OutputPrice)</dd>
                    }
                </dl>
            </section>

            <h2 class="h5">Управление</h2>

            <section class="lever" id="factory-workers">
                <h3 class="h6">Рабочие</h3>
                @if (Screen.CanManage)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="text-muted">Сейчас: @factory.Workers · объявлено на расчёт: @factory.DesiredWorkers</span>
                        <input type="number" min="0" step="1" class="form-control form-control-sm" style="width:6em" @bind="Screen.TargetWorkerCounts[factory.FactoryId]" aria-label="Рабочих на расчёт" />
                        <button type="button" class="btn btn-secondary btn-sm" disabled="@(!Screen.CanApplyWorkerCount(factory))" @onclick="() => Screen.ApplyWorkerCount(factory)">Применить</button>
                        @if (factory.DesiredWorkers != factory.Workers)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => Screen.CancelWorkerCount(factory)">Отменить</button>
                        }
                    </div>
                    var (workerDelta, workerCost) = Screen.WorkerCountChange(factory);
                    @* Наём растянут (docs/TODO.md №25), и без этой строки объявленные 20 против нанятых 5
                       выглядят как сбой: игрок обязан заранее видеть, сколько выйдет на смену уже в этот
                       ход, а сколько — потом. *@
                    @if (workerDelta > 0)
                    {
                        var hiredNow = Screen.HiresThisTurn(factory, workerDelta);
                        <p class="text-muted small mb-1">
                            При расчёте наймёт
                            @if (hiredNow < workerDelta)
                            {
                                <strong>@hiredNow из @workerDelta</strong>
                                <text> — стоимость @DashboardDisplay.FormatMoney(hiredNow * Screen.HireCostPerWorker).
                                Остальные @(workerDelta - hiredNow) выйдут на смену в следующие ходы, не больше
                                @Screen.MaxHiresPerTurn за ход; объявлять заново не нужно, платить — тоже, каждый ход
                                списывается только за тех, кто реально вышел.</text>
                            }
                            else
                            {
                                <text>ещё @workerDelta — стоимость @DashboardDisplay.FormatMoney(workerCost).</text>
                            }
                        </p>
                    }
                    else if (workerDelta < 0)
                    {
                        <p class="text-muted small mb-1">При расчёте уволит @(-workerDelta) — стоимость @DashboardDisplay.FormatMoney(workerCost). Увольнение исполняется целиком за один ход.</p>
                    }
                    <p class="text-muted small mb-0">
                        Объявление бесплатно и можно менять сколько угодно раз — спишется один раз, при расчёте
                        хода, по итоговой разнице. Нанять одного: @DashboardDisplay.FormatMoney(Screen.HireCostPerWorker) ·
                        уволить одного: @DashboardDisplay.FormatMoney(Screen.FireCostPerWorker).
                        @if (factory.InstantHiring)
                        {
                            <text>Это добыча — здесь бригада выходит на смену сразу, сколько ни объяви.</text>
                        }
                        else
                        {
                            <text>Людей на передел набирают постепенно: не больше @Screen.MaxHiresPerTurn человек за ход.
                            Уволить можно всех сразу и в тот же ход — но каждый уволенный дороже нанятого.</text>
                        }
                    </p>
                }
                else
                {
                    <p class="mb-0">
                        Рабочих: @factory.Workers
                        @if (factory.DesiredWorkers != factory.Workers)
                        {
                            <text> (объявлено на расчёт: @factory.DesiredWorkers)</text>
                        }
                    </p>
                }
            </section>

            <section class="lever" id="factory-wear">
                <h3 class="h6">Износ</h3>
                @if (factory.IsUnderRepair)
                {
                    <p class="text-danger mb-0">
                        Фабрика на простое: осталось @DashboardDisplay.Turns(factory.RepairTurnsRemaining).
                        Выпуск, зарплата и содержание — по тарифу, зафиксированному при начале этого простоя.
                    </p>
                }
                else
                {
                    <p class="mb-1">
                        Состояние: @((factory.Condition * 100).ToString("0.#"))%
                        @if (factory.UpkeepPenaltyMultiplier > 1m)
                        {
                            <text>— штраф к содержанию: ×@factory.UpkeepPenaltyMultiplier.ToString("0.##")</text>
                        }
                    </p>
                    @if (factory.Condition >= 1m)
                    {
                        <p class="text-success small mb-0"><em>Фабрика в идеальном состоянии — капремонт не нужен.</em></p>
                    }
                    else if (factory.OverhaulRequested)
                    {
                        <p class="text-muted small mb-1">
                            Капремонт в приказе на ход — сработает при ближайшем расчёте (ступень «@factory.OverhaulTierName»,
                            @factory.OverhaulTierCost.ToString("0.##") ¤, простой @DashboardDisplay.Turns(factory.OverhaulTierDurationTurns),
                            выпуск ×@factory.OverhaulTierOutputMultiplier.ToString("0.##") на это время).
                        </p>
                        @if (Screen.CanManage)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Screen.CancelOverhaulRequest(factory.FactoryId)">Отменить капремонт</button>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-1">
                            Капремонт сейчас — ступень «@factory.OverhaulTierName»: @factory.OverhaulTierCost.ToString("0.##") ¤,
                            простой @DashboardDisplay.Turns(factory.OverhaulTierDurationTurns), на это время выпуск
                            ×@factory.OverhaulTierOutputMultiplier.ToString("0.##"). Тяжесть зависит от того, насколько
                            фабрика изношена именно сейчас — чем раньше решение, тем дешевле и короче простой.
                        </p>
                        @if (Screen.CanManage)
                        {
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.RequestOverhaul(factory.FactoryId)">Капремонт в приказ на ход</button>
                        }
                    }
                }
            </section>

            <section class="lever" id="factory-rnd">
                <h3 class="h6">R&amp;D фабрики</h3>
                <p class="mb-1">
                    Очки: @factory.RndPoints.ToString("0.##")
                    @if (factory.NextLevelThreshold is { } threshold)
                    {
                        <text>из @threshold.ToString("0.##") до ступени @(factory.Level + 1)</text>
                    }
                    else
                    {
                        <text>(последняя ступень)</text>
                    }
                    <span class="text-muted small">· вложено всего @factory.RndInvestment.ToString("0.##") ¤</span>
                </p>
                @if (factory.NextLevelThreshold is null)
                {
                    <p class="text-success small mb-0"><em>Последняя ступень уже достигнута — вкладывать больше некуда, деньги не списываются.</em></p>
                }
                else
                {
                    <p class="mb-1">Выделяется: @factory.RndCommitmentPerTurn.ToString("0.##") ¤/ход</p>
                    @if (Screen.CanManage)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <input type="number" min="0" max="@Screen.MaxRndCommitmentPerTurn" step="0.01" class="form-control form-control-sm" style="width:7em"
                                   @bind="Screen.RndCommitmentAmounts[factory.FactoryId]" aria-label="Вложение в R&D, ¤ за ход" />
                            <span class="small">¤/ход</span>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.SetRndCommitment(factory.FactoryId)">Изменить</button>
                        </div>
                        <p class="text-muted small mb-0">
                            Списывается автоматически каждый ход, до @Screen.MaxRndCommitmentPerTurn.ToString("0.##") ¤/ход на одну
                            фабрику. Отдача от вложенных денег нелинейная — растянуть по ходам выгоднее, чем внести
                            всё сразу одним крупным платежом.
                        </p>
                    }
                }
            </section>

            <section class="lever" id="factory-recipe">
                <h3 class="h6">Продукт и сырьё</h3>
                <p class="mb-1">Продукт: @factory.SelectedRecipeName</p>
                @if (Screen.CanManage && factory.RecipeOptions.Count > 1)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <select class="form-select form-select-sm w-auto mw-100" @bind="Screen.SelectedRecipeIds[factory.FactoryId]" aria-label="Продукт фабрики">
                            @foreach (var recipe in factory.RecipeOptions)
                            {
                                <option value="@recipe.Id">@recipe.Name</option>
                            }
                        </select>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.SelectRecipe(factory.FactoryId)">Сменить продукт</button>
                    </div>
                }
                @if (factory.Inputs.Count == 0)
                {
                    <p class="text-muted small mb-0">Сырья не нужно — это добыча.</p>
                }
                else
                {
                    <ul class="list-unstyled small mb-1">
                        @foreach (var input in factory.Inputs)
                        {
                            <li>
                                @input.Material.Name: на складе @Screen.TeamWarehouseByMaterialId.GetValueOrDefault(input.Material.Id).ToString("0.##")
                                <span class="text-muted">· на единицу продукта @input.Quantity.ToString("0.##")</span>
                            </li>
                        }
                    </ul>
                }
                @if (Screen.SharesInputWithOtherFactories(factory))
                {
                    @* Доля играет роль, только если сырьё нужно больше чем одной вашей фабрике (макет
                       factory.html): у одиночной фабрики поле только сбивало с толку. *@
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        <span class="small">Доля при нехватке сырья:</span>
                        @if (Screen.CanManage)
                        {
                            <input type="number" min="0" step="1" class="form-control form-control-sm" style="width:6em" @bind="Screen.AllocationShares[factory.FactoryId]" aria-label="Доля при нехватке сырья" />
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.SetAllocationShare(factory.FactoryId)">Задать долю</button>
                        }
                        else
                        {
                            <span class="small">@factory.AllocationShare.ToString("0.##")</span>
                        }
                    </div>
                    <p class="text-muted small mb-0 mt-1">
                        Это сырьё нужно и другим вашим фабрикам. Если его не хватит на всех, оно делится
                        пропорционально долям.
                    </p>
                }
            </section>
        </div>

        <div class="min-w-0">
            <h2 class="h5">Подробнее</h2>

            <details class="lever" id="factory-destination" open="@(Anchor == "destination")">
                <summary>Куда идёт продукция</summary>
                <p class="text-muted small mt-2">
                    Отдельно направить продукцию некуда — весь выход зачисляется на общий склад команды.
                    Оттуда его в следующий ход сама забирает любая ваша фабрика, которой этот материал нужен
                    как сырьё. Остаток можно продать системе из «Производства» или по контракту в «Сделках».
                </p>
                @if (factory.ConsumingFactoryNames.Count > 0)
                {
                    <p class="mb-0">Сейчас это потребляют: @string.Join(", ", factory.ConsumingFactoryNames).</p>
                }
                else
                {
                    <p class="mb-0"><em>Ни одна ваша фабрика не использует это как сырьё — весь выход остаётся на складе.</em></p>
                }
            </details>

            <details class="lever" id="factory-profitability" open="@(Anchor == "profitability")">
                <summary>Экономика за ход</summary>
                <ul class="list-unstyled small mt-2">
                    <li>
                        Рабочие: @factory.CapacityBreakdown.Workers → эффективная мощность @factory.CapacityBreakdown.EffectiveCapacity.ToString("0.##")
                        @if (factory.CapacityBreakdown.Workers > Screen.BaseWorkerCount)
                        {
                            <span class="text-muted">(после @Screen.BaseWorkerCount рабочих — с убывающей отдачей)</span>
                        }
                    </li>
                    <li>Ступень R&amp;D: @factory.CapacityBreakdown.Level → бонус к скорости ×@factory.CapacityBreakdown.LevelBonus.ToString("0.##")</li>
                    <li>Скорость рецепта: ×@factory.CapacityBreakdown.RecipeProductionRate.ToString("0.##")</li>
                    <li><strong>Потолок: @factory.CapacityBreakdown.TheoreticalMaxOutput.ToString("0.##") за ход, если бы сырья хватало на всё.</strong></li>
                </ul>
                @if (factory.Profitability is { } profitability)
                {
                    var isLimitedByStock = profitability.ProjectedOutputQuantity < profitability.CapacityLimitedOutputQuantity;
                    <div class="table-responsive">
                        <table class="table table-sm align-middle small">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Сейчас</th>
                                    <th>Максимум@(isLimitedByStock ? "" : " (=сейчас)")</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Выпуск</td>
                                    <td>@profitability.ProjectedOutputQuantity.ToString("0.##")</td>
                                    <td>@profitability.CapacityLimitedOutputQuantity.ToString("0.##")</td>
                                </tr>
                                <tr>
                                    <td>Выручка по рыночной цене</td>
                                    <td>@DashboardDisplay.FormatMoney(profitability.Revenue)</td>
                                    <td>@DashboardDisplay.FormatMoney(profitability.MaxRevenue)</td>
                                </tr>
                                <tr>
                                    <td>Сырьё по реальной себестоимости</td>
                                    <td>@DashboardDisplay.FormatMoney(profitability.InputCost)</td>
                                    <td>@DashboardDisplay.FormatMoney(profitability.MaxInputCost)</td>
                                </tr>
                                @foreach (var line in profitability.InputBreakdown)
                                {
                                    <tr class="text-muted">
                                        <td class="ps-3">@line.Material.Name: @line.Quantity.ToString("0.##") × @DashboardDisplay.FormatUnitCost(line.UnitCost)</td>
                                        <td colspan="2">@DashboardDisplay.FormatMoney(line.Cost)</td>
                                    </tr>
                                }
                                <tr>
                                    <td>Зарплата</td>
                                    <td colspan="2">@DashboardDisplay.FormatMoney(profitability.WageCost)</td>
                                </tr>
                                <tr>
                                    <td>Содержание и энергия</td>
                                    <td>@DashboardDisplay.FormatMoney(profitability.OverheadCost)</td>
                                    <td>@DashboardDisplay.FormatMoney(profitability.MaxOverheadCost)</td>
                                </tr>
                                <tr>
                                    <td>Себестоимость единицы</td>
                                    <td>@DashboardDisplay.FormatUnitCost(profitability.UnitCost)</td>
                                    <td>@DashboardDisplay.FormatUnitCost(profitability.MaxUnitCost)</td>
                                </tr>
                                <tr class="border-top">
                                    <td><strong>Прибыль</strong></td>
                                    <td><strong class="@(profitability.Profit >= 0 ? "text-success" : "text-danger")">@DashboardDisplay.FormatMoney(profitability.Profit)</strong></td>
                                    <td><strong class="@(profitability.MaxProfit >= 0 ? "text-success" : "text-danger")">@DashboardDisplay.FormatMoney(profitability.MaxProfit)</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    @if (isLimitedByStock)
                    {
                        <p class="text-danger small mb-1"><em>Выпуск ограничен нехваткой сырья на складе — «Максимум» показывает, сколько получилось бы заработать при полном сырье.</em></p>
                    }
                    <p class="text-muted small mb-0"><em>Оценка по текущим остаткам склада и рыночным ценам — не гарантированный факт на конец хода.</em></p>
                }
                else
                {
                    <p class="small mb-0"><em>Экономику пока не посчитать — нет рыночных котировок.</em></p>
                }
            </details>

            <details class="lever" id="factory-pyramid" open="@(Anchor == "pyramid")">
                <summary>Себестоимость по всей цепочке</summary>
                <p class="text-muted small mt-2">
                    Не то, во что реально обошлась партия сейчас, а сколько стоила бы единица, если бы всю
                    цепочку — от этого материала до сырья в самом низу — покупали на рынке с нуля, без труда рабочих.
                </p>
                @if (factory.HasUnitCost)
                {
                    <p class="mb-1">Себестоимость единицы с нуля: @DashboardDisplay.FormatUnitCost(factory.UnitCost)</p>
                    <ul class="small mb-0">
                        @foreach (var row in factory.Pyramid)
                        {
                            <li style="margin-left:@(row.Depth * 1.5)em">@row.Material.Name: @row.Quantity.ToString("0.##")</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="small mb-0"><em>Пока не посчитать — нет рыночных котировок сырья.</em></p>
                }
            </details>

            <details class="lever" id="factory-charts" open="@(Anchor == "charts")">
                <summary>Графики и история по ходам</summary>
                @if (Screen.History is null)
                {
                    <p class="mt-2 mb-0"><em>Графики появятся после первого хода сессии.</em></p>
                }
                else
                {
                    <h4 class="h6 mt-2">Остатки на складе по всей пирамиде сырья</h4>
                    @ChartRenderer.Render(Screen.BuildStockChartLayout(factory))
                    <h4 class="h6 mt-3">Выпуск по ходам</h4>
                    @ChartRenderer.Render(Screen.BuildOutputChartLayout(factory))
                    @if (factory.ActivityHistory.Count > 0)
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-striped table-sm align-middle small">
                                <thead>
                                    <tr>
                                        <th>Ход</th>
                                        <th>Потреблено со склада</th>
                                        <th>Произведено</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in factory.ActivityHistory.AsEnumerable().Reverse())
                                    {
                                        <tr>
                                            <td>@row.Turn</td>
                                            <td>@row.ConsumedSummary</td>
                                            <td>@row.OutputQuantity.ToString("0.##")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </details>

            @if (Screen.CanManage)
            {
                @* Продажа — внизу, а не в заголовке: на телефоне кнопка стояла между названием и вкладками. *@
                <section class="lever" id="factory-sale">
                    <h3 class="h6">Продажа фабрики</h3>
                    @if (Screen.FactoryPendingSaleId == factory.FactoryId)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="text-danger small">Точно продать? Это необратимо.</span>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="() => Sell(factory.FactoryId)">Да, продать за @DashboardDisplay.FormatMoney(factory.LiquidationValue)</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Screen.FactoryPendingSaleId = null">Отмена</button>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => Screen.FactoryPendingSaleId = factory.FactoryId">Продать за @DashboardDisplay.FormatMoney(factory.LiquidationValue)…</button>
                    }
                </section>
            }
        </div>
    </div>
}

@code {
    /// <summary>Рычаги, к которым ведут ссылки с <c>?tab=…</c>; всё остальное — просто верх страницы.</summary>
    private static readonly HashSet<string> KnownAnchors = new(StringComparer.Ordinal)
    {
        "workers", "wear", "rnd", "recipe", "destination", "profitability", "pyramid", "charts",
    };

    /// <summary>Модель экрана команды — общая для всех разделов, её держит оболочка страницы.</summary>
    [Parameter, EditorRequired]
    public TeamScreen Screen { get; set; } = default!;

    /// <summary>Фабрика из адреса; <c>null</c> — адрес не разобрался как идентификатор.</summary>
    [Parameter]
    public Ulid? FactoryId { get; set; }

    /// <summary>Рычаг из адреса (<c>?tab=wear</c> и т. п.): к нему страница прокручивается, свёрнутый блок раскрывается.</summary>
    [Parameter]
    public string? Anchor { get; set; }

    private TeamScreen.FactoryRow? Factory => FactoryId is { } id ? Screen.FactoryById(id) : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Factory is not null && Anchor is { } anchor && KnownAnchors.Contains(anchor))
        {
            await JS.InvokeVoidAsync("teamScreen.scrollToElement", $"factory-{anchor}");
        }
    }

    /// <summary>Проданной фабрики больше нет — её страница пуста, поэтому после продажи возвращаемся к цепочке.</summary>
    private void Sell(Ulid factoryId)
    {
        Screen.SellFactory(factoryId);
        if (Screen.ErrorMessage is null)
        {
            Nav.NavigateTo("/team/production");
        }
    }
}
