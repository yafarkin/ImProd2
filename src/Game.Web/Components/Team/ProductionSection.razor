@inject IJSRuntime JS
@using Game.Config.Economy

@* Раздел «Производство» (docs/manager-ui/README.md §4). В блоке 1 сюда перенесены как есть бывшие
   вкладки «Фабрики», «Технологии» и «Склад»; цепочка со складом между переделами — блок 3. *@

<style>
    .card:target { outline: 3px solid #2a78d6; outline-offset: 2px; }
</style>

@* Временная навигация внутри раздела, пока «Производство» — три бывшие вкладки подряд (блок 1). Кнопки,
   а не <a href="#…">: голый фрагмент роутер Blazor резолвит относительно <base href> и уводит на главную. *@
<p class="small mb-2">
    Перейти:
    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick='() => Screen.PendingScrollTargetId = "technology"'>Технологии</button> ·
    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick='() => Screen.PendingScrollTargetId = "warehouse"'>Склад</button>
</p>

@if (Screen.Role != ParticipantRole.Manager)
{
    <p><em>Строить фабрики и нанимать рабочих может только управляющий — вы видите то же самое, что и он, в режиме чтения.</em></p>
}
else if (!Screen.IsDecisionPhase)
{
    <p><em>Решения недоступны — сейчас фаза «@Screen.PhaseLabel». Дождитесь фазы «Решения».</em></p>
}
else
{
    <h3 id="decide-now">Построить фабрику</h3>
    @if (Screen.BuildableDefinitions.Count == 0)
    {
        <p><em>Все доступные типы фабрик сектора уже построены.</em></p>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <select class="form-select w-auto" @bind="Screen.SelectedFactoryDefinitionId">
                @foreach (var definition in Screen.BuildableDefinitions)
                {
                    <option value="@definition.Id">@definition.Name (постройка @DashboardDisplay.FormatMoney(definition.BuildCost), обслуживание @DashboardDisplay.FormatMoney(definition.FixedCostPerTurn)/ход)</option>
                }
            </select>
            <button type="button" class="btn btn-primary" @onclick="Screen.BuildFactory">Построить</button>
        </div>
        @if (!Screen.CanAffordSelectedBuild && Screen.SelectedBuildableDefinition is { } selectedForBuild)
        {
            <p class="text-muted mb-3">
                Баланс уйдёт в минус на @DashboardDisplay.FormatMoney(selectedForBuild.BuildCost - Screen.Balance) — это не проблема, просто число.
            </p>
        }
    }
}

<h3 class="mt-4">Фабрики</h3>
@if (Screen.Factories.Count == 0 && Screen.BuildableDefinitions.Count == 0)
{
    <p><em>В этом секторе нет ни одной фабрики.</em></p>
}
else
{
    <p class="text-muted">
        Сверху вниз — по уровню сырьевой пирамиды. Сплошная рамка — построенная фабрика (число
        справа — сколько единиц реально произведено в прошлый ход, в скобках — насколько это
        меньше потолка по рабочим/уровню), пунктирная — «построить ещё» этого типа (есть всегда,
        даже если экземпляры уже есть). Красная рамка — этой фабрике в прошлый ход не хватило
        сырья на общем складе команды, чтобы выйти на полную мощность. Клик по построенной —
        открывает карточку с деталями, по пунктирной — выбирает тип в форме постройки выше.
    </p>
    int? lastLevel = null;
    <div class="d-flex flex-column gap-2">
        @foreach (var node in Screen.FactoryOverviewRows)
        {
            var level = node.Definition.Recipes[0].Output.Level;
            @if (level != lastLevel)
            {
                <div class="text-muted small text-uppercase mt-2">Уровень @level</div>
                lastLevel = level;
            }
            @if (node.Instance is { } instance)
            {
                var isSelected = instance.Id == Screen.SelectedFactoryId;
                var shortOfInput = node.Status == FactoryOverviewList.LoadStatus.ShortOfInput;
                var loadColor = shortOfInput ? "#dc3545" : "#198754";
                var title = node.IndexWithinType > 1 ? $"{instance.Definition.Name} №{node.IndexWithinType}" : instance.Definition.Name;
                var subtitle = shortOfInput
                    ? $"рабочих: {instance.Workers} · нехватка сырья"
                    : $"рабочих: {instance.Workers} · {instance.SelectedRecipe.Output.Name}";
                var outputText = node.LastTurnOutput is { } lastOutput
                    ? (node.TheoreticalMaxOutput is { } max && lastOutput < max
                        ? $"{lastOutput:0.##} (не хватило {(max - lastOutput):0.##} до {max:0.##})"
                        : $"{lastOutput:0.##}")
                    : "ещё нет данных";
                <div class="border rounded p-2 d-flex justify-content-between align-items-center gap-2"
                     style="cursor:pointer; border-color:@loadColor; border-width:@(isSelected ? "3px" : "1.5px"); background:@(loadColor)1f;"
                     @onclick="() => OpenFactoryCard(instance.Id)">
                    <div>
                        <div style="font-weight:600">@title</div>
                        <div class="text-muted small">@subtitle</div>
                    </div>
                    <div class="text-end small flex-shrink-0" style="font-weight:600; color:@loadColor">@outputText</div>
                </div>
            }
            else if (level > Screen.UnlockedGeneration)
            {
                <div class="border rounded p-2" style="border-style:dashed; border-color:#898781; opacity:0.7">
                    <div style="font-weight:600">@node.Definition.Name</div>
                    <div class="text-muted small">🔒 требует технологию поколения @level — см. «Технологии» ниже</div>
                </div>
            }
            else
            {
                var alreadyBuilt = Screen.FactoryOverviewRows.Any(n => n.Definition.Id == node.Definition.Id && n.Instance is not null);
                var buildCost = Screen.BuildCosts.GetValueOrDefault(node.Definition.Id);
                var upkeepCost = Screen.UpkeepCosts.GetValueOrDefault(node.Definition.Id);
                var caption = (alreadyBuilt ? "построить ещё · от " : "не построена · от ") + DashboardDisplay.FormatMoney(buildCost)
                              + " + " + DashboardDisplay.FormatMoney(upkeepCost) + "/ход";
                <div class="border rounded p-2"
                     style="cursor:pointer; border-style:dashed; border-color:#898781;"
                     @onclick="() => SelectBuildable(node.Definition.Id)">
                    <div style="font-weight:600">@node.Definition.Name</div>
                    <div class="text-muted small">@caption</div>
                </div>
            }
        }
    </div>

    @if (Screen.History is { ProfitByLevel.Count: > 0 })
    {
        <h4 class="h6 mt-3">Прибыльность по уровням пирамиды (вся команда)</h4>
        @ChartRenderer.Render(Screen.BuildProfitByLevelChartLayout())
    }

    @if (Screen.SelectedFactory is { } factory)
    {
        <div class="card mb-3" id="@($"factory-card-{factory.FactoryId}")">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <p class="mb-0"><strong>@factory.DefinitionName</strong> — уровень @factory.Level</p>
                    @if (Screen.CanManage)
                    {
                        @if (Screen.FactoryPendingSaleId == factory.FactoryId)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-danger small">Точно продать? Это необратимо.</span>
                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => Screen.SellFactory(factory.FactoryId)">Да, продать за @DashboardDisplay.FormatMoney(factory.LiquidationValue)</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Screen.FactoryPendingSaleId = null">Отмена</button>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => Screen.FactoryPendingSaleId = factory.FactoryId">Продать за @DashboardDisplay.FormatMoney(factory.LiquidationValue)</button>
                        }
                    }
                </div>

                @* Тот же перенос и по той же причине, что у вкладок страницы выше. *@
                <ul class="nav nav-pills flex-wrap gap-1 mb-3">
                    <li class="nav-item"><button type="button" class="nav-link @Screen.TabClass("workers")" @onclick='() => Screen.ActiveFactoryTab = "workers"'>Люди</button></li>
                    <li class="nav-item"><button type="button" class="nav-link @Screen.TabClass("recipe")" @onclick='() => Screen.ActiveFactoryTab = "recipe"'>Рецепт и склад</button></li>
                    <li class="nav-item"><button type="button" class="nav-link @Screen.TabClass("rnd")" @onclick='() => Screen.ActiveFactoryTab = "rnd"'>R&amp;D</button></li>
                    <li class="nav-item"><button type="button" class="nav-link @Screen.TabClass("wear")" @onclick='() => Screen.ActiveFactoryTab = "wear"'>Износ</button></li>
                    <li class="nav-item"><button type="button" class="nav-link @Screen.TabClass("destination")" @onclick='() => Screen.ActiveFactoryTab = "destination"'>Куда идёт продукция</button></li>
                    <li class="nav-item"><button type="button" class="nav-link @Screen.TabClass("profitability")" @onclick='() => Screen.ActiveFactoryTab = "profitability"'>Финансы</button></li>
                    <li class="nav-item"><button type="button" class="nav-link @Screen.TabClass("charts")" @onclick='() => Screen.ActiveFactoryTab = "charts"'>Графики</button></li>
                </ul>

                @if (Screen.ActiveFactoryTab == "workers")
                {
                    @if (Screen.CanManage)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="text-muted">Сейчас: @factory.Workers · объявлено на расчёт: @factory.DesiredWorkers</span>
                            <input type="number" min="0" step="1" class="form-control d-inline-block" style="width:6em" @bind="Screen.TargetWorkerCounts[factory.FactoryId]" />
                            <button type="button" class="btn btn-secondary" disabled="@(!Screen.CanApplyWorkerCount(factory))" @onclick="() => Screen.ApplyWorkerCount(factory)">Применить</button>
                            @if (factory.DesiredWorkers != factory.Workers)
                            {
                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => Screen.CancelWorkerCount(factory)">Отменить</button>
                            }
                        </div>
                        var (workerDelta, workerCost) = Screen.WorkerCountChange(factory);
                        @* Наём растянут (docs/TODO.md №25), и без этой строки объявленные 20 против
                           нанятых 5 выглядят как сбой: игрок обязан заранее видеть, сколько выйдет
                           на смену уже в этот ход, а сколько — потом. *@
                        @if (workerDelta > 0)
                        {
                            var hiredNow = Screen.HiresThisTurn(factory, workerDelta);
                            <p class="text-muted small">
                                При расчёте наймёт
                                @if (hiredNow < workerDelta)
                                {
                                    <strong>@hiredNow из @workerDelta</strong>
                                    <text> — стоимость @DashboardDisplay.FormatMoney(hiredNow * Screen.HireCostPerWorker).
                                    Остальные @(workerDelta - hiredNow) выйдут на смену в следующие ходы, не больше
                                    @Screen.MaxHiresPerTurn за ход; объявлять заново не нужно, платить — тоже, каждый ход
                                    списывается только за тех, кто реально вышел.</text>
                                }
                                else
                                {
                                    <text>ещё @workerDelta — стоимость @DashboardDisplay.FormatMoney(workerCost).</text>
                                }
                            </p>
                        }
                        else if (workerDelta < 0)
                        {
                            <p class="text-muted small">При расчёте уволит @(-workerDelta) — стоимость @DashboardDisplay.FormatMoney(workerCost). Увольнение исполняется целиком за один ход.</p>
                        }
                        <p class="text-muted small mb-2">
                            Объявление бесплатно и можно менять сколько угодно раз — спишется один раз, при
                            расчёте хода, по итоговой разнице. Нанять одного: @DashboardDisplay.FormatMoney(Screen.HireCostPerWorker) ·
                            уволить одного: @DashboardDisplay.FormatMoney(Screen.FireCostPerWorker)
                        </p>
                        <p class="text-muted small mb-2">
                            @if (factory.InstantHiring)
                            {
                                <text>Это добыча — здесь бригада выходит на смену сразу, сколько ни объяви.</text>
                            }
                            else
                            {
                                <text>
                                    Людей на передел набирают постепенно: не больше @Screen.MaxHiresPerTurn человек за ход.
                                    Уволить можно всех сразу и в тот же ход — но каждый уволенный дороже нанятого.
                                </text>
                            }
                        </p>
                        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                            <label class="small text-muted mb-0">Доля при дефиците общего сырья:</label>
                            <input type="number" min="0" step="1" class="form-control d-inline-block" style="width:6em" @bind="Screen.AllocationShares[factory.FactoryId]" />
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.SetAllocationShare(factory.FactoryId)">Задать долю</button>
                        </div>
                        <p class="text-muted small mt-1">
                            <em>Доля играет роль, только если это сырьё нужно больше чем одной вашей фабрике и его не хватает на всех — например, две фабрики одного типа.</em>
                        </p>
                    }
                    else
                    {
                        <p>
                            Рабочих: @factory.Workers
                            @if (factory.DesiredWorkers != factory.Workers)
                            {
                                <text> (объявлено на расчёт: @factory.DesiredWorkers)</text>
                            }
                        </p>
                        <p class="text-muted small">Доля при дефиците общего сырья: @factory.AllocationShare.ToString("0.##")</p>
                    }
                }
                else if (Screen.ActiveFactoryTab == "recipe")
                {
                    <p>Продукт: @factory.SelectedRecipeName</p>
                    @if (Screen.CanManage && factory.RecipeOptions.Count > 1)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <select class="form-select w-auto" @bind="Screen.SelectedRecipeIds[factory.FactoryId]">
                                @foreach (var recipe in factory.RecipeOptions)
                                {
                                    <option value="@recipe.Id">@recipe.Name</option>
                                }
                            </select>
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.SelectRecipe(factory.FactoryId)">Сменить продукт</button>
                        </div>
                    }
                    <h4 class="h6 mt-2">Склад команды (общий на все фабрики)</h4>
                    <ul class="list-unstyled">
                        <li>@factory.ProducedMaterial.Name (продукт этой фабрики): @Screen.TeamWarehouseByMaterialId.GetValueOrDefault(factory.ProducedMaterial.Id).ToString("0.##")</li>
                        @foreach (var input in factory.Inputs)
                        {
                            <li>@input.Material.Name (сырьё): @Screen.TeamWarehouseByMaterialId.GetValueOrDefault(input.Material.Id).ToString("0.##")</li>
                        }
                    </ul>
                }
                else if (Screen.ActiveFactoryTab == "rnd")
                {
                    <p>
                        Очки исследования: @factory.RndPoints.ToString("0.##")
                        @if (factory.NextLevelThreshold is { } threshold)
                        {
                            <text>из @threshold.ToString("0.##") (до следующего уровня)</text>
                        }
                        else
                        {
                            <text>(максимальный уровень)</text>
                        }
                    </p>
                    <p class="text-muted small">Вложено всего: @factory.RndInvestment.ToString("0.##") ¤</p>
                    @if (factory.NextLevelThreshold is null)
                    {
                        <p class="text-success small mb-2"><em>Максимальный уровень фабрики уже достигнут — вкладывать больше некуда, деньги не списываются.</em></p>
                    }
                    else
                    {
                        <p>
                            Сейчас выделяется: @factory.RndCommitmentPerTurn.ToString("0.##") ¤/ход
                        </p>
                        @if (Screen.CanManage)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <input type="number" min="0" max="@Screen.MaxRndCommitmentPerTurn" step="0.01" class="form-control d-inline-block" style="width:6em" @bind="Screen.RndCommitmentAmounts[factory.FactoryId]" />
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.SetRndCommitment(factory.FactoryId)">Изменить</button>
                            </div>
                            <p class="text-muted small mb-2">
                                Списывается автоматически каждый ход, до @Screen.MaxRndCommitmentPerTurn.ToString("0.##") ¤/ход на одну
                                фабрику. Отдача от вложенных денег нелинейная — растянуть по ходам выгоднее, чем внести
                                всё сразу одним крупным платежом.
                            </p>
                        }
                    }
                }
                else if (Screen.ActiveFactoryTab == "wear")
                {
                    @if (factory.IsUnderRepair)
                    {
                        <p class="text-danger">
                            Фабрика на простое: осталось @factory.RepairTurnsRemaining ход(ов).
                            Выпуск, зарплата и содержание — по тарифу, зафиксированному при начале этого простоя.
                        </p>
                    }
                    else
                    {
                        <p>
                            Состояние: @((factory.Condition * 100).ToString("0.#"))%
                            @if (factory.UpkeepPenaltyMultiplier > 1m)
                            {
                                <text>— штраф к содержанию: ×@factory.UpkeepPenaltyMultiplier.ToString("0.##")</text>
                            }
                        </p>
                        @if (factory.Condition >= 1m)
                        {
                            <p class="text-success small mb-2"><em>Фабрика в идеальном состоянии — капремонт не нужен.</em></p>
                        }
                        else if (factory.OverhaulRequested)
                        {
                            <p class="text-muted small mb-2">
                                Капремонт заказан — сработает при ближайшем расчёте (ступень «@factory.OverhaulTierName»,
                                @factory.OverhaulTierCost.ToString("0.##") ¤, простой @factory.OverhaulTierDurationTurns ход(ов),
                                выпуск ×@factory.OverhaulTierOutputMultiplier.ToString("0.##") на это время).
                            </p>
                            @if (Screen.CanManage)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Screen.CancelOverhaulRequest(factory.FactoryId)">Отменить запрос</button>
                            }
                        }
                        else
                        {
                            <p class="text-muted small mb-2">
                                Капремонт сейчас — ступень «@factory.OverhaulTierName»: @factory.OverhaulTierCost.ToString("0.##") ¤,
                                простой @factory.OverhaulTierDurationTurns ход(ов), на это время выпуск
                                ×@factory.OverhaulTierOutputMultiplier.ToString("0.##"). Тяжесть зависит от того, насколько
                                фабрика изношена именно сейчас — чем раньше решите, тем дешевле и короче простой.
                            </p>
                            @if (Screen.CanManage)
                            {
                                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.RequestOverhaul(factory.FactoryId)">Заказать капремонт</button>
                            }
                        }
                    }
                }
                else if (Screen.ActiveFactoryTab == "destination")
                {
                    <p class="text-muted">
                        Отдельно направить продукцию некуда — весь выход зачисляется на общий склад
                        команды. Оттуда его в следующий ход автоматически заберёт любая ваша фабрика,
                        которой этот материал нужен как сырьё; если сырья на всех не хватит — по доле
                        в разделе «Люди». Остаток можно продать системе («Склад» ниже) или по контракту (раздел
                        «Сделки»).
                    </p>
                    @if (factory.ConsumingFactoryNames.Count > 0)
                    {
                        <p>Сейчас это потребляют: @string.Join(", ", factory.ConsumingFactoryNames).</p>
                    }
                    else
                    {
                        <p><em>Пока ни одна из ваших фабрик не использует это как сырьё — весь выход идёт на продажу.</em></p>
                    }
                }
                else if (Screen.ActiveFactoryTab == "profitability")
                {
                    <h4 class="h6">Теоретический максимум (без учёта нехватки сырья)</h4>
                    <ul class="list-unstyled">
                        <li>
                            Рабочие: @factory.CapacityBreakdown.Workers → эффективная мощность @factory.CapacityBreakdown.EffectiveCapacity.ToString("0.##")
                            @if (factory.CapacityBreakdown.Workers > Screen.BaseWorkerCount)
                            {
                                <span class="text-muted">(после @Screen.BaseWorkerCount рабочих — с убывающей отдачей)</span>
                            }
                        </li>
                        <li>Уровень фабрики (R&amp;D): @factory.CapacityBreakdown.Level → бонус к скорости ×@factory.CapacityBreakdown.LevelBonus.ToString("0.##")</li>
                        <li>Скорость рецепта: ×@factory.CapacityBreakdown.RecipeProductionRate.ToString("0.##")</li>
                        <li>
                            <strong>Максимум: @factory.CapacityBreakdown.TheoreticalMaxOutput.ToString("0.##") @factory.ProducedMaterial.Name за ход, если бы сырья хватало на всё.</strong>
                        </li>
                    </ul>
                    @if (factory.Profitability is { } profitability)
                    {
                        var isLimitedByStock = profitability.ProjectedOutputQuantity < profitability.CapacityLimitedOutputQuantity;
                        <div class="table-responsive">
                            <table class="table table-striped table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Сейчас</th>
                                        <th>Максимум за ход@(isLimitedByStock ? "" : " (=сейчас, сырья хватает)")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Выпуск, @factory.ProducedMaterial.Name</td>
                                        <td>@profitability.ProjectedOutputQuantity.ToString("0.##")</td>
                                        <td>@profitability.CapacityLimitedOutputQuantity.ToString("0.##")</td>
                                    </tr>
                                    <tr>
                                        <td>Выручка (по рыночной цене продукта)</td>
                                        <td>@DashboardDisplay.FormatMoney(profitability.Revenue)</td>
                                        <td>@DashboardDisplay.FormatMoney(profitability.MaxRevenue)</td>
                                    </tr>
                                    <tr>
                                        <td>Затраты на сырьё (по реальной себестоимости)</td>
                                        <td>@DashboardDisplay.FormatMoney(profitability.InputCost)</td>
                                        <td>@DashboardDisplay.FormatMoney(profitability.MaxInputCost)</td>
                                    </tr>
                                    @if (profitability.InputBreakdown.Count > 0)
                                    {
                                        <tr>
                                            <td colspan="3" class="p-0 pb-2">
                                                <table class="table table-sm table-borderless mb-0 ms-3" style="width:auto">
                                                    <thead>
                                                        <tr class="text-muted small">
                                                            <th>Сырьё</th>
                                                            <th>Цена закупки за ед.</th>
                                                            <th>Куплено единиц (на этот ход)</th>
                                                            <th>Итого</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var line in profitability.InputBreakdown)
                                                        {
                                                            <tr class="small">
                                                                <td>@line.Material.Name</td>
                                                                <td>@DashboardDisplay.FormatUnitCost(line.UnitCost)</td>
                                                                <td>@line.Quantity.ToString("0.##")</td>
                                                                <td>@DashboardDisplay.FormatMoney(line.Cost)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    }
                                    <tr>
                                        <td>Зарплата рабочих</td>
                                        <td colspan="2">@DashboardDisplay.FormatMoney(profitability.WageCost)</td>
                                    </tr>
                                    <tr>
                                        <td>Содержание фабрики (аренда/охрана/амортизация + энергия)</td>
                                        <td>@DashboardDisplay.FormatMoney(profitability.OverheadCost)</td>
                                        <td>@DashboardDisplay.FormatMoney(profitability.MaxOverheadCost)</td>
                                    </tr>
                                    <tr>
                                        <td>Себестоимость единицы</td>
                                        <td>@DashboardDisplay.FormatUnitCost(profitability.UnitCost)</td>
                                        <td>@DashboardDisplay.FormatUnitCost(profitability.MaxUnitCost)</td>
                                    </tr>
                                    <tr>
                                        <td>Рыночная цена</td>
                                        <td colspan="2">@DashboardDisplay.FormatUnitCost(profitability.OutputPrice)</td>
                                    </tr>
                                    <tr class="border-top">
                                        <td><strong>Итог (прибыль)</strong></td>
                                        <td><strong class="@(profitability.Profit >= 0 ? "text-success" : "text-danger")">@DashboardDisplay.FormatMoney(profitability.Profit)</strong></td>
                                        <td><strong class="@(profitability.MaxProfit >= 0 ? "text-success" : "text-danger")">@DashboardDisplay.FormatMoney(profitability.MaxProfit)</strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        @if (isLimitedByStock)
                        {
                            <p class="text-danger mb-1"><em>Выпуск ограничен нехваткой сырья на складе — колонка «Максимум за ход» показывает, сколько получилось бы заработать, если бы сырья хватало на весь потолок мощности фабрики.</em></p>
                        }
                        <p class="text-muted"><em>Оценка по текущим остаткам склада и рыночным ценам — не гарантирован факт на конец хода.</em></p>
                    }
                    else
                    {
                        <p><em>Прибыльность пока не посчитать — нет рыночных котировок.</em></p>
                    }

                    <h4 class="h6 mt-4">Теоретическая себестоимость с нуля (по всей цепочке сырья)</h4>
                    <p class="text-muted small">
                        <em>Другая оценка, чем «Себестоимость единицы» выше: не то, что реально стоило произвести эту
                        партию сейчас, а то, сколько стоила бы единица, если бы всю цепочку — от этого материала до
                        сырья в самом низу — покупали на рынке с нуля, без труда рабочих.</em>
                    </p>
                    @if (factory.HasUnitCost)
                    {
                        <p>Теоретическая себестоимость единицы: @DashboardDisplay.FormatUnitCost(factory.UnitCost)</p>
                        <ul>
                            @foreach (var row in factory.Pyramid)
                            {
                                <li style="margin-left:@(row.Depth * 1.5)em">@row.Material.Name: @row.Quantity.ToString("0.##")</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p><em>Теоретическая себестоимость пока не посчитать — нет рыночных котировок сырья.</em></p>
                    }
                }
                else if (Screen.ActiveFactoryTab == "charts")
                {
                    @if (Screen.History is null)
                    {
                        <p><em>Графики появятся после первого хода сессии.</em></p>
                    }
                    else
                    {
                        <h4 class="h6">Остатки на складе по всей пирамиде сырья</h4>
                        @Screen.RenderStockChart(factory)
                        <h4 class="h6 mt-3">Объём выпуска по ходам</h4>
                        @Screen.RenderOutputChart(factory)

                        <h4 class="h6 mt-3">История по ходам (таблица)</h4>
                        @if (factory.ActivityHistory.Count == 0)
                        {
                            <p><em>Данных пока нет — появятся после первого производства.</em></p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>Ход</th>
                                            <th>Потреблено со склада</th>
                                            <th>Произведено (@factory.ProducedMaterial.Name)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in factory.ActivityHistory.AsEnumerable().Reverse())
                                        {
                                            <tr>
                                                <td>@row.Turn</td>
                                                <td>@row.ConsumedSummary</td>
                                                <td>@row.OutputQuantity.ToString("0.##")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
}

<h3 id="technology" class="mt-4">Технологии</h3>
<p class="text-muted">
    Более глубокие переделы пирамиды сырья открываются не сразу, а через отдельное командное
    исследование — общий счётчик на всю команду, не по фабрикам.
</p>
<p>
    Разблокировано поколение: <strong>@Screen.UnlockedGeneration</strong>
    @if (Screen.NextGenerationThreshold is { } nextThreshold)
    {
        <text>(накоплено очков исследований: @Screen.GenerationResearchPoints.ToString("0.##") из @nextThreshold.ToString("0.##"))</text>
    }
    else
    {
        <text>(максимальное поколение)</text>
    }
</p>
<p>Вложено всего: @Screen.GenerationResearchInvestment.ToString("0.##") ¤</p>
@if (Screen.NextGenerationThreshold is null)
{
    <p class="text-success small"><em>Максимальное поколение уже разблокировано — вкладывать больше некуда, деньги не списываются.</em></p>
}
else
{
    <p>Сейчас выделяется: @Screen.GenerationResearchCommitmentPerTurn.ToString("0.##") ¤/ход</p>
    @if (Screen.CanManage)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <input type="number" min="0" max="@Screen.MaxGenerationResearchCommitmentPerTurn" step="0.01" class="form-control d-inline-block" style="width:6em" @bind="Screen.GenerationResearchCommitmentInput" />
            <button type="button" class="btn btn-secondary btn-sm" @onclick="Screen.SetGenerationResearchCommitment">Изменить</button>
        </div>
        <p class="text-muted small">
            Списывается автоматически каждый ход, до @Screen.MaxGenerationResearchCommitmentPerTurn.ToString("0.##") ¤/ход
            на команду. Отдача от вложенных денег нелинейная — растянуть по ходам выгоднее, чем внести
            всё сразу одним крупным платежом.
        </p>
    }
}

<h3 id="warehouse" class="mt-4">Склад</h3>
<p>
    Занято: @Screen.UsedCapacity.ToString("0.##") / @Screen.FreeCapacity.ToString("0.##") (бесплатный лимит)
    @if (Screen.ProjectedWarehouseFee > 0)
    {
        <text> — превышение лимита; на следующем ходу спишется @DashboardDisplay.FormatMoney(Screen.ProjectedWarehouseFee)</text>
    }
</p>
@if (Screen.Stock.Count == 0)
{
    <p><em>Склад пуст.</em></p>
}
else
{
    @foreach (var row in Screen.Stock)
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <span>@row.MaterialName: @row.Quantity.ToString("0.##")</span>
            @if (Screen.CanManage)
            {
                <input type="number" min="0" step="1" class="form-control d-inline-block" style="width:6em" @bind="Screen.SellVolumes[row.MaterialId]" @bind:event="oninput" />
                <button type="button" class="btn btn-secondary btn-sm" @onclick="() => Screen.SellToSystem(row.MaterialId)">Продать системе</button>
                @if (Screen.PendingSaleVolumeByMaterial.GetValueOrDefault(row.MaterialId) > 0)
                {
                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => Screen.CancelSaleToSystem(row.MaterialId)">Отменить</button>
                }
            }
        </div>
        @if (Screen.CanManage)
        {
            @if (Screen.PendingSaleVolumeByMaterial.GetValueOrDefault(row.MaterialId) is var pendingSale && pendingSale > 0)
            {
                <p class="text-muted small mb-1">Заявлено на расчёт: @pendingSale.ToString("0.##") — спишется со склада и зачислится на баланс на следующем расчёте.</p>
            }
            var preview = Screen.SellPreview(row);
            <p class="text-muted small mb-2">
                @if (preview.HasQuote)
                {
                    <text>Цена за единицу: @DashboardDisplay.FormatUnitCost(preview.UnitPrice)</text>
                    @if (preview.PriceImpactRate >= MarketSalePreview.NoticeablePriceImpactRate)
                    {
                        <text> (без вашей заявки — @DashboardDisplay.FormatUnitCost(preview.MarginalUnitPrice); этот объём просаживает цену на @preview.PriceImpactRate.ToString("P0"))</text>
                    }
                    @if (preview.OverflowVolume > 0)
                    {
                        <text> · из них @preview.OverflowVolume.ToString("0.##") сверх ёмкости рынка — рынок по этому материалу уже насыщен</text>
                    }
                    <text> · доход: @DashboardDisplay.FormatMoney(preview.Revenue)</text>
                    <text> · прибыль: </text>
                    <strong class="@(preview.Profit >= 0 ? "text-success" : "text-danger")">@DashboardDisplay.FormatMoney(preview.Profit)</strong>
                }
                else
                {
                    <em>Нет рыночной котировки — продажу и доход по этому материалу оценить пока нельзя.</em>
                }
            </p>
        }
    }
}
@if (Screen.CanManage && Screen.EmergencyPurchaseEnabled && Screen.EmergencyPurchaseMaterials.Count > 0)
{
    <h4>Аварийная закупка</h4>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <select class="form-select w-auto" @bind="Screen.EmergencyPurchaseMaterialId">
            @foreach (var material in Screen.EmergencyPurchaseMaterials)
            {
                <option value="@material.Id">@material.Name</option>
            }
        </select>
        <input type="number" min="0" step="0.01" class="form-control d-inline-block" style="width:6em" @bind="Screen.EmergencyPurchaseVolume" />
        <button type="button" class="btn btn-secondary" @onclick="Screen.EmergencyPurchase">Купить</button>
        @if (Screen.EmergencyPurchaseMaterialId is not null && Screen.PendingEmergencyPurchaseVolumeByMaterial.GetValueOrDefault(Screen.EmergencyPurchaseMaterialId) > 0)
        {
            <button type="button" class="btn btn-link p-0" @onclick="Screen.CancelEmergencyPurchase">Отменить</button>
        }
    </div>
    @if (Screen.EmergencyPurchaseMaterialId is not null && Screen.PendingEmergencyPurchaseVolumeByMaterial.GetValueOrDefault(Screen.EmergencyPurchaseMaterialId) is var pendingPurchase && pendingPurchase > 0)
    {
        <p class="text-muted small mb-1">Заявлено на расчёт: @pendingPurchase.ToString("0.##") — товар и списание появятся на следующем расчёте.</p>
    }
    @if (Screen.EmergencyPurchaseCost > 0)
    {
        <p class="text-muted small">
            Стоимость: @DashboardDisplay.FormatMoney(Screen.EmergencyPurchaseCost)
            (множитель к рыночной цене: ×@Screen.EmergencyPurchaseEffectiveMultiplier.ToString("0.##") —
            растёт с недавними экстренными закупками этого материала вашей командой, затухает
            через несколько ходов без них)
        </p>
    }
    @if (!Screen.CanAffordEmergencyPurchase)
    {
        <p class="text-muted small mb-2">
            Баланс уйдёт в минус на @DashboardDisplay.FormatMoney(Screen.EmergencyPurchaseCost - Screen.Balance) — это не проблема, просто число.
        </p>
    }
}

<h4 class="mt-4">Остатки по ходам</h4>
@if (Screen.History is null)
{
    <p><em>График появится после первого хода сессии.</em></p>
}
else
{
    @ChartRenderer.Render(Screen.BuildWarehouseStockChartLayout())
}

@code {
    /// <summary>Модель экрана команды — общая для всех разделов, её держит оболочка страницы.</summary>
    [Parameter, EditorRequired]
    public TeamScreen Screen { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Screen.PendingScrollTargetId is { } targetId)
        {
            Screen.PendingScrollTargetId = null;
            await JS.InvokeVoidAsync("teamScreen.scrollToElement", targetId);
        }
    }

    /// <summary>Клик по построенной фабрике — открывает её карточку и прокручивает к ней: карточка лежит под всем списком, и без прокрутки клик на телефоне выглядел так, будто ничего не произошло.</summary>
    private void OpenFactoryCard(Ulid factoryId)
    {
        Screen.SelectFactory(factoryId);
        Screen.PendingScrollTargetId = $"factory-card-{factoryId}";
    }

    /// <summary>Клик по пунктирной «построить ещё» — тот же выбор, что и в форме «Построить фабрику», с прокруткой к ней.</summary>
    private void SelectBuildable(string definitionId)
    {
        Screen.SelectedFactoryDefinitionId = definitionId;
        Screen.PendingScrollTargetId = "decide-now";
    }
}
