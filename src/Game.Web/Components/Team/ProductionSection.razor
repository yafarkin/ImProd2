@inject IJSRuntime JS

@* Раздел «Производство» (docs/manager-ui/README.md §4, блок 3, макет mockups/production.html): цепочка
   по переделам со складом между ними. Передел — сворачиваемый блок со сводкой, внутри однотипные
   фабрики одной строкой «Рудник ×3», по тапу — экземпляры. Сама фабрика — отдельная страница
   /team/factory/{id}. Графики остатков и прибыли по переделам переехали в «Аналитику». *@

<div class="production-layout">
    <div class="min-w-0">
        <h2 class="h4">Цепочка производства <span class="text-muted fs-6 fw-normal">@DashboardDisplay.Factories(Chain.FactoryCount)</span></h2>

        @if (Screen.Role != ParticipantRole.Manager)
        {
            <p class="text-muted small"><em>Строить фабрики, нанимать рабочих и продавать может только управляющий — вы видите то же самое в режиме чтения.</em></p>
        }
        else if (!Screen.IsDecisionPhase)
        {
            <p class="text-muted small"><em>Решения недоступны — сейчас фаза «@Screen.PhaseLabel». Кнопки появятся в фазе «Решения».</em></p>
        }

        <div class="btn-group btn-group-sm mb-3" role="group" aria-label="Какие фабрики показать">
            <button type="button" class="btn @(_attentionOnly ? "btn-outline-primary" : "btn-primary")" @onclick="() => _attentionOnly = false">Все</button>
            <button type="button" class="btn @(_attentionOnly ? "btn-primary" : "btn-outline-primary")" @onclick="() => _attentionOnly = true">Требуют внимания · @Chain.ProblemCount</button>
        </div>

        @if (_attentionOnly)
        {
            @if (Chain.ProblemCount == 0)
            {
                <p class="text-muted">Сейчас ни одна фабрика не требует внимания.</p>
            }
            @foreach (var level in Chain.Levels.Where(l => l.ProblemCount > 0))
            {
                <h3 class="h6 text-muted mt-3">Передел @level.Number</h3>
                @foreach (var instance in level.Types.SelectMany(t => t.Instances).Where(i => i.Problems.Count > 0))
                {
                    <FactoryInstanceRow Instance="instance" />
                }
            }
        }
        else
        {
            @foreach (var level in Chain.Levels)
            {
                <details class="level border rounded mb-2" open="@level.OpenByDefault"
                         data-collapse-key="@($"{Screen.TeamId}:level:{level.Number}")" data-force-open="@(level.ProblemCount > 0 ? "true" : "false")">
                    <summary class="level-summary">
                        <span class="fw-semibold">Передел @level.Number</span>
                        <span class="small text-muted">
                            @ProductionChainDisplay.LevelSummary(level, Chain.HasLastTurn)
                            @if (level.ProblemCount > 0)
                            {
                                <span class="text-danger"> · требуют внимания: @level.ProblemCount</span>
                            }
                        </span>
                    </summary>
                    <div class="level-body">
                        @foreach (var type in level.Types.Where(t => t.Instances.Count > 0))
                        {
                            @if (type.Instances.Count == 1)
                            {
                                <FactoryInstanceRow Instance="type.Instances[0]" />
                            }
                            else
                            {
                                <details class="type-group" open="@(type.ProblemCount > 0)"
                                         data-collapse-key="@($"{Screen.TeamId}:type:{type.Definition.Id}")" data-force-open="@(type.ProblemCount > 0 ? "true" : "false")">
                                    <summary class="fac @(type.ProblemCount > 0 ? "fac-problem" : null)">
                                        <span class="min-w-0">
                                            <span class="d-block fw-semibold">@type.Definition.Name ×@type.Instances.Count</span>
                                            <span class="d-block small text-muted">@ProductionChainDisplay.TypeGroupSubtitle(type)</span>
                                        </span>
                                        <span class="text-end small fw-semibold flex-shrink-0">@ProductionChainDisplay.OutputText(Chain.HasLastTurn ? type.LastTurnOutput : null, type.MaxOutput)</span>
                                    </summary>
                                    <div class="ps-3">
                                        @foreach (var instance in type.Instances)
                                        {
                                            <FactoryInstanceRow Instance="instance" />
                                        }
                                    </div>
                                </details>
                            }
                        }

                        @if (Screen.CanManage)
                        {
                            <details class="build mt-2">
                                <summary class="fac fac-ghost">
                                    <span>+ Построить на переделе @level.Number</span>
                                    <span class="small text-muted">от @DashboardDisplay.FormatMoney(level.Types.Min(t => Screen.BuildCosts.GetValueOrDefault(t.Definition.Id)))</span>
                                </summary>
                                <div class="ps-2 pt-1">
                                    @foreach (var type in level.Types)
                                    {
                                        var buildCost = Screen.BuildCosts.GetValueOrDefault(type.Definition.Id);
                                        <div class="d-flex justify-content-between align-items-center gap-2 py-1">
                                            <span class="min-w-0">
                                                <span class="d-block">@type.Definition.Name @(type.Instances.Count > 0 ? $"(уже {type.Instances.Count})" : null)</span>
                                                <span class="d-block small text-muted">постройка @DashboardDisplay.FormatMoney(buildCost) · содержание @DashboardDisplay.FormatMoney(Screen.UpkeepCosts.GetValueOrDefault(type.Definition.Id))/ход</span>
                                                @if (buildCost > Screen.Balance)
                                                {
                                                    <span class="d-block small text-muted">Баланс уйдёт в минус на @DashboardDisplay.FormatMoney(buildCost - Screen.Balance) — это не проблема, просто число.</span>
                                                }
                                            </span>
                                            <button type="button" class="btn btn-primary btn-sm flex-shrink-0" @onclick="() => Build(type.Definition.Id)">Построить</button>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                        else if (level.FactoryCount == 0)
                        {
                            <p class="small text-muted mb-0">Не построено: @string.Join(", ", level.Types.Select(t => t.Definition.Name)).</p>
                        }

                        @if (level.StockLines.Count > 0)
                        {
                            <div class="stock-band mt-2">
                                <div class="small text-uppercase text-muted mb-1">Склад после передела @level.Number</div>
                                @foreach (var line in level.StockLines)
                                {
                                    <StockLineRow Screen="Screen" Line="line" />
                                }
                            </div>
                        }
                    </div>
                </details>
            }

            @if (Chain.Locked is { } locked)
            {
                <GenerationLock Screen="Screen" Locked="locked" />
            }

            @if (Chain.OtherStock.Count > 0)
            {
                <div class="stock-band mt-3">
                    <div class="small text-uppercase text-muted mb-1">Прочее на складе</div>
                    <p class="small text-muted mb-1">Этого не производит ни одна фабрика вашего сектора: куплено по контракту или аварийной закупкой.</p>
                    @foreach (var line in Chain.OtherStock)
                    {
                        <StockLineRow Screen="Screen" Line="line" />
                    }
                </div>
            }
        }
    </div>

    <aside class="min-w-0">
        <section class="mb-3">
            <h3 class="h6">Склад</h3>
            <p class="small mb-1">
                Занято @Screen.UsedCapacity.ToString("0.##") из @Screen.FreeCapacity.ToString("0.##") бесплатных.
                @if (Screen.ProjectedWarehouseFee > 0)
                {
                    <span class="text-danger">Сверх лимита — при расчёте спишется @DashboardDisplay.FormatMoney(Screen.ProjectedWarehouseFee).</span>
                }
            </p>
            <p class="small text-muted">Склад общий на все фабрики: продукт одного передела ваши фабрики следующего забирают сами. Остатки по ходам — в «Аналитике».</p>
        </section>

        @if (Screen.CanManage && Screen.EmergencyPurchaseEnabled && Screen.EmergencyPurchaseMaterials.Count > 0)
        {
            <details class="mb-3" open="@HasPendingEmergencyPurchase">
                <summary class="h6">Аварийная закупка</summary>
                <div class="pt-2">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <select class="form-select form-select-sm w-auto mw-100" @bind="Screen.EmergencyPurchaseMaterialId">
                            @foreach (var material in Screen.EmergencyPurchaseMaterials)
                            {
                                <option value="@material.Id">@material.Name</option>
                            }
                        </select>
                        <input type="number" min="0" step="0.01" class="form-control form-control-sm" style="width:7em" @bind="Screen.EmergencyPurchaseVolume" />
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="Screen.EmergencyPurchase">В приказ на ход</button>
                        @if (Screen.EmergencyPurchaseMaterialId is not null && Screen.PendingEmergencyPurchaseVolumeByMaterial.GetValueOrDefault(Screen.EmergencyPurchaseMaterialId) > 0)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="Screen.CancelEmergencyPurchase">Отменить</button>
                        }
                    </div>
                    @if (Screen.EmergencyPurchaseMaterialId is not null && Screen.PendingEmergencyPurchaseVolumeByMaterial.GetValueOrDefault(Screen.EmergencyPurchaseMaterialId) is var pendingPurchase && pendingPurchase > 0)
                    {
                        <p class="text-muted small mb-1">В приказе на ход: @pendingPurchase.ToString("0.##") — товар и списание появятся при ближайшем расчёте.</p>
                    }
                    @if (Screen.EmergencyPurchaseCost > 0)
                    {
                        <p class="text-muted small mb-1">
                            Стоимость: @DashboardDisplay.FormatMoney(Screen.EmergencyPurchaseCost)
                            (множитель к рыночной цене: ×@Screen.EmergencyPurchaseEffectiveMultiplier.ToString("0.##") —
                            растёт с недавними экстренными закупками этого материала вашей командой, затухает
                            через несколько ходов без них)
                        </p>
                    }
                    @if (!Screen.CanAffordEmergencyPurchase)
                    {
                        <p class="text-muted small mb-0">
                            Баланс уйдёт в минус на @DashboardDisplay.FormatMoney(Screen.EmergencyPurchaseCost - Screen.Balance) — это не проблема, просто число.
                        </p>
                    }
                </div>
            </details>
        }
    </aside>
</div>

@code {
    /// <summary>Модель экрана команды — общая для всех разделов, её держит оболочка страницы.</summary>
    [Parameter, EditorRequired]
    public TeamScreen Screen { get; set; } = default!;

    /// <summary>Фильтр «Требуют внимания» — оставляет только фабрики с поводами из «Хода».</summary>
    private bool _attentionOnly;

    private ProductionChain.Chain Chain => Screen.Chain;

    private bool HasPendingEmergencyPurchase => Screen.PendingEmergencyPurchaseVolumeByMaterial.Values.Any(volume => volume > 0);

    /// <summary>Что было на экране при прошлой привязке свёрнутых блоков: таймер перерисовывает раздел раз в секунду, а звать браузер стоит, только когда появились новые блоки.</summary>
    private string? _boundGroupsKey;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Блоки появляются и при смене фильтра, и после постройки, и после открытия поколения.
        var groupsKey = $"{_attentionOnly}:{string.Join(",", Chain.Levels.Select(l => $"{l.Number}/{l.FactoryCount}"))}";
        if (groupsKey != _boundGroupsKey)
        {
            _boundGroupsKey = groupsKey;
            await JS.InvokeVoidAsync("teamScreen.rememberCollapsedGroups");
        }
    }

    private void Build(string definitionId)
    {
        Screen.SelectedFactoryDefinitionId = definitionId;
        Screen.BuildFactory();
    }
}
