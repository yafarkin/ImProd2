@inject IJSRuntime JS
<h2 class="h4">Цепочка производства</h2>
<div class="production-layout">
<div>
<div class="btn-group mb-3" role="group" aria-label="Фильтр фабрик">
    <button class="btn @(!_attentionOnly ? "btn-primary" : "btn-outline-primary")" @onclick="() => _attentionOnly = false">Все</button>
    <button class="btn @(_attentionOnly ? "btn-primary" : "btn-outline-primary")" @onclick="() => _attentionOnly = true">Требуют внимания · @ProblemIds.Count</button>
</div>
@if (_attentionOnly && ProblemIds.Count == 0)
{
    <p class="text-muted">Фабрик, требующих внимания, нет.</p>
}
@foreach (var level in Screen.FactoryOverviewRows.GroupBy(n => n.Definition.Recipes[0].Output.Level).OrderBy(g => g.Key))
{
    var instances = level.Where(n => n.Instance is not null).ToList();
    var problems = instances.Count(n => ProblemIds.Contains(n.Instance!.Id));
    if (_attentionOnly && problems == 0) { continue; }
    <details @key="level.Key" class="production-level border rounded mb-3" data-collapse-key="@(Screen.TeamId + ":level:" + level.Key)" open="@(problems > 0 || instances.Count == 0)">
        <summary class="p-3"><strong>Передел @level.Key</strong> · @instances.Count фабрик · выпуск @instances.Sum(n => n.LastTurnOutput ?? 0).ToString("0.##") ед./ход @if (problems > 0) { <span class="text-danger">· требуют внимания: @problems</span> }</summary>
        <div class="px-3 pb-3">
        @if (level.Key > Screen.UnlockedGeneration)
        {
            <p class="text-muted">🔒 Требуется поколение @level.Key · открыто @Screen.UnlockedGeneration</p>
        }
        @foreach (var type in level.GroupBy(n => n.Definition.Id))
        {
            var built = type.Where(n => n.Instance is not null).ToList();
            var visible = built.Where(n => !_attentionOnly || ProblemIds.Contains(n.Instance!.Id)).ToList();
            var definition = type.First().Definition;
            if (_attentionOnly && visible.Count == 0) { continue; }
            <details class="mb-2" data-collapse-key="@(Screen.TeamId + ":type:" + definition.Id)" open="@(visible.Count <= 1 || visible.Any(n => ProblemIds.Contains(n.Instance!.Id)))">
                <summary class="p-2 bg-light rounded">@definition.Name ×@built.Count · @built.Sum(n => n.Instance!.Workers) рабочих · выпуск @built.Sum(n => n.LastTurnOutput ?? 0).ToString("0.##") · худшее состояние @((built.Count == 0 ? 1m : built.Min(n => n.Instance!.Condition)).ToString("P0"))</summary>
                @foreach (var node in visible)
                {
                    var instance = node.Instance!;
                    <a class="factory-link border rounded p-2 my-2 @(ProblemIds.Contains(instance.Id) ? "border-danger" : "")" href="@($"/team/factory/{instance.Id}")" id="@($"factory-link-{instance.Id}")">
                        <strong>@definition.Name №@node.IndexWithinType</strong>
                        <span>@instance.Workers рабочих · состояние @instance.Condition.ToString("P0")</span>
                        <span>Выпуск: @(node.LastTurnOutput?.ToString("0.##") ?? "ещё нет данных") @if (node.TheoreticalMaxOutput is { } max) { <text>из @max.ToString("0.##")</text> }</span>
                        @foreach (var item in Screen.Attention.Where(a => Affects(a, instance.Id)))
                        { <span class="small text-danger">@DashboardDisplay.AttentionText(item, Screen.AttentionNaming).Headline</span> }
                    </a>
                }
                @if (!_attentionOnly && level.Key <= Screen.UnlockedGeneration && Screen.CanManage)
                {
                    <button class="btn btn-outline-secondary btn-sm" style="border-style:dashed" @onclick="() => SelectBuildable(definition.Id)">@(built.Count > 0 ? "построить ещё" : "не построена") · @DashboardDisplay.FormatMoney(Screen.BuildCosts.GetValueOrDefault(definition.Id))</button>
                }
            </details>
        }
        <div class="production-stock border-top mt-3 pt-2"><h3 class="h6">Склад после передела @level.Key</h3><ProductionStock Screen="Screen" Level="level.Key" /></div>
        </div>
    </details>
}
<details class="mb-3"><summary>Прочие материалы на складе</summary><ProductionStock Screen="Screen" Level="-1" /></details>
</div>
<aside>
@if (Screen.Role != ParticipantRole.Manager)
{
    <p><em>Строить фабрики и нанимать рабочих может только управляющий — вы видите то же самое, что и он, в режиме чтения.</em></p>
}
else if (!Screen.IsDecisionPhase)
{
    <p><em>Решения недоступны — сейчас фаза «@Screen.PhaseLabel». Дождитесь фазы «Решения».</em></p>
}
else
{
    <h3 id="decide-now">Построить фабрику</h3>
    @if (Screen.BuildableDefinitions.Count == 0)
    {
        <p><em>Все доступные типы фабрик сектора уже построены.</em></p>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <select class="form-select w-auto" @bind="Screen.SelectedFactoryDefinitionId">
                @foreach (var definition in Screen.BuildableDefinitions)
                {
                    <option value="@definition.Id">@definition.Name (постройка @DashboardDisplay.FormatMoney(definition.BuildCost), обслуживание @DashboardDisplay.FormatMoney(definition.FixedCostPerTurn)/ход)</option>
                }
            </select>
            <button type="button" class="btn btn-primary" @onclick="Screen.BuildFactory">Построить</button>
        </div>
        @if (!Screen.CanAffordSelectedBuild && Screen.SelectedBuildableDefinition is { } selectedForBuild)
        {
            <p class="text-muted mb-3">
                Баланс уйдёт в минус на @DashboardDisplay.FormatMoney(selectedForBuild.BuildCost - Screen.Balance) — это не проблема, просто число.
            </p>
        }
    }
}

<GenerationResearch Screen="Screen" />
<p class="small text-muted">Склад общий: @Screen.UsedCapacity.ToString("0.##") / @Screen.FreeCapacity.ToString("0.##") бесплатно · плата за превышение @DashboardDisplay.FormatMoney(Screen.ProjectedWarehouseFee)/ход</p>
<details><summary>Аварийная закупка</summary>
@if (Screen.CanManage && Screen.EmergencyPurchaseEnabled && Screen.EmergencyPurchaseMaterials.Count > 0)
{
    <h4>Аварийная закупка</h4>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <select class="form-select w-auto" @bind="Screen.EmergencyPurchaseMaterialId">
            @foreach (var material in Screen.EmergencyPurchaseMaterials)
            {
                <option value="@material.Id">@material.Name</option>
            }
        </select>
        <input type="number" min="0" step="0.01" class="form-control d-inline-block" style="width:6em" @bind="Screen.EmergencyPurchaseVolume" />
        <button type="button" class="btn btn-secondary" @onclick="Screen.EmergencyPurchase">Купить</button>
        @if (Screen.EmergencyPurchaseMaterialId is not null && Screen.PendingEmergencyPurchaseVolumeByMaterial.GetValueOrDefault(Screen.EmergencyPurchaseMaterialId) > 0)
        {
            <button type="button" class="btn btn-link p-0" @onclick="Screen.CancelEmergencyPurchase">Отменить</button>
        }
    </div>
    @if (Screen.EmergencyPurchaseMaterialId is not null && Screen.PendingEmergencyPurchaseVolumeByMaterial.GetValueOrDefault(Screen.EmergencyPurchaseMaterialId) is var pendingPurchase && pendingPurchase > 0)
    {
        <p class="text-muted small mb-1">Заявлено на расчёт: @pendingPurchase.ToString("0.##") — товар и списание появятся на следующем расчёте.</p>
    }
    @if (Screen.EmergencyPurchaseCost > 0)
    {
        <p class="text-muted small">
            Стоимость: @DashboardDisplay.FormatMoney(Screen.EmergencyPurchaseCost)
            (множитель к рыночной цене: ×@Screen.EmergencyPurchaseEffectiveMultiplier.ToString("0.##") —
            растёт с недавними экстренными закупками этого материала вашей командой, затухает
            через несколько ходов без них)
        </p>
    }
    @if (!Screen.CanAffordEmergencyPurchase)
    {
        <p class="text-muted small mb-2">
            Баланс уйдёт в минус на @DashboardDisplay.FormatMoney(Screen.EmergencyPurchaseCost - Screen.Balance) — это не проблема, просто число.
        </p>
    }
}

</details>
</aside>
</div>
@code {
    [Parameter, EditorRequired] public TeamScreen Screen { get; set; } = default!;
    private bool _attentionOnly;
    private HashSet<Ulid> ProblemIds => Screen.Factories.Where(f => Screen.Attention.Any(a => Affects(a, f.FactoryId))).Select(f => f.FactoryId).ToHashSet();
    private static bool Affects(TeamAttentionCalculator.AttentionItem item, Ulid id) => item is TeamAttentionCalculator.AttentionItem.MaterialRunningOut shortage
        ? shortage.AffectedFactoryIds.Contains(id)
        : TeamScreen.AttentionTargetFactoryId(item) == id;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("teamScreen.restoreProductionGroups");
        if (Screen.PendingScrollTargetId is { } target)
        {
            Screen.PendingScrollTargetId = null;
            await JS.InvokeVoidAsync("teamScreen.scrollToElement", target);
        }
    }
    private void SelectBuildable(string id) { Screen.SelectedFactoryDefinitionId = id; Screen.PendingScrollTargetId = "decide-now"; }
}
