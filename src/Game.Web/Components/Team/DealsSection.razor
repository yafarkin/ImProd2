@inject IJSRuntime JS

@* Раздел «Сделки» (docs/manager-ui/README.md §4, блок 4, макет mockups/deals.html). Раньше переговоры
   жили в трёх местах — вкладка «Контракты», /team/negotiate и /team/needs (§2 п.9). Теперь здесь:
   слева — что ждёт ответа, действующие контракты и наши заявки; справа — новая заявка и «Для
   переговоров» (бывшая /team/negotiate). Доска потребностей — отдельный экран, вход отсюда. *@

<div class="deals-layout">
    <div class="min-w-0">
        <section class="mb-4">
            <h2 class="h5">
                @(IsManager ? "Ждёт моего ответа" : "Ждёт решения управляющего")
                @if (Screen.Awaiting.Count > 0)
                {
                    <span class="badge rounded-pill bg-danger ms-1">@Screen.Awaiting.Count</span>
                }
            </h2>
            @if (Screen.Awaiting.Count == 0)
            {
                <p class="text-muted small mb-0">Ничего не ждёт: черновиков, подтверждений, пересмотров и входящих заявок нет.</p>
            }
            @foreach (var item in Screen.Awaiting)
            {
                <div class="deal-card border rounded p-2 mb-2 awaiting">
                    <div class="fw-semibold">@item.Title</div>
                    <div class="small text-muted">@item.Detail</div>
                    @if (Screen.CanManage)
                    {
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @switch (item.Kind)
                            {
                                case TeamScreen.AwaitingKind.Draft:
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => Screen.SubmitDraftAsIs(item.Id)">Подать заявку</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => EditDraft(item.Id)">Поправить</button>
                                    <input class="form-control form-control-sm w-auto" placeholder="Причина возврата" aria-label="Причина возврата"
                                           @bind="_returnReasons[item.Id]" />
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ReturnDraft(item.Id)">Вернуть</button>
                                    break;
                                case TeamScreen.AwaitingKind.Confirmation:
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => Screen.ConfirmContract(item.Id)">Подтвердить</button>
                                    break;
                                case TeamScreen.AwaitingKind.Revision:
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => Screen.AcceptRevision(item.Id)">Принять</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Screen.RejectRevision(item.Id)">Отклонить</button>
                                    break;
                                case TeamScreen.AwaitingKind.IncomingProposal:
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="() => Reply(item.Id)">Ответить заявкой</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => Screen.RejectProposal(item.Id)">Отклонить</button>
                                    break;
                            }
                        </div>
                    }
                </div>
            }
        </section>

        @if (!IsManager)
        {
            <section class="mb-4">
                <ContractDraftList TeamId="Screen.TeamId" ParticipantCode="@Screen.ParticipantCode" IsDecisionPhase="Screen.IsDecisionPhase"
                                   OnChanged="Screen.Refresh" />
            </section>
        }

        <section class="mb-4">
            <h2 class="h5">Контракты <span class="text-muted fs-6 fw-normal">@CurrentContracts.Count</span></h2>
            @if (CurrentContracts.Count == 0)
            {
                <p class="text-muted small mb-0">Действующих контрактов нет.</p>
            }
            @foreach (var contract in CurrentContracts)
            {
                <ContractCard @key="contract.ContractId" Screen="Screen" Contract="contract" />
            }
            @if (FinishedContracts.Count > 0)
            {
                <details class="mt-2">
                    <summary class="small">Завершённые и расторгнутые · @FinishedContracts.Count</summary>
                    <div class="mt-2">
                        @foreach (var contract in FinishedContracts)
                        {
                            <ContractCard @key="contract.ContractId" Screen="Screen" Contract="contract" />
                        }
                    </div>
                </details>
            }
        </section>

        <section class="mb-4">
            <h2 class="h5">Мои заявки <span class="text-muted fs-6 fw-normal">@OutgoingProposals.Count</span></h2>
            @if (OutgoingProposals.Count == 0)
            {
                <p class="text-muted small mb-0">Поданных заявок нет. Поданная заявка ждёт встречную от контрагента; совпадут условия — сделка заключится сама.</p>
            }
            @foreach (var proposal in OutgoingProposals)
            {
                <div class="deal-card border rounded p-2 mb-2">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <strong>@(proposal.WeAreBuyer ? $"{proposal.CounterpartyName} → нам" : $"мы → {proposal.CounterpartyName}")</strong>
                        <span class="badge text-bg-light ms-auto">ждёт встречной</span>
                    </div>
                    <div class="small">@ContractDisplay.OutgoingProposalLine(proposal)</div>
                    @if (Screen.CanManage)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => Screen.WithdrawProposal(proposal.ProposalId)">Отозвать</button>
                    }
                </div>
            }
        </section>
    </div>

    <div class="min-w-0">
        <section class="mb-4" id="deal-form">
            @if (Screen.IsDecisionPhase)
            {
                <ContractDraftForm TeamId="Screen.TeamId" Role="Screen.Role" ParticipantCode="@Screen.ParticipantCode"
                                   @bind-EditingDraftId="Screen.EditingDraftId" @bind-ReplyToProposalId="_replyToProposalId" OnChanged="Screen.Refresh" />
            }
            else
            {
                <h3 class="h5">Новая заявка</h3>
                <p class="text-muted small"><em>Заявки подаются в фазе «Решения» — сейчас фаза «@Screen.PhaseLabel».</em></p>
            }
        </section>

        <section class="mb-4">
            <h2 class="h5">Для переговоров</h2>
            <p class="mb-1"><strong>Нужно нам</strong> <span class="small text-muted">— нехватка на ход при полной загрузке фабрик</span></p>
            @if (Screen.Shortfalls.Count == 0)
            {
                <p class="small text-muted">Сырья на ход при полной загрузке хватает.</p>
            }
            else
            {
                <ul class="small ps-3">
                    @foreach (var shortfall in Screen.Shortfalls)
                    {
                        <li>@shortfall.MaterialName: нужно @shortfall.PerTurn.ToString("0.##")/ход, на складе @shortfall.OnStock.ToString("0.##")</li>
                    }
                </ul>
            }
            <p class="mb-1"><strong>Можем предложить</strong> <span class="small text-muted">— что лежит на складе</span></p>
            @if (Screen.Stock.All(row => row.Quantity <= 0))
            {
                <p class="small text-muted">Склад пуст.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var row in Screen.Stock.Where(row => row.Quantity > 0).OrderBy(row => row.MaterialName, StringComparer.Ordinal))
                    {
                        <span class="badge rounded-pill text-bg-light border fw-normal">@row.MaterialName @row.Quantity.ToString("0.##")</span>
                    }
                </div>
            }
            <p class="mb-1"><strong>Репутация</strong> <span class="small text-muted">— доля исполненных поставок</span></p>
            <p class="small">
                @foreach (var (reputation, index) in Screen.Reputations.Select((r, i) => (r, i)))
                {
                    @(index > 0 ? " · " : "")<span class="@(reputation.IsUs ? "fw-semibold" : null)">@(reputation.IsUs ? "мы" : reputation.TeamName) @reputation.Percentage.ToString("F0") % (@reputation.SampleCount)</span>
                }
            </p>
            <p class="mb-0">
                <a href="team/needs">Доска потребностей зала →</a>
                <span class="small text-muted">@BoardSummary</span>
            </p>
        </section>
    </div>
</div>

@code {
    /// <summary>Модель экрана команды — общая для всех разделов, её держит оболочка страницы.</summary>
    [Parameter, EditorRequired]
    public TeamScreen Screen { get; set; } = default!;

    /// <summary>
    /// Входящая заявка из адреса (<c>/team/deals?reply={id}</c>): так «Ответить заявкой» на «Ходе»
    /// приводит сразу к предзаполненной форме — разделы не делят экземпляр страницы.
    /// </summary>
    [Parameter]
    public Ulid? ReplyToProposalId { get; set; }

    private Ulid? _replyToProposalId;
    private readonly Dictionary<Ulid, string?> _returnReasons = new();
    private string? _pendingScrollTarget;

    private bool IsManager => Screen.Role == ParticipantRole.Manager;

    private IReadOnlyList<TeamScreen.ContractRow> CurrentContracts => Screen.Contracts
        .Where(c => c.Status == ContractStatus.Active || (c.Status == ContractStatus.PendingConfirmation && c.WeAreTheProposer))
        .ToList();

    private IReadOnlyList<TeamScreen.ContractRow> FinishedContracts => Screen.Contracts
        .Where(c => c.Status is ContractStatus.Completed or ContractStatus.Terminated or ContractStatus.Rejected)
        .ToList();

    private IReadOnlyList<TeamScreen.ProposalRow> OutgoingProposals => Screen.Proposals.Where(p => !p.Incoming).ToList();

    private string BoardSummary
    {
        get
        {
            var total = Screen.Board.Sum(group => group.Entries.Count);
            var ours = Screen.Board.Where(group => group.ConcernsUs).Sum(group => group.Entries.Count);
            return total == 0 ? "записей пока нет" : $"записей {total}, по нашим материалам {ours}";
        }
    }

    protected override void OnInitialized()
    {
        _replyToProposalId = ReplyToProposalId;
        if (_replyToProposalId is not null)
        {
            _pendingScrollTarget = "deal-form";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingScrollTarget is { } target)
        {
            _pendingScrollTarget = null;
            await JS.InvokeVoidAsync("teamScreen.scrollToElement", target);
        }
    }

    /// <summary>Поле причины возврата должно существовать до отрисовки — его привязывает @bind.</summary>
    protected override void OnParametersSet()
    {
        foreach (var item in Screen.Awaiting.Where(i => i.Kind == TeamScreen.AwaitingKind.Draft))
        {
            _returnReasons.TryAdd(item.Id, null);
        }
    }

    /// <summary>Ответ на входящую заявку — форма справа предзаполняется контрагентом, стороной и материалом.</summary>
    private void Reply(Ulid proposalId)
    {
        Screen.EditingDraftId = null;
        _replyToProposalId = proposalId;
        _pendingScrollTarget = "deal-form";
    }

    private void EditDraft(Ulid draftId)
    {
        _replyToProposalId = null;
        Screen.EditingDraftId = draftId;
        _pendingScrollTarget = "deal-form";
    }

    private void ReturnDraft(Ulid draftId)
    {
        Screen.ReturnDraft(draftId, _returnReasons.GetValueOrDefault(draftId));
        _returnReasons.Remove(draftId);
    }
}
