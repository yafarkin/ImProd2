@* Раздел «Аналитика» (docs/manager-ui/README.md §4, блок 5, макет mockups/analytics.html) — ответ на
   «почему так вышло», нужен на разборе после игры. Слева: сколько стоит команда, один график с
   переключателем вместо шести подряд, индекс экономики с объяснением, на что он влияет. Справа: история
   операций с фильтром по ходу и фабрике и итогом хода над каждой группой. *@

<div class="analytics-layout">
    <div class="min-w-0">
        <section class="mb-4">
            <h2 class="h5">Сколько стоит команда</h2>
            @* Тот же счёт, по которому в конце партии считаются места (FinalScoreCalculator). Показан по
               ходу игры, а не только на итогах: без него команда, вложившая всё в производство, видит
               падающий баланс и не понимает, что стала богаче (docs/TODO.md №10). Чужие счета до конца
               партии не показываются нигде — публична только сумма на счету (SPEC §7). *@
            @if (Screen.Score is { } score)
            {
                <dl class="kv mb-1">
                    <dt>Деньги</dt>
                    <dd class="@(score.Cash < 0 ? "text-danger" : null)">@DashboardDisplay.FormatMoney(score.Cash)</dd>
                    <dt>Склад</dt>
                    <dd>@DashboardDisplay.FormatMoney(score.WarehouseValue)</dd>
                    <dt>Фабрики</dt>
                    <dd>@DashboardDisplay.FormatMoney(score.FactoriesValue)</dd>
                    <dt class="fw-semibold">Итого</dt>
                    <dd class="fw-semibold @(score.Score < 0 ? "text-danger" : null)">@DashboardDisplay.FormatMoney(score.Score)</dd>
                </dl>
                <p class="small text-muted mb-1">Может расти, когда баланс падает: деньги ушли в фабрики и склад, а не пропали.</p>
            }
            @if (Screen.Balance < 0)
            {
                <p class="small text-muted mb-1">
                    Отрицательный баланс — это просто число: штрафа или займа за ним нет, он выправится сам,
                    как только продажи перекроют расходы.
                </p>
            }
            <p class="small mb-0">
                Репутация: @Screen.ReputationPercentage.ToString("F0") % (@Screen.ReputationSampleCount @(Screen.ReputationSampleCount == 1 ? "факт" : "фактов"))
                @if (Screen.ReputationSampleCount < 3)
                {
                    <span class="text-muted">— пока мало данных для оценки</span>
                }
            </p>
        </section>

        <section class="mb-4">
            <h2 class="h5">По ходам</h2>
            @if (Screen.History is null)
            {
                <p class="text-muted small"><em>Графики появятся после первого хода сессии.</em></p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-1 mb-2" role="group" aria-label="Какой график показать">
                    @foreach (var chart in Charts.Where(c => c.Available))
                    {
                        <button type="button" class="btn btn-sm @(chart.Key == _chart ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => _chart = chart.Key">@chart.Label</button>
                    }
                </div>
                var selected = Charts.FirstOrDefault(c => c.Key == _chart && c.Available) ?? Charts[0];
                <p class="small text-muted mb-1">@selected.Explanation</p>
                @ChartRenderer.Render(selected.Build())
            }
        </section>

        @if (Screen.ShowEconomyIndex && Screen.EconomyIndex.HasData)
        {
            <section class="mb-4">
                <h2 class="h5">Внешняя экономика</h2>
                <p class="mb-1">
                    Индекс деловой активности:
                    <strong class="@Screen.EconomyIndex.CssClass">@Screen.EconomyIndex.ValueText @Screen.EconomyIndex.Arrow</strong>
                    <span class="text-muted small">— @Screen.EconomyIndex.LevelText</span>
                </p>
                @ChartRenderer.Render(Screen.EconomyIndexChart)
                <h3 class="h6 mt-2">На что влияет</h3>
                <dl class="kv small mb-1">
                    @foreach (var effect in EconomyIndexDisplay.Effects(Screen.EconomyIndex.Index))
                    {
                        <dt>@effect.What</dt>
                        <dd class="@effect.CssClass">@effect.Multiplier</dd>
                    }
                </dl>
                <p class="small text-muted mb-0">
                    1.00 — нейтральный уровень. Индекс меняет только сторону спроса: при индексе выше 1 тот же
                    склад продаётся дороже, а расходы остаются прежними. Цены по контрактам между командами
                    индекс не трогает — о них договариваются сами команды. Куда индекс пойдёт дальше, график не
                    показывает: об этом заранее предупреждает лента новостей.
                </p>
            </section>
        }
    </div>

    <div class="min-w-0">
        <section class="mb-4" id="history">
            <h2 class="h5">История операций</h2>
            <p class="text-muted small mb-2">Всё, что двигает баланс: постройка, наём и зарплаты, R&amp;D, продажи и закупки, исполнение контрактов.</p>
            @if (Screen.FinanceHistory.Count == 0)
            {
                <p><em>Операций пока не было.</em></p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mb-2">
                    <select class="form-select form-select-sm w-auto" @bind="TurnFilter" aria-label="Ход">
                        <option value="">все ходы</option>
                        @foreach (var turn in Screen.FinanceHistory.Select(o => o.Turn).Distinct().OrderDescending())
                        {
                            <option value="@turn">ход @turn</option>
                        }
                    </select>
                    <select class="form-select form-select-sm w-auto mw-100" @bind="FactoryFilter" aria-label="Фабрика">
                        <option value="">все фабрики и прочее</option>
                        @foreach (var factoryId in Screen.FinanceHistory.Select(o => o.FactoryId).OfType<Ulid>().Distinct())
                        {
                            <option value="@factoryId">@Screen.FactoryDisplayNamesById.GetValueOrDefault(factoryId, "проданная фабрика")</option>
                        }
                    </select>
                </div>
                @if (Groups.Count == 0)
                {
                    <p class="text-muted small">Под этот фильтр операций нет.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    @* Точное время и ставка на телефоне только выдавливают таблицу за экран:
                                       операция и сумма отвечают на «что и почём», секунды нужны разве что на
                                       разборе после игры — на широком экране они и остаются. *@
                                    <th class="d-none d-md-table-cell">Время</th>
                                    <th>Операция</th>
                                    <th class="text-end">Сумма</th>
                                    <th class="d-none d-md-table-cell">Ставка</th>
                                </tr>
                            </thead>
                            @foreach (var group in Groups)
                            {
                                <tbody>
                                    <tr class="table-light">
                                        <td class="d-none d-md-table-cell"></td>
                                        <td class="fw-semibold">Ход @group.Turn · итог</td>
                                        <td class="text-end fw-semibold @(group.Net < 0 ? "text-danger" : "text-success")">@FinanceHistoryView.FormatSigned(group.Net)</td>
                                        <td class="d-none d-md-table-cell"></td>
                                    </tr>
                                    @foreach (var operation in group.Operations)
                                    {
                                        var amount = FinanceHistoryView.Signed(operation);
                                        <tr>
                                            <td class="d-none d-md-table-cell small text-muted">@operation.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                                            <td>
                                                @DashboardDisplay.FinanceOperationLabel(operation.Type)
                                                @if (operation.FactoryId is { } factoryId)
                                                {
                                                    <span class="text-muted"> · @Screen.FactoryDisplayNamesById.GetValueOrDefault(factoryId, "проданная фабрика")</span>
                                                }
                                                @if (DashboardDisplay.FinanceOperationDetail(operation) is { } detail)
                                                {
                                                    <br /><span class="text-muted small">@detail</span>
                                                }
                                            </td>
                                            <td class="text-end @(amount < 0 ? "text-danger" : "text-success")">@FinanceHistoryView.FormatSigned(amount)</td>
                                            <td class="d-none d-md-table-cell small">@(operation.Rate is { } rate ? DashboardDisplay.FormatRate(rate) : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                }
            }
        </section>
    </div>
</div>

@code {
    /// <summary>Модель экрана команды — общая для всех разделов, её держит оболочка страницы.</summary>
    [Parameter, EditorRequired]
    public TeamScreen Screen { get; set; } = default!;

    /// <summary>Ход из адреса (<c>/team/analytics?turn=N</c>) — так «Все операции» из итогов расчёта открывают историю сразу на нём.</summary>
    [Parameter]
    public int? InitialTurn { get; set; }

    /// <summary>Один график переключателя: ключ, подпись кнопки, пояснение и построение.</summary>
    private sealed record ChartOption(string Key, string Label, string Explanation, bool Available, Func<LineChartDiagram.ChartLayout> Build);

    private string _chart = "score";
    private int? _turnFilter;
    private Ulid? _factoryFilter;

    private string TurnFilter
    {
        get => _turnFilter?.ToString() ?? "";
        set => _turnFilter = int.TryParse(value, out var turn) ? turn : null;
    }

    private string FactoryFilter
    {
        get => _factoryFilter?.ToString() ?? "";
        set => _factoryFilter = Ulid.TryParse(value, out var id) ? id : null;
    }

    private IReadOnlyList<FinanceHistoryView.TurnGroup> Groups => FinanceHistoryView.Build(Screen.FinanceHistory, _turnFilter, _factoryFilter);

    private IReadOnlyList<ChartOption> Charts =>
    [
        new("score", "Стоимость команды", "Деньги + склад + фабрики — тот же счёт, по которому считаются места.", true, Screen.BuildScoreChartLayout),
        new("balance", "Баланс", "Деньги на счету; ниже нуля — не ошибка и не заём.", true, Screen.BuildBalanceChartLayout),
        new("cashflow", "Поток за ход", "Сколько заработали за ход: выше нуля — больше, чем потратили; это не накопленный итог.", true, Screen.BuildCashFlowChartLayout),
        new("reputation", "Репутация", "Доля исполненных поставок по контрактам, с затуханием старых фактов.", true, Screen.BuildReputationChartLayout),
        new("stock", "Склад", "Остатки каждого материала на конец хода; шкала логарифмическая — руды на порядки больше, чем продукта.", true, Screen.BuildWarehouseStockChartLayout),
        new("profit", "Прибыль по переделам", "Оценка прибыли каждого передела по ценам и остаткам на конец хода.", Screen.History?.ProfitByLevel.Count > 0, Screen.BuildProfitByLevelChartLayout),
    ];

    protected override void OnInitialized() => _turnFilter = InitialTurn;
}
