@inject GameSessionHost Host

<h3>Черновик сделки</h3>

@if (_errorMessage is not null)
{
    <div class="alert alert-danger">@_errorMessage</div>
}
@if (_successMessage is not null)
{
    <div class="alert alert-success">@_successMessage</div>
}

@if (_counterparties.Count == 0)
{
    <p><em>Нет других команд для сделки.</em></p>
}
else
{
    <div class="row row-cols-auto g-3 align-items-end mb-2">
        <div>
            <label class="form-label mb-0">Контрагент</label>
            <select class="form-select" @bind="_counterpartyTeamId" @bind:after="Refresh">
                @foreach (var team in _counterparties)
                {
                    <option value="@team.Id">@team.Name</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label mb-0">Наша роль</label>
            <select class="form-select" @bind="_role" @bind:after="RecomputeMaterials">
                <option value="buyer">Покупатель</option>
                <option value="seller">Продавец</option>
            </select>
        </div>
    </div>

    <div class="row row-cols-auto g-3 align-items-end mb-2">
        <div>
            <label class="form-label mb-0">Материал</label>
            @if (_materials.Count == 0)
            {
                <div class="form-text text-danger" style="max-width:16em">
                    @(_role == "seller"
                        ? "Нечего продавать — нет построенной фабрики с таким продуктом."
                        : "Контрагент ничего не производит — нет построенных фабрик, готовых это продать.")
                </div>
            }
            else
            {
                <select class="form-select" @bind="_materialId">
                    @foreach (var material in _materials)
                    {
                        <option value="@material.Id">@material.Name</option>
                    }
                </select>
            }
        </div>

        <div>
            <label class="form-label mb-0">Тип</label>
            <select class="form-select" @bind="_type">
                <option value="@ContractType.Spot">Разовый</option>
                <option value="@ContractType.Recurring">Регулярный</option>
            </select>
        </div>
    </div>

    <div class="row row-cols-auto g-3 align-items-end mb-2">
        <div>
            <label class="form-label mb-0">Объём</label>
            <input type="number" min="0.01" step="0.01" class="form-control" style="width:7em" @bind="_volume" />
        </div>
        <div>
            <label class="form-label mb-0">Цена за единицу</label>
            <input type="number" min="0.01" step="0.01" class="form-control" style="width:7em" @bind="_unitPrice" />
        </div>
        <div>
            <label class="form-label mb-0">Ставка штрафа за срыв</label>
            <input type="number" min="0" max="1" step="0.01" class="form-control" style="width:6em" @bind="_penaltyRate" />
        </div>
    </div>

    <div class="row row-cols-auto g-3 align-items-end mb-3">
        @if (_type == ContractType.Spot)
        {
            <div>
                <label class="form-label mb-0">Ход поставки</label>
                <input type="number" min="1" class="form-control" style="width:6em" @bind="_spotDeliveryTurn" />
            </div>
        }
        else
        {
            <div>
                <label class="form-label mb-0">Длительность, ходов</label>
                <div class="form-check mb-1">
                    <input type="checkbox" class="form-check-input" id="recurringIndefinite" @bind="_recurringIndefinite" />
                    <label class="form-check-label" for="recurringIndefinite">Бессрочно — до расторжения</label>
                </div>
                @if (!_recurringIndefinite)
                {
                    <input type="number" min="1" class="form-control" style="width:6em" @bind="_recurringDurationTurns" />
                }
                <div class="form-text">Начнётся с хода, на котором контрагент подтвердит сделку.</div>
            </div>
        }
    </div>

    <button type="button" class="btn btn-primary" @onclick="SubmitDraft">Отправить</button>
}

@code {
    [Parameter, EditorRequired]
    public Ulid TeamId { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private IReadOnlyList<(Ulid Id, string Name)> _counterparties = Array.Empty<(Ulid, string)>();
    private IReadOnlyList<Factory> _ourFactories = Array.Empty<Factory>();
    private IReadOnlyList<Factory> _counterpartyFactories = Array.Empty<Factory>();
    private IReadOnlyList<(string Id, string Name)> _materials = Array.Empty<(string, string)>();

    private Ulid? _counterpartyTeamId;
    private string _role = "buyer";
    private string? _materialId;
    private ContractType _type = ContractType.Spot;
    private decimal _volume = 10m;
    private decimal _unitPrice = 10m;
    private decimal _penaltyRate = 0.1m;
    private int _spotDeliveryTurn = 1;
    private bool _recurringIndefinite;
    private int _recurringDurationTurns = 10;

    private string? _errorMessage;
    private string? _successMessage;

    protected override void OnParametersSet() => Refresh();

    private void Refresh()
    {
        int currentTurn;
        lock (Host.SyncRoot)
        {
            if (Host.Session is null)
            {
                return;
            }

            var state = Host.Session.State;
            currentTurn = state.CurrentTurn;
            _counterparties = state.Teams.Values
                .Where(t => t.Id != TeamId)
                .Select(t => (t.Id, t.Name))
                .OrderBy(t => t.Name, StringComparer.Ordinal)
                .ToList();
            _ourFactories = state.Teams.TryGetValue(TeamId, out var ourTeam)
                ? ourTeam.Factories
                : Array.Empty<Factory>();

            if (_counterpartyTeamId is null || _counterparties.All(c => c.Id != _counterpartyTeamId))
            {
                _counterpartyTeamId = _counterparties.Count > 0 ? _counterparties[0].Id : null;
            }
            _counterpartyFactories = _counterpartyTeamId is { } counterpartyId && state.Teams.TryGetValue(counterpartyId, out var counterpartyTeam)
                ? counterpartyTeam.Factories
                : Array.Empty<Factory>();
        }

        RecomputeMaterials();

        // Только «Ход поставки» (spot) — реальный, заранее выбираемый ход, и его есть смысл держать
        // не раньше текущего. «Длительность» recurring-контракта от текущего хода не зависит вовсе —
        // сам ход вступления в силу больше не выбирается заранее, см. ResolveTermsForActivation.
        if (_spotDeliveryTurn < currentTurn)
        {
            _spotDeliveryTurn = currentTurn;
        }
    }

    /// <summary>
    /// Список «Материал» определяется тем, кто в сделке продавец (запрос пользователя, уточнение по
    /// живому логу: сектор металлургии предлагал купить нефть только потому, что она нужна его
    /// собственным фабрикам на входе — независимо от того, добывает ли её вообще выбранный
    /// контрагент) — материал обязан быть тем, что продавец реально производит: <see
    /// cref="Recipe.Output"/> выбранного рецепта каждой его фабрики. Продавец — это мы (<see
    /// cref="_ourFactories"/>), если <see cref="_role"/> = seller, иначе выбранный контрагент (<see
    /// cref="_counterpartyFactories"/>) — собственные потребности покупателя тут больше не при чём,
    /// только то, чем реально может торговать другая сторона сделки.
    /// </summary>
    private void RecomputeMaterials()
    {
        var sellerFactories = _role == "seller" ? _ourFactories : _counterpartyFactories;
        _materials = sellerFactories
            .Select(f => f.SelectedRecipe.Output)
            .DistinctBy(m => m.Id)
            .Select(m => (m.Id, m.Name))
            .OrderBy(m => m.Name, StringComparer.Ordinal)
            .ToList();

        if (_materialId is null || _materials.All(m => m.Id != _materialId))
        {
            _materialId = _materials.Count > 0 ? _materials[0].Id : null;
        }
    }

    private async Task SubmitDraft()
    {
        _errorMessage = null;
        _successMessage = null;

        if (_counterpartyTeamId is not { } counterpartyId || _materialId is null)
        {
            return;
        }

        try
        {
            ContractFormationResult? result = null;
            lock (Host.SyncRoot)
            {
                if (Host.Session is null)
                {
                    _errorMessage = "Сессия сейчас не активна.";
                }
                else
                {
                    var state = Host.Session.State;
                    var material = state.Config.Materials[_materialId];
                    var iAmBuyer = _role == "buyer";
                    var buyerId = iAmBuyer ? TeamId : counterpartyId;
                    var sellerId = iAmBuyer ? counterpartyId : TeamId;
                    // effectiveTurn — заглушка (1): «ход вступления в силу» больше не то, что стороны
                    // заявляют заранее и должны совпасть — настоящий подставляется один раз при
                    // подтверждении, см. Contract.ResolveTermsForActivation. Recurring передаёт
                    // длительность через тот же RecurringEndTurn (от заглушки 1 разница как раз и
                    // даёт длительность минус один ход) — так делать можно, потому что при активации
                    // используется только разность двух полей, не их абсолютное значение. Бессрочный
                    // (_recurringIndefinite) — null и остаётся null через всю активацию.
                    const int effectiveTurnPlaceholder = 1;
                    var terms = new ContractTerms(
                        _type, material, _volume, _unitPrice, _penaltyRate, effectiveTurnPlaceholder,
                        _type == ContractType.Spot ? _spotDeliveryTurn : null,
                        _type == ContractType.Recurring && !_recurringIndefinite ? effectiveTurnPlaceholder + _recurringDurationTurns - 1 : null);

                    var ourProposal = new ContractProposal(buyerId, sellerId, TeamId, terms);
                    var theirProposal = new ContractProposal(buyerId, sellerId, counterpartyId, terms);
                    result = Host.Session.SubmitContractProposals(ourProposal, theirProposal, Random.Shared);
                }
            }

            if (result is not null)
            {
                _successMessage = result.IsMatched
                    ? "Заявка отправлена, ждёт подтверждения управляющего контрагента."
                    : null;
                if (!result.IsMatched)
                {
                    _errorMessage = string.Join("; ", result.Mismatches.Select(DashboardDisplay.ContractMismatchLabel));
                }
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }

        Refresh();
        await OnChanged.InvokeAsync();
    }
}
