@inject GameSessionHost Host

@* Форма заявки на сделку (docs/manager-ui/README.md §4, блок 4, макет mockups/deals.html). Поля стоят
   ровной сеткой: подпись сверху в одну строку, подсказка под полем всегда занимает место, даже пустая,
   поэтому соседние поля не прыгают. Объём и цена по умолчанию пустые: раньше форма предлагала
   «10 × 10 ¤» при рыночной цене 0.61 ¤ (живой обход 2026-10-04, §2 п.17). *@

<h3 class="h5">@(CanSubmit ? "Новая заявка" : "Черновик сделки")</h3>

<p class="form-text mt-0 mb-2">
    Условия вводит каждая сторона отдельно, и контрагент ваших цифр не видит — договариваются лично,
    затем обе стороны вводят одно и то же. Совпадут — сделка заключена.
</p>

@if (!CanSubmit)
{
    <div class="alert alert-info py-2">
        Черновик уйдёт вашему управляющему — заявку контрагенту подаёт он, как есть или поправив условия.
    </div>
}
@if (_editingDraftAuthor is not null)
{
    <div class="alert alert-secondary py-2 d-flex flex-wrap align-items-center gap-2">
        <span>Правка черновика от <strong>@_editingDraftAuthor</strong>. Подача закроет черновик.</span>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="CancelDraftEditing">Не править</button>
    </div>
}
@if (_replyingTo is not null)
{
    <div class="alert alert-secondary py-2 d-flex flex-wrap align-items-center gap-2">
        <span>Ответ на заявку команды <strong>«@_replyingTo»</strong>: контрагент, сторона и материал уже выбраны, условия называются лично.</span>
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="CancelReply">Не отвечать</button>
    </div>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger py-2">@_errorMessage</div>
}
@if (_successMessage is not null)
{
    <div class="alert alert-success py-2">@_successMessage</div>
}

@if (_counterparties.Count == 0)
{
    <p><em>Нет других команд для сделки.</em></p>
}
else
{
    <div class="deal-form">
        <label class="fld">
            <span class="lbl">Контрагент</span>
            <select class="form-select form-select-sm" @bind="_counterpartyTeamId" @bind:after="Refresh">
                @foreach (var team in _counterparties)
                {
                    <option value="@team.Id">@team.Name</option>
                }
            </select>
            <span class="hint">@CounterpartyReputationHint</span>
        </label>

        <label class="fld">
            <span class="lbl">Мы</span>
            <select class="form-select form-select-sm" @bind="_role" @bind:after="RecomputeMaterials">
                <option value="buyer">Покупаем</option>
                <option value="seller">Продаём</option>
            </select>
            <span class="hint"></span>
        </label>

        <label class="fld">
            <span class="lbl">Материал</span>
            @if (_materials.Count == 0)
            {
                <span class="form-text text-danger mt-0">
                    @(_role == "seller"
                        ? "Нечего продавать — нет построенной фабрики с таким продуктом."
                        : "Контрагент ничего не производит — нет построенных фабрик, готовых это продать.")
                </span>
            }
            else
            {
                <select class="form-select form-select-sm" @bind="_materialId" @bind:after="RecomputePriceHint">
                    @foreach (var material in _materials)
                    {
                        <option value="@material.Id">@material.Name</option>
                    }
                </select>
            }
            <span class="hint">@(_stockQuantity is { } stock && stock > 0 ? $"на складе у нас {stock:0.##}" : "")</span>
        </label>

        <label class="fld">
            <span class="lbl">Тип</span>
            <select class="form-select form-select-sm" @bind="_type">
                <option value="@ContractType.Spot">Разовый</option>
                <option value="@ContractType.Recurring">Регулярный</option>
            </select>
            <span class="hint">@(_type == ContractType.Spot ? "одна поставка" : "поставка каждый ход")</span>
        </label>

        <label class="fld">
            <span class="lbl">Объём@(_type == ContractType.Recurring ? ", ед./ход" : ", ед.")</span>
            <input type="number" min="0.01" step="0.01" class="form-control form-control-sm" placeholder="ед." @bind="_volume" />
            <span class="hint"></span>
        </label>

        <label class="fld">
            <span class="lbl">Цена за ед., ¤</span>
            <input type="number" min="0.0001" step="0.0001" class="form-control form-control-sm" placeholder="¤" @bind="_unitPrice" />
            <span class="hint">@PriceHint</span>
        </label>

        <label class="fld">
            <span class="lbl">Штраф за срыв, %</span>
            <input type="number" min="0" max="100" step="1" class="form-control form-control-sm" @bind="_penaltyPercent" />
            <span class="hint">от суммы поставки</span>
        </label>

        @if (_type == ContractType.Spot)
        {
            <label class="fld">
                <span class="lbl">Ход поставки</span>
                <input type="number" min="@_currentTurn" class="form-control form-control-sm" @bind="_spotDeliveryTurn" />
                <span class="hint">ближайший — @_currentTurn</span>
            </label>
        }
        else
        {
            <div class="fld">
                <span class="lbl">Длительность, ходов</span>
                @if (_recurringIndefinite)
                {
                    <input type="text" class="form-control form-control-sm" value="бессрочно" disabled />
                }
                else
                {
                    <input type="number" min="1" class="form-control form-control-sm" @bind="_recurringDurationTurns" aria-label="Длительность, ходов" />
                }
                <span class="hint">
                    <label class="form-check-label"><input type="checkbox" class="form-check-input me-1" @bind="_recurringIndefinite" />бессрочно</label>
                </span>
            </div>
        }
    </div>

    <p class="small mb-2">
        @if (_volume is { } volume && _unitPrice is { } price && volume > 0 && price > 0)
        {
            var sum = volume * price;
            <span>Сумма сделки: @volume.ToString("0.##") × @DashboardDisplay.FormatUnitCost(price) = <strong>@DashboardDisplay.FormatUnitCost(sum)</strong> @DeliveryPeriodLabel</span>
            @if (_role == "seller" && _sellerUnitCost is { } unitCost)
            {
                var profit = sum - unitCost * volume;
                <span class="@(profit >= 0 ? "text-success" : "text-danger")"> · прибыль @DashboardDisplay.FormatUnitCost(profit) @DeliveryPeriodLabel</span>
            }
            @if (_type == ContractType.Recurring)
            {
                <span class="text-muted"> · начнётся с хода, на котором контрагент подтвердит сделку</span>
            }
        }
        else
        {
            <span class="text-muted">Сумма сделки появится, когда будут введены объём и цена.</span>
        }
    </p>

    @if (CanSubmit)
    {
        <button type="button" class="btn btn-primary" @onclick="SubmitDraft">Подать заявку</button>
    }
    else
    {
        <button type="button" class="btn btn-primary" @onclick="HandOverDraft" disabled="@(!CanHandOver)">Передать управляющему</button>
    }
}

@code {
    [Parameter, EditorRequired]
    public Ulid TeamId { get; set; }

    /// <summary>Роль вошедшего в команде: переговорщик готовит черновик, отправляет управляющий (SPEC §3).</summary>
    [Parameter, EditorRequired]
    public ParticipantRole Role { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Код входа вошедшего — нужен переговорщику, чтобы черновик был записан на него (SPEC §3).</summary>
    [Parameter]
    public string? ParticipantCode { get; set; }

    /// <summary>
    /// Черновик переговорщика, загруженный управляющим в форму для правки и подачи; null — форма
    /// заполняется с нуля. Двусторонняя привязка: после подачи форма сама сбрасывает его в null.
    /// </summary>
    [Parameter]
    public Ulid? EditingDraftId { get; set; }

    [Parameter]
    public EventCallback<Ulid?> EditingDraftIdChanged { get; set; }

    /// <summary>
    /// Входящая заявка, на которую управляющий отвечает встречной: форма сама выбирает контрагента,
    /// нашу сторону и материал. Условий заявки не берёт — их контрагенту не показывают (№16), они
    /// называются лично. После подачи форма сбрасывает его в null.
    /// </summary>
    [Parameter]
    public Ulid? ReplyToProposalId { get; set; }

    [Parameter]
    public EventCallback<Ulid?> ReplyToProposalIdChanged { get; set; }

    private bool CanSubmit => Role == ParticipantRole.Manager;

    private bool CanHandOver => Role == ParticipantRole.Negotiator && !string.IsNullOrEmpty(ParticipantCode);

    private Ulid? _loadedDraftId;
    private string? _editingDraftAuthor;
    private Ulid? _loadedReplyId;
    private string? _replyingTo;

    /// <summary>Материал, выбранный черновиком или ответом на заявку: держится в списке, даже если сейчас его никто не производит.</summary>
    private string? _pinnedMaterialId;

    private IReadOnlyList<(Ulid Id, string Name)> _counterparties = Array.Empty<(Ulid, string)>();
    private IReadOnlyList<Factory> _ourFactories = Array.Empty<Factory>();
    private IReadOnlyList<Factory> _counterpartyFactories = Array.Empty<Factory>();
    private IReadOnlyList<(string Id, string Name)> _materials = Array.Empty<(string, string)>();

    private Ulid? _counterpartyTeamId;
    private string _role = "buyer";
    private string? _materialId;
    private ContractType _type = ContractType.Spot;
    private decimal? _volume;
    private decimal? _unitPrice;
    private decimal? _sellerUnitCost;
    private bool _sellerUnitCostIsEstimate;
    private decimal? _stockQuantity;
    private decimal? _marketPrice;
    private decimal? _counterpartyReputation;
    private int _counterpartyReputationSamples;

    /// <summary>Штраф в процентах, как его называют вслух; в условия уходит долей (<see cref="ContractTerms.PenaltyRate"/>).</summary>
    private decimal _penaltyPercent = 10m;
    private int _currentTurn = 1;
    private int _spotDeliveryTurn = 1;
    private bool _recurringIndefinite;
    private int _recurringDurationTurns = 10;

    private string? _errorMessage;
    private string? _successMessage;

    /// <summary>Подпись периода для дохода/прибыли (запрос пользователя: «я знаю, сколько буду каждый
    /// ход или разово поставлять») — разовая сделка приносит доход один раз, регулярная — на каждом
    /// ходу действия контракта.</summary>
    private string DeliveryPeriodLabel => _type == ContractType.Spot ? "разово" : "за ход";

    private string CounterpartyReputationHint => _counterpartyReputation is { } percentage
        ? $"репутация {percentage:F0} % ({_counterpartyReputationSamples})"
        : "";

    /// <summary>
    /// Опора для цены: рыночная котировка — обеим сторонам, себестоимость — продавцу. Только факты:
    /// какую цену назвать, решают люди в зале.
    /// </summary>
    private string PriceHint
    {
        get
        {
            var parts = new List<string>();
            if (_marketPrice is { } market)
            {
                parts.Add($"рынок {DashboardDisplay.FormatUnitCost(market)}");
            }
            if (_role == "seller" && _sellerUnitCost is { } cost)
            {
                parts.Add($"себест.{(_sellerUnitCostIsEstimate ? " (оценка)" : "")} {DashboardDisplay.FormatUnitCost(cost)}");
            }
            return string.Join(" · ", parts);
        }
    }

    protected override void OnParametersSet()
    {
        if (EditingDraftId != _loadedDraftId)
        {
            LoadDraft(EditingDraftId);
        }
        if (ReplyToProposalId != _loadedReplyId)
        {
            LoadReply(ReplyToProposalId);
        }

        Refresh();
    }

    /// <summary>
    /// Ответ на входящую заявку: стороны и материал — из неё, один раз при смене
    /// <see cref="ReplyToProposalId"/>, как и черновик. Объём и цену не трогаем.
    /// </summary>
    private void LoadReply(Ulid? proposalId)
    {
        _loadedReplyId = proposalId;
        _replyingTo = null;
        if (proposalId is not { } id)
        {
            return;
        }

        lock (Host.SyncRoot)
        {
            if (Host.Session is null || !Host.Session.State.ContractProposals.TryGetValue(id, out var pending))
            {
                return;
            }

            var proposal = pending.Proposal;
            var weAreBuyer = proposal.BuyerTeamId == TeamId;
            _counterpartyTeamId = proposal.SubmittedByTeamId;
            _role = weAreBuyer ? "buyer" : "seller";
            _materialId = proposal.Terms.Material.Id;
            _pinnedMaterialId = _materialId;
            _replyingTo = Host.Session.State.Teams.TryGetValue(proposal.SubmittedByTeamId, out var team) ? team.Name : "?";
        }
    }

    private async Task CancelReply()
    {
        LoadReply(null);
        _pinnedMaterialId = null;
        await ReplyToProposalIdChanged.InvokeAsync(null);
    }

    /// <summary>
    /// Переносит условия черновика в поля формы — один раз при смене <see cref="EditingDraftId"/>, а не на
    /// каждом ежесекундном обновлении родителя, иначе правки управляющего затирались бы черновиком.
    /// </summary>
    private void LoadDraft(Ulid? draftId)
    {
        _loadedDraftId = draftId;
        _editingDraftAuthor = null;
        if (draftId is not { } id)
        {
            return;
        }

        lock (Host.SyncRoot)
        {
            if (Host.Session is null || !Host.Session.State.ContractDrafts.TryGetValue(id, out var draft))
            {
                return;
            }

            var proposal = draft.Proposal;
            var terms = proposal.Terms;
            var weAreBuyer = proposal.BuyerTeamId == TeamId;
            _counterpartyTeamId = weAreBuyer ? proposal.SellerTeamId : proposal.BuyerTeamId;
            _role = weAreBuyer ? "buyer" : "seller";
            _materialId = terms.Material.Id;
            _pinnedMaterialId = _materialId;
            _type = terms.Type;
            _volume = terms.Volume;
            _unitPrice = terms.UnitPrice;
            _penaltyPercent = terms.PenaltyRate * 100m;
            if (terms.SpotDeliveryTurn is { } deliveryTurn)
            {
                _spotDeliveryTurn = deliveryTurn;
            }
            _recurringIndefinite = terms.Type == ContractType.Recurring && terms.RecurringEndTurn is null;
            if (terms.RecurringEndTurn is { } endTurn)
            {
                _recurringDurationTurns = endTurn - terms.EffectiveTurn + 1;
            }
            _editingDraftAuthor = Host.Session.State.Participants.TryGetValue(draft.PreparedByParticipantCode, out var author)
                ? author.DisplayName
                : "переговорщика";
        }
    }

    private async Task CancelDraftEditing()
    {
        LoadDraft(null);
        await EditingDraftIdChanged.InvokeAsync(null);
    }

    private void Refresh()
    {
        int currentTurn;
        lock (Host.SyncRoot)
        {
            if (Host.Session is null)
            {
                return;
            }

            var state = Host.Session.State;
            currentTurn = state.CurrentTurn;
            _counterparties = state.Teams.Values
                .Where(t => t.Id != TeamId)
                .Select(t => (t.Id, t.Name))
                .OrderBy(t => t.Name, StringComparer.Ordinal)
                .ToList();
            _ourFactories = state.Teams.TryGetValue(TeamId, out var ourTeam)
                ? ourTeam.Factories
                : Array.Empty<Factory>();

            if (_counterpartyTeamId is null || _counterparties.All(c => c.Id != _counterpartyTeamId))
            {
                _counterpartyTeamId = _counterparties.Count > 0 ? _counterparties[0].Id : null;
            }
            _counterpartyFactories = _counterpartyTeamId is { } counterpartyId && state.Teams.TryGetValue(counterpartyId, out var counterpartyTeam)
                ? counterpartyTeam.Factories
                : Array.Empty<Factory>();
            if (_counterpartyTeamId is { } reputationTeamId)
            {
                var reputation = Host.Session.GetReputation(reputationTeamId);
                _counterpartyReputation = reputation.Percentage;
                _counterpartyReputationSamples = reputation.SampleCount;
            }
            else
            {
                _counterpartyReputation = null;
            }
        }
        _currentTurn = currentTurn;

        RecomputeMaterials();

        // Только «Ход поставки» (spot) — реальный, заранее выбираемый ход, и его есть смысл держать
        // не раньше текущего. «Длительность» recurring-контракта от текущего хода не зависит вовсе —
        // сам ход вступления в силу больше не выбирается заранее, см. ResolveTermsForActivation.
        if (_spotDeliveryTurn < currentTurn)
        {
            _spotDeliveryTurn = currentTurn;
        }
    }

    /// <summary>
    /// Список «Материал» определяется тем, кто в сделке продавец (запрос пользователя, уточнение по
    /// живому логу: сектор металлургии предлагал купить нефть только потому, что она нужна его
    /// собственным фабрикам на входе — независимо от того, добывает ли её вообще выбранный
    /// контрагент) — материал обязан быть тем, что продавец реально производит: <see
    /// cref="Recipe.Output"/> выбранного рецепта каждой его фабрики. Продавец — это мы (<see
    /// cref="_ourFactories"/>), если <see cref="_role"/> = seller, иначе выбранный контрагент (<see
    /// cref="_counterpartyFactories"/>) — собственные потребности покупателя тут больше не при чём,
    /// только то, чем реально может торговать другая сторона сделки.
    /// </summary>
    private void RecomputeMaterials()
    {
        var sellerFactories = _role == "seller" ? _ourFactories : _counterpartyFactories;
        var materials = sellerFactories
            .Select(f => f.SelectedRecipe.Output)
            .DistinctBy(m => m.Id)
            .Select(m => (m.Id, m.Name))
            .ToList();
        if (_pinnedMaterialId is { } pinnedId && materials.All(m => m.Id != pinnedId))
        {
            lock (Host.SyncRoot)
            {
                if (Host.Session?.State.Config.Materials.TryGetValue(pinnedId, out var pinned) == true)
                {
                    materials.Add((pinned.Id, pinned.Name));
                }
            }
        }
        _materials = materials.OrderBy(m => m.Name, StringComparer.Ordinal).ToList();

        if (_materialId is null || _materials.All(m => m.Id != _materialId))
        {
            _materialId = _materials.Count > 0 ? _materials[0].Id : null;
        }

        RecomputePriceHint();
    }

    /// <summary>
    /// Подсказки рядом с «Материал»/«Цена за единицу» (запрос пользователя: при заключении сделки
    /// сразу видеть, не продаём/не покупаем ли мы себе в убыток, и сколько товара вообще есть в
    /// наличии для продажи) — для продавца это остаток на складе (<see
    /// cref="Warehouse.QuantityOf"/>) и реальная себестоимость товара (<see
    /// cref="Warehouse.AverageCostOf"/>, тот же приём, что и в <see
    /// cref="FactoryProfitabilityCalculator"/>), с запасным вариантом для себестоимости —
    /// теоретическая оценка по рецепту «с нуля» (<see cref="DashboardDisplay.TryCalculateUnitCost"/>),
    /// если этот материал ещё ни разу не производился и на складе взять нечего; для покупателя —
    /// просто текущая рыночная котировка. Пересчитывается при смене роли и материала (см. вызовы у
    /// соответствующих select).
    /// </summary>
    private void RecomputePriceHint()
    {
        _sellerUnitCost = null;
        _sellerUnitCostIsEstimate = false;
        _stockQuantity = null;
        _marketPrice = null;

        if (_materialId is null)
        {
            return;
        }

        lock (Host.SyncRoot)
        {
            if (Host.Session is null)
            {
                return;
            }

            var state = Host.Session.State;
            if (!state.Config.Materials.TryGetValue(_materialId, out var material))
            {
                return;
            }

            if (state.Market.HasQuote(_materialId))
            {
                _marketPrice = state.Market.QuoteOf(_materialId).Price;
            }

            if (!state.Teams.TryGetValue(TeamId, out var ourTeam))
            {
                return;
            }

            _stockQuantity = ourTeam.Warehouse.QuantityOf(material);
            if (_role == "seller")
            {
                var realCost = ourTeam.Warehouse.AverageCostOf(material);
                if (realCost > 0m)
                {
                    _sellerUnitCost = realCost;
                }
                else if (DashboardDisplay.TryCalculateUnitCost(material, state, out var estimatedCost))
                {
                    _sellerUnitCost = estimatedCost;
                    _sellerUnitCostIsEstimate = true;
                }
            }
        }
    }

    private async Task SubmitDraft()
    {
        _errorMessage = null;
        _successMessage = null;

        if (_counterpartyTeamId is not { } counterpartyId || _materialId is null)
        {
            return;
        }
        if (!HasTerms())
        {
            return;
        }

        try
        {
            ContractProposalSubmissionResult? result = null;
            lock (Host.SyncRoot)
            {
                if (Host.Session is null)
                {
                    _errorMessage = "Сессия сейчас не активна.";
                }
                else
                {
                    result = Host.Session.SubmitContractProposal(
                        BuildProposal(Host.Session.State, counterpartyId), TeamRole.Manager, Random.Shared, _loadedDraftId);
                }
            }

            if (result is not null)
            {
                LoadDraft(null);
                LoadReply(null);
                _pinnedMaterialId = null;
                await EditingDraftIdChanged.InvokeAsync(null);
                await ReplyToProposalIdChanged.InvokeAsync(null);

                var message = TeamScreen.DescribeSubmission(result, out var mismatch);
                if (mismatch)
                {
                    _errorMessage = message;
                }
                else
                {
                    _successMessage = message;
                }
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }

        Refresh();
        await OnChanged.InvokeAsync();
    }

    /// <summary>Объём и цена введены — без них заявку не собрать; иначе показывает, чего не хватает.</summary>
    private bool HasTerms()
    {
        if (_volume is > 0 && _unitPrice is > 0)
        {
            return true;
        }

        _errorMessage = "Заявке нужны объём и цена за единицу больше нуля.";
        return false;
    }

    /// <summary>Собирает заявку нашей команды из полей формы — общая для подачи управляющим и для черновика переговорщика.</summary>
    private ContractProposal BuildProposal(GameSessionState state, Ulid counterpartyId)
    {
        var material = state.Config.Materials[_materialId!];
        var iAmBuyer = _role == "buyer";
        var buyerId = iAmBuyer ? TeamId : counterpartyId;
        var sellerId = iAmBuyer ? counterpartyId : TeamId;
        // effectiveTurn — заглушка (1): «ход вступления в силу» больше не то, что стороны
        // заявляют заранее и должны совпасть — настоящий подставляется один раз при
        // подтверждении, см. Contract.ResolveTermsForActivation. Recurring передаёт
        // длительность через тот же RecurringEndTurn (от заглушки 1 разница как раз и
        // даёт длительность минус один ход) — так делать можно, потому что при активации
        // используется только разность двух полей, не их абсолютное значение. Бессрочный
        // (_recurringIndefinite) — null и остаётся null через всю активацию.
        const int effectiveTurnPlaceholder = 1;
        var terms = new ContractTerms(
            _type, material, _volume!.Value, _unitPrice!.Value, _penaltyPercent / 100m, effectiveTurnPlaceholder,
            _type == ContractType.Spot ? _spotDeliveryTurn : null,
            _type == ContractType.Recurring && !_recurringIndefinite ? effectiveTurnPlaceholder + _recurringDurationTurns - 1 : null);

        return new ContractProposal(buyerId, sellerId, TeamId, terms);
    }

    private async Task HandOverDraft()
    {
        _errorMessage = null;
        _successMessage = null;

        if (_counterpartyTeamId is not { } counterpartyId || _materialId is null || ParticipantCode is null)
        {
            return;
        }
        if (!HasTerms())
        {
            return;
        }

        try
        {
            lock (Host.SyncRoot)
            {
                if (Host.Session is null)
                {
                    _errorMessage = "Сессия сейчас не активна.";
                }
                else
                {
                    Host.Session.PrepareContractDraft(BuildProposal(Host.Session.State, counterpartyId), ParticipantCode);
                    _successMessage = "Черновик передан управляющему.";
                }
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _errorMessage = ex.Message;
        }

        Refresh();
        await OnChanged.InvokeAsync();
    }
}
