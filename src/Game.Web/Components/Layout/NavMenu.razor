@inject GameSessionHost Host

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Производственные цепочки</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Главная
            </NavLink>
        </div>

        <AuthorizeView Roles="Manager,Negotiator">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="team">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Команда
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Operator">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="operator">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Оператор
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Facilitator">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="facilitator">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Ведущий
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="Administrator">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Администратор
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@TeamsLinkHref">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Команды
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/participants">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Участники
                </NavLink>
            </div>
        </AuthorizeView>

        <div class="nav-item px-3">
            <a class="nav-link" href="screen" target="_blank">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Большой экран
            </a>
        </div>

        <AuthorizeView>
            <div class="nav-item px-3 mt-3">
                <form method="post" action="/auth/logout">
                    <button type="submit" class="btn btn-secondary btn-sm w-100">Выйти</button>
                </form>
            </div>
        </AuthorizeView>
    </nav>
</div>

@code {
    // До старта сессии черновик команд заводится прямо на /admin (Блок 9.8) — своей страницы
    // управления составом у него нет, поэтому пункт меню «Команды» ведёт туда же, а не в
    // /admin/teams (тот — только про уже идущую сессию, до старта там нечего показывать).
    private string TeamsLinkHref
    {
        get
        {
            lock (Host.SyncRoot)
            {
                return Host.Session is null ? "admin" : "admin/teams";
            }
        }
    }
}
